---
/**
 * /songs/index.astro
 *
 * Index page for all songs. Standalone songs and album tracks shown together.
 * Uses SongCard components for consistent styling with other collection pages.
 */

import { getCollection, type CollectionEntry } from "astro:content";
import IndexLayout from "../../layouts/IndexLayout.astro";
import SongCard from "../../components/collection-cards/SongCard.astro";
import SongCreateForm from "../../components/songs/SongCreateForm.astro";

const songs = await getCollection("songs");

// Sort alphabetically by title
const sorted = songs.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<IndexLayout
  title="Songs"
  count={sorted.length}
  description="All songs — standalone and album tracks."
>
  <SongCreateForm />
  
  {sorted.length === 0 ? (
    <p class="empty">No songs yet.</p>
  ) : (
    <ul class="grid grid--cols-3">
      {sorted.map((entry) => (
        <li>
          <SongCard entry={entry} />
        </li>
      ))}
    </ul>
  )}
</IndexLayout>

<style>
  .grid {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
    margin: 0;
  }

  .grid--cols-3 { grid-template-columns: repeat(3, 1fr); }

  /* Responsive: collapse to fewer columns on smaller screens */
  @media (max-width: 900px) {
    .grid--cols-3 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .grid--cols-3 { grid-template-columns: 1fr; }
  }

  .empty {
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-style: italic;
    padding: var(--space-8) 0;
    text-align: center;
  }

  /* Song-specific CSS variables */
  :root {
    --key-major: #3b82f6;
    --key-minor: #ef4444;
  }
</style>