---
/**
 * src/pages/blog/index.astro
 * List all creative and technical blog posts.
 * - Displays a list of sorted blog posts with elegant tags
 * - Integrates with our custom responsive Card design components
 * @props (local): none
 * @props (global): class, class:list
 */
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import NavBar from '../../components/portfolio/NavBar.astro';
import Box from '../../components/ui/layout/Box.astro';
import Stack from '../../components/ui/layout/Stack.astro';
import Text from '../../components/ui/typography/Text.astro';

import Card from '../../components/ui/card/Card.astro';
import CardHeader from '../../components/ui/card/CardHeader.astro';
import CardContent from '../../components/ui/card/CardContent.astro';
import CardFooter from '../../components/ui/card/CardFooter.astro';
import Badge from '../../components/ui/feedback/Badge.astro';
import Inline from '../../components/ui/layout/Inline.astro';
import Icon from '../../components/ui/media/Icon.astro';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Blog | Jon Doe" description="Articles about web development, creative writing, and music.">
  <div class="glow glow-1"></div>
  <NavBar />
  
  <main class="blog-main">
    <Box class="container">
      <Stack gap="xl">
        <header class="blog-header">
          <Text as="h1" type="h1">Writings</Text>
          <Text as="p" type="lead" tone="subtle">Thoughts on web development, screenwriting, and the creative process.</Text>
        </header>

        <div class="posts-list">
          {sortedPosts.map((post, i) => (
            <a href={`/blog/${post.id}`} class="post-link" style={`animation-delay: ${i * 0.1}s;`}>
              <Card layer="1" bordered class="post-card">
                <div class="card-accent-bar"></div>
                <CardHeader class="post-header-custom">
                  <Inline justify="between" align="start" class="w-full">
                    <div class="flex-1">
                      <Text as="time" type="label" tone="accent" class="post-date">
                        {post.data.pubDate.toLocaleDateString('en-US', {
                          year: 'numeric',
                          month: 'long',
                          day: 'numeric',
                        })}
                      </Text>
                      <Text as="h2" type="h4" class="post-title">{post.data.title}</Text>
                    </div>
                    <div class="post-arrow">
                      <Icon name="arrow-up-right" size="var(--space-5)" />
                    </div>
                  </Inline>
                </CardHeader>
                <CardContent class="post-content-custom">
                  <Text as="p" type="body" tone="subtle" class="post-desc">{post.data.description}</Text>
                </CardContent>
                {post.data.tags && post.data.tags.length > 0 && (
                  <CardFooter class="post-footer-custom">
                    <Inline gap="xs" wrap>
                      {post.data.tags.map(tag => (
                        <Badge theme="ghost" outlined>{tag}</Badge>
                      ))}
                    </Inline>
                  </CardFooter>
                )}
              </Card>
            </a>
          ))}
        </div>
      </Stack>
    </Box>
  </main>
</Layout>

<style>
  .glow {
    position: fixed;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    filter: blur(120px);
    z-index: 0;
    pointer-events: none;
    opacity: 0.15;
    background: var(--accent);
    top: -200px;
    right: -200px;
  }

  .blog-main {
    position: relative;
    z-index: 10;
    padding-top: var(--space-32);
    padding-bottom: var(--space-32);
  }

  .container {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    padding: 0 var(--space-8);
  }

  .blog-header {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: var(--space-12);
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .post-link {
    text-decoration: none;
    color: inherit;
    display: block;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .post-card {
    position: relative;
    overflow: hidden;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.3s ease;
  }

  .post-link:hover .post-card {
    border-color: var(--accent);
    transform: translateX(8px);
    box-shadow: var(--shadow-lg);
  }

  /* Interactive Accent Bar */
  .card-accent-bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(to bottom, var(--accent) 0%, transparent 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 2;
  }

  .post-link:hover .card-accent-bar {
    opacity: 1;
  }

  .post-arrow {
    color: var(--text-muted);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                color 0.3s ease;
    flex-shrink: 0;
    margin-left: var(--space-4);
    margin-top: var(--space-1);
  }

  .post-link:hover .post-arrow {
    transform: translate(2px, -2px);
    color: var(--accent);
  }

  .w-full {
    width: 100%;
  }

  .flex-1 {
    flex: 1;
  }

  .post-header-custom {
    padding: var(--space-6) var(--space-6) var(--space-2) var(--space-6);
  }

  .post-content-custom {
    padding: 0 var(--space-6) var(--space-4) var(--space-6);
  }

  .post-footer-custom {
    padding: 0 var(--space-6) var(--space-6) var(--space-6);
  }

  .post-date {
    display: block;
    margin-bottom: var(--space-2);
    font-family: var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .post-title {
    margin-bottom: 0;
    transition: color 0.3s ease;
  }

  .post-link:hover .post-title {
    color: var(--accent);
  }
</style>
