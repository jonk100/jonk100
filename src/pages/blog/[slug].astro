const components = {
  // pre: MDXPre,
  // Box: Box,
};

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  // optional: sort by date
  const sorted = posts.sort(
    (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
  );

  return sorted.map((post, index) => {
    const nextPost = sorted[index + 1] ?? null;
    const prevPost = sorted[index - 1] ?? null;

    return {
      params: { slug: post.id },
      props: { post, nextPost, prevPost },
    };
  });
}



const { post, nextPost, prevPost } = Astro.props;

const postImage = post.data.imageSrc;
const postTitle = post.data.title;
const postDescription = post.data.description;
const postDateate = post.data.pubDate;
const postTags = post.data.tags;

const { description, pubDate, tags, imageSrc } = post.data;
const { Content } = await render(post);
