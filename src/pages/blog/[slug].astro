---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import NavBar from '../../components/portfolio/NavBar.astro';
import Box from '../../components/ui/layout/Box.astro';
import Stack from '../../components/ui/layout/Stack.astro';
import Inline from '../../components/ui/layout/Inline.astro';
import Text from '../../components/ui/primitives/Text.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;
const { Content } = await render(post);
---

<Layout title={`${title} | Jon Doe`} description={description}>
  <NavBar />
  
  <article class="blog-post">
    <Box class="container">
      <Stack gap="xl">
        <header class="post-header">
          <a href="/blog" class="back-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            Back to Writings
          </a>
          
          <Text as="time" type="label" tone="subtle" class="post-date">
            {pubDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </Text>
          
          <Text as="h1" type="h1" class="post-title">{title}</Text>
          
          {tags.length > 0 && (
            <Inline gap="sm" class="post-tags">
              {tags.map(tag => (
                <span class="tag">#{tag}</span>
              ))}
            </Inline>
          )}
        </header>

        <div class="markdown-content">
          <Content />
        </div>
      </Stack>
    </Box>
  </article>
</Layout>

<style>
  .blog-post {
    padding-top: var(--space-24);
    padding-bottom: var(--space-32);
  }

  .container {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    padding: 0 var(--space-8);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-subtle);
    font-family: var(--mono);
    text-transform: uppercase;
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-decoration: none;
    margin-bottom: var(--space-12);
    transition: color 0.3s ease;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .post-header {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: var(--space-10);
  }

  .post-date {
    display: block;
    margin-bottom: var(--space-4);
    font-family: var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .post-title {
    margin-bottom: var(--space-6);
    line-height: 1.2;
  }

  .tag {
    font-family: var(--mono);
    color: var(--accent);
    font-size: var(--text-sm);
  }

  .markdown-content :global(h2) {
    font-family: var(--display);
    font-size: var(--text-3xl);
    margin: var(--space-12) 0 var(--space-6);
    font-weight: 400;
  }

  .markdown-content :global(h3) {
    font-family: var(--display);
    font-size: var(--text-2xl);
    margin: var(--space-10) 0 var(--space-4);
    font-weight: 400;
  }

  .markdown-content :global(p) {
    font-size: 1.125rem;
    color: var(--text-subtle);
    margin-bottom: var(--space-6);
    line-height: 1.8;
  }

  .markdown-content :global(ul) {
    list-style-type: disc;
    padding-left: var(--space-6);
    margin-bottom: var(--space-6);
    color: var(--text-subtle);
  }

  .markdown-content :global(li) {
    margin-bottom: var(--space-2);
    font-size: 1.125rem;
    line-height: 1.8;
  }

  .markdown-content :global(strong) {
    color: var(--text);
    font-weight: 500;
  }
</style>
