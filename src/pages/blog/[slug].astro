---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BlogPost.astro';
import { cardConfig } from '../../collections.config';

export async function getStaticPaths() {
  const postSeries = await getCollection('post-series');
  return postSeries.map(series => ({
    params: { slug: series.id },
    props: { series },
  }));
}

const { series } = Astro.props;
const { slug } = Astro.params;

const posts = await getCollection('posts');
const seriesPosts = posts
  .filter(p => p.data.postSeries?.id === slug)
  .sort((a, b) => (a.data.position || 0) - (b.data.position || 0));
---

<BaseLayout title={`${series.data.title} - Blog`} excerpt={series.data.description}>
  <section class="series-detail">
    <div class="container">
      <a href="/blog" class="breadcrumb">← Blog</a>

      <h1>{series.data.title}</h1>
      {series.data.description && <p class="description">{series.data.description}</p>}

      {seriesPosts.length > 0 && (
        <div class="posts-list">
          {seriesPosts.map((post, index) => {
            const card = cardConfig.posts(post);
            return (
              <a href={card.href} class="post-item">
                <span class="post-number">
                  {post.data.position || index + 1}
                </span>
                <div>
                  <h2>{card.title}</h2>
                  {card.subtitle && <p class="excerpt">{card.subtitle}</p>}
                </div>
                {card.meta && <time class="date">{card.meta}</time>}
              </a>
            );
          })}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .breadcrumb {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color var(--transition-fast);
  }

  .breadcrumb:hover {
    color: var(--accent);
  }

  .description {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin-bottom: 3rem;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .post-item {
    display: flex;
    gap: 1.5rem;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-fast);
  }

  .post-item:hover {
    border-color: var(--accent);
    background: var(--bg-secondary);
  }

  .post-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    background: var(--accent);
    color: var(--bg);
    border-radius: 50%;
    flex-shrink: 0;
    font-weight: 700;
    font-size: var(--text-base);
  }

  .post-item h2 {
    margin: 0 0 0.5rem 0;
    font-size: var(--text-lg);
  }

  .post-item .excerpt {
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  .post-item .date {
    flex-shrink: 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
    white-space: nowrap;
  }
</style>
