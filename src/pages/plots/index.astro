---
/**
 * /plots/index.astro
 *
 * Index page for all plots across all projects.
 * Uses PlotCard components for consistent styling with other collection pages.
 */

import { getCollection, type CollectionEntry } from "astro:content";
import IndexLayout from "../../layouts/IndexLayout.astro";
import PlotCard from "../../components/collection-cards/PlotCard.astro";

const plots = await getCollection("plots");

// Sort by project, then by title
const sorted = plots.sort((a, b) => {
  const projectCompare = a.data.project.id.localeCompare(b.data.project.id);
  if (projectCompare !== 0) return projectCompare;
  return a.data.title.localeCompare(b.data.title);
});
---

<IndexLayout
  title="Plots"
  count={sorted.length}
  description="All plots and subplots from all projects."
>
  {sorted.length === 0 ? (
    <p class="empty">No plots yet.</p>
  ) : (
    <ul class="grid grid--cols-3">
      {sorted.map((entry) => (
        <li>
          <PlotCard entry={entry} />
        </li>
      ))}
    </ul>
  )}
</IndexLayout>

<style>
  .grid {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
    margin: 0;
  }

  .grid--cols-3 { grid-template-columns: repeat(3, 1fr); }

  /* Responsive: collapse to fewer columns on smaller screens */
  @media (max-width: 900px) {
    .grid--cols-3 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .grid--cols-3 { grid-template-columns: 1fr; }
  }

  .empty {
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-style: italic;
    padding: var(--space-8) 0;
    text-align: center;
  }
</style>
