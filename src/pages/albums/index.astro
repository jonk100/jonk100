---
/**
 * /albums/index.astro
 *
 * Index page for all albums. Each card links to the album detail page
 * which shows the songs belonging to that album.
 */

import { getCollection } from "astro:content";
import IndexLayout from "../../layouts/IndexLayout.astro";
import CardGrid from "../../components/CardGrid.astro";

const albums = await getCollection("albums");

const sorted = albums.sort((a, b) => {
  // Sort by year descending, then alphabetically
  if (a.data.year && b.data.year) return b.data.year - a.data.year;
  return a.data.title.localeCompare(b.data.title);
});
---

<IndexLayout
  title="Albums"
  count={sorted.length}
  description="Collections of songs."
>
  <CardGrid collectionName="albums" entries={sorted} columns={3} />
</IndexLayout>