---
/**
 * /locations/index.astro
 *
 * Index page for all locations across all projects.
 * Uses LocationCard components for consistent styling with other collection pages.
 */

import { getCollection, type CollectionEntry } from "astro:content";
import IndexLayout from "../../layouts/IndexLayout.astro";
import LocationCard from "../../components/collection-cards/LocationCard.astro";

const locations = await getCollection("locations");

// Sort by project, then by location name
const sorted = locations.sort((a, b) => {
  const projectCompare = a.data.project.id.localeCompare(b.data.project.id);
  if (projectCompare !== 0) return projectCompare;
  return a.data.name.localeCompare(b.data.name);
});
---

<IndexLayout
  title="Locations"
  count={sorted.length}
  description="All locations from all projects."
>
  {sorted.length === 0 ? (
    <p class="empty">No locations yet.</p>
  ) : (
    <ul class="grid grid--cols-3">
      {sorted.map((entry) => (
        <li>
          <LocationCard entry={entry} />
        </li>
      ))}
    </ul>
  )}
</IndexLayout>

<style>
  .grid {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
    margin: 0;
  }

  .grid--cols-3 { grid-template-columns: repeat(3, 1fr); }

  /* Responsive: collapse to fewer columns on smaller screens */
  @media (max-width: 900px) {
    .grid--cols-3 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .grid--cols-3 { grid-template-columns: 1fr; }
  }

  .empty {
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-style: italic;
    padding: var(--space-8) 0;
    text-align: center;
  }
</style>
