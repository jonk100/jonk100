---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Box from '../../components/ui/layout/Box.astro';
import Stack from '../../components/ui/layout/Stack.astro';
import Inline from '../../components/ui/layout/Inline.astro';
import Text from '../../components/ui/primitives/Text.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, category, description, imageSrc, githubUrl, liveUrl } = project.data;
const { Content } = await render(project);
---

<Layout title={`${title} | Jon Doe`}>
  <div class="project-page">
    <nav class="project-nav">
      <a href="/" class="back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Back to Home
      </a>
    </nav>

    <div class="hero-section">
      {imageSrc && (
        <img 
          src={imageSrc} 
          alt={title} 
          class="hero-image" 
          style={`view-transition-name: hero-${project.id}`} 
        />
      )}
      <div class="hero-overlay"></div>
    </div>

    <Box class="content-container">
      <Stack gap="lg" class="content">
        <header class="project-header">
          <Text as="span" type="label" tone="accent">{category}</Text>
          <Text as="h1" type="h1" class="project-title">{title}</Text>
          <Text as="p" type="lead" tone="subtle">{description}</Text>
          
          <Inline gap="md" class="project-links">
            {liveUrl && (
              <a href={liveUrl} target="_blank" rel="noopener noreferrer" class="external-link primary-link">Visit Project</a>
            )}
            {githubUrl && (
              <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="external-link secondary-link">View Source</a>
            )}
          </Inline>
        </header>

        <div class="markdown-content">
          <Content />
        </div>
      </Stack>
    </Box>
  </div>
</Layout>

<style>
  .project-page {
    min-height: 100vh;
  }

  .project-nav {
    position: absolute;
    top: var(--space-8);
    left: var(--space-8);
    z-index: 100;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text);
    background: rgba(20, 20, 20, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    font-family: var(--mono);
    text-transform: uppercase;
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .back-link:hover {
    background: var(--bg-surface);
    border-color: var(--border);
    transform: translateX(-4px);
  }

  .hero-section {
    position: relative;
    width: 100%;
    height: 60vh;
    min-height: 400px;
    background: var(--bg-surface);
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 0%, var(--bg) 100%);
    pointer-events: none;
  }

  .content-container {
    max-width: var(--max-width, 1280px);
    margin: 0 auto;
    padding: 0 var(--space-8);
    position: relative;
    top: -100px; /* Pull content up over the gradient */
    z-index: 10;
  }

  .content {
    max-width: 800px;
  }

  .project-header {
    margin-bottom: var(--space-8);
  }

  .project-title {
    font-size: clamp(3rem, 5vw, 5rem);
    margin: var(--space-4) 0;
    line-height: 1.1;
  }

  .project-links {
    margin-top: var(--space-6);
  }

  .external-link {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    font-family: var(--mono);
    text-transform: uppercase;
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .primary-link {
    background: var(--accent);
    color: var(--bg);
    font-weight: 600;
  }

  .primary-link:hover {
    background: var(--text);
    transform: translateY(-2px);
  }

  .secondary-link {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--border);
  }

  .secondary-link:hover {
    border-color: var(--text);
    transform: translateY(-2px);
  }

  .markdown-content :global(h2) {
    font-family: var(--display);
    font-size: var(--text-3xl);
    margin: var(--space-10) 0 var(--space-4);
    font-weight: 400;
  }

  .markdown-content :global(h3) {
    font-family: var(--display);
    font-size: var(--text-xl);
    margin: var(--space-8) 0 var(--space-3);
    font-weight: 400;
  }

  .markdown-content :global(p) {
    font-size: var(--text-lg);
    color: var(--text-subtle);
    margin-bottom: var(--space-6);
    line-height: 1.7;
  }

  .markdown-content :global(ul) {
    list-style-type: disc;
    padding-left: var(--space-6);
    margin-bottom: var(--space-6);
    color: var(--text-subtle);
  }

  .markdown-content :global(li) {
    margin-bottom: var(--space-2);
    font-size: var(--text-lg);
  }

  .markdown-content :global(strong) {
    color: var(--text);
    font-weight: 500;
  }
</style>
