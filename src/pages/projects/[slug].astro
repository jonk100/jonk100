---
/**
 * src/pages/projects/[slug].astro
 * Dynamic routing component for individual project detail pages.
 * - Resolves project slugs using getStaticPaths and retrieves matching collection entries.
 * - Passes project and pagination metadata to the specialized ProjectLayout component.
 * - Renders project-specific markdown/MDX content using customized code block presentation components.
 * @props (local): project, nextProject
 */

import { getCollection, render } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import '../../styles/markdown.css';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const sortedProjects = projects.sort((a, b) => 
    a.data.index.localeCompare(b.data.index)
  );
  
  return sortedProjects.map((project, index) => {
    const nextProject = sortedProjects[(index + 1) % sortedProjects.length];
    return {
      params: { slug: project.id },
      props: { project, nextProject },
    };
  });
}

const { project, nextProject } = Astro.props;
const { Content } = await render(project);

const components = {
  // pre: MDXPre,
  // code: Code,
  // Box: Box,
};
---

<ProjectLayout project={project} nextProject={nextProject}>
  <Content components={components} />
</ProjectLayout>
