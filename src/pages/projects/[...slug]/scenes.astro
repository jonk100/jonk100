---
/**
 * /projects/[...slug]/scenes.astro
 *
 * Project-specific scenes index page.
 * Shows only scenes belonging to the current project.
 */

import { getCollection, getEntry } from "astro:content";
import { type CollectionEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SceneCard from "../../../components/collection-cards/SceneCard.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import SceneFilter from "../../../components/filters/SceneFilter.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;

// Get scenes for this project only
const scenes = await getCollection("scenes", (scene) => scene.data.project.id === project.id);

// Sort by scene number
const sorted = scenes.sort((a, b) => (a.data.sceneNumber || 0) - (b.data.sceneNumber || 0));
---

<BaseLayout title={`${project.data.title} - Scenes`}>
  <div class="project-collection">
    <header class="collection-header">
      <Breadcrumb 
        items={[
          { label: "Projects", href: "/projects" },
          { label: project.data.title, href: `/projects/${project.id}` },
          { label: "Scenes" }
        ]} 
      />
      
      <h1>Scenes</h1>
      <p class="collection-description">
        {sorted.length} scene{sorted.length !== 1 ? 's' : ''} from <em>{project.data.title}</em>
      </p>
    </header>

    <SceneFilter scenes={sorted} />

    {sorted.length === 0 ? (
      <p class="empty">No scenes yet for this project.</p>
    ) : (
      <ul class="grid grid--cols-3">
        {sorted.map((entry) => (
          <li>
            <SceneCard entry={entry} />
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>

<style>
  .project-collection {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-8);
  }

  .collection-header {
    margin-bottom: var(--space-8);
  }

  .collection-header h1 {
    font-size: var(--text-3xl);
    font-weight: 800;
    margin-bottom: var(--space-3);
    color: var(--text-primary);
  }

  .collection-description {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin: 0;
  }

  .grid {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
    margin: 0;
  }

  .grid--cols-3 { grid-template-columns: repeat(3, 1fr); }

  /* Responsive: collapse to fewer columns on smaller screens */
  @media (max-width: 900px) {
    .grid--cols-3 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .project-collection {
      padding: var(--space-6);
    }
    
    .grid--cols-3 { grid-template-columns: 1fr; }
    
    .collection-header h1 {
      font-size: var(--text-2xl);
    }
  }

  .empty {
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-style: italic;
    padding: var(--space-8) 0;
    text-align: center;
  }
</style>
