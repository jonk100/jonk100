---
/**
 * /projects/[...slug]/plots.astro
 *
 * Project-specific plots index page.
 * Shows only plots belonging to the current project.
 */

import { getCollection, getEntry } from "astro:content";
import { type CollectionEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import PlotCard from "../../../components/collection-cards/PlotCard.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;

// Get plots for this project only
const plots = await getCollection("plots", (plot) => plot.data.project.id === project.id);

// Sort by plot type (main first), then by title
const sorted = plots.sort((a, b) => {
  const typeCompare = a.data.plotType.localeCompare(b.data.plotType);
  if (typeCompare !== 0) return typeCompare;
  return a.data.title.localeCompare(b.data.title);
});
---

<BaseLayout title={`${project.data.title} - Plots`}>
  <div class="project-collection">
    <header class="collection-header">
      <Breadcrumb 
        items={[
          { label: "Projects", href: "/projects" },
          { label: project.data.title, href: `/projects/${project.id}` },
          { label: "Plots" }
        ]} 
      />
      
      <h1>Plots</h1>
      <p class="collection-description">
        {sorted.length} plot{sorted.length !== 1 ? 's' : ''} from <em>{project.data.title}</em>
      </p>
    </header>

    {sorted.length === 0 ? (
      <p class="empty">No plots yet for this project.</p>
    ) : (
      <ul class="grid grid--cols-3">
        {sorted.map((entry) => (
          <li>
            <PlotCard entry={entry} />
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>

<style>
  .project-collection {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-8);
  }

  .collection-header {
    margin-bottom: var(--space-8);
  }

  .collection-header h1 {
    font-size: var(--text-3xl);
    font-weight: 800;
    margin-bottom: var(--space-3);
    color: var(--text-primary);
  }

  .collection-description {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin: 0;
  }

  .grid {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
    margin: 0;
  }

  .grid--cols-3 { grid-template-columns: repeat(3, 1fr); }

  /* Responsive: collapse to fewer columns on smaller screens */
  @media (max-width: 900px) {
    .grid--cols-3 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .project-collection {
      padding: var(--space-6);
    }
    
    .grid--cols-3 { grid-template-columns: 1fr; }
    
    .collection-header h1 {
      font-size: var(--text-2xl);
    }
  }

  .empty {
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-style: italic;
    padding: var(--space-8) 0;
    text-align: center;
  }
</style>
