---
/**
 * /reviews/index.astro
 *
 * Index page for all reviews. Uses the image card variant when a
 * poster is available (which it will be after enrich-tmdb.ts runs).
 */

import { getCollection } from "astro:content";
import IndexLayout from "../../layouts/IndexLayout.astro";
import ReviewCard from "../../components/collection-cards/ReviewCard.astro";

const reviews = await getCollection("reviews");

// Sort by pubDate descending (most recent first)
const sorted = reviews.sort((a, b) =>
  b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<IndexLayout
  title="Reviews"
  count={sorted.length}
  description="Film, TV, and other media."
>
  {sorted.length === 0 ? (
    <p class="empty">No reviews yet.</p>
  ) : (
    <ul class="grid grid--cols-2">
      {sorted.map((entry) => (
        <li>
          <ReviewCard entry={entry} />
        </li>
      ))}
    </ul>
  )}
</IndexLayout>

<style>
  .grid {
    display: grid;
    gap: var(--space-5);
    padding: 0;
    list-style: none;
    margin: 0;
  }

  .grid--cols-2 { grid-template-columns: repeat(2, 1fr); }

  /* Responsive: collapse to fewer columns on smaller screens */
  @media (max-width: 900px) {
    .grid--cols-2 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .grid--cols-2 { grid-template-columns: 1fr; }
  }

  .empty {
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-style: italic;
    padding: var(--space-8) 0;
    text-align: center;
  }
</style>