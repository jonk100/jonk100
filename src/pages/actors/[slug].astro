---
import { getCollection, render, type CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths: GetStaticPaths = async () => {
  const actors = await getCollection("actors");
  return actors.map((entry) => ({
    params: { slug: entry.id },
    props: { entry }, // Wrapped in object so destructuring works below
  }));
};

interface Props {
  entry: CollectionEntry<"actors">;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

/**
 * Formats date string from schema (e.g., "1974-04-28")
 */
function formatDate(dateString: string | undefined) {
  if (!dateString) return null;
  return new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(new Date(dateString));
}

/**
 * Calculates age based on birthDate string
 */
function getAge(dateString: string | undefined) {
  if (!dateString) return null;
  const birth = new Date(dateString);
  const today = new Date();
  let age = today.getFullYear() - birth.getFullYear();
  const m = today.getMonth() - birth.getMonth();
  if (m < 0 || (m === 0 && today.getDate() < birth.getDate())) {
    age--;
  }
  return age;
}
---

<BaseLayout
  title={data.name}
  description={`Actor profile for ${data.name}`}
>
  <article class="actor-detail">
    <header class="actor-header">
      {data.heroImage && (
        <div class="actor-image">
          <img 
            src={data.heroImage} 
            alt={`${data.name} headshot`}
            loading="lazy"
          />
        </div>
      )}
      
      <div class="actor-info">
        <h1 class="actor-name">{data.name}</h1>
        
        <div class="actor-meta">
          {data.born && (
            <div class="meta-item">
              <span class="meta-label">Born</span>
              <span class="meta-value">
                {formatDate(data.born)}
                {getAge(data.born) && ` (age ${getAge(data.born)})`}
              </span>
            </div>
          )}
          
          {data.from && (
            <div class="meta-item">
              <span class="meta-label">From</span>
              <span class="meta-value">{data.from}</span>
            </div>
          )}
          
          {data.tmdbId && (
            <div class="meta-item">
              <span class="meta-label">TMDB ID</span>
              <span class="meta-value">{data.tmdbId}</span>
            </div>
          )}
        </div>
      </div>
    </header>

    <section class="actor-content">
      <div class="content-body">
        <Content />
      </div>
    </section>

    <footer class="actor-footer">
      <a 
        href={`https://www.themoviedb.org/person/${data.tmdbId}`}
        class="tmdb-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        View on TMDB
      </a>
    </footer>
  </article>
</BaseLayout>

<style>
  .actor-detail {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--space-8) 0;
  }

  .actor-header {
    display: flex;
    gap: var(--space-8);
    margin-bottom: var(--space-8);
    align-items: flex-start;
  }

  .actor-image {
    flex-shrink: 0;
    width: 200px;
    height: 200px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 2px solid var(--border);
  }

  .actor-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .actor-info {
    flex: 1;
    min-width: 0;
  }

  .actor-name {
    font-size: var(--text-4xl);
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 var(--space-6) 0;
    color: var(--text-primary);
  }

  .actor-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .meta-label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    font-weight: 600;
  }

  .meta-value {
    font-size: var(--text-base);
    color: var(--text-secondary);
    font-weight: 500;
  }

  .actor-content {
    margin-bottom: var(--space-8);
  }

  .content-body {
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .content-body :is(h1, h2, h3, h4, h5, h6) {
    color: var(--text-primary);
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
  }

  .content-body p {
    margin-bottom: var(--space-4);
  }

  .actor-footer {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .tmdb-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
    font-size: var(--text-base);
  }

  .tmdb-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .actor-detail {
      padding: var(--space-6) 0;
    }

    .actor-header {
      flex-direction: column;
      gap: var(--space-6);
      align-items: center;
      text-align: center;
    }

    .actor-image {
      width: 150px;
      height: 150px;
    }

    .actor-name {
      font-size: var(--text-3xl);
    }

    .actor-meta {
      align-items: center;
    }

    .meta-item {
      align-items: center;
      text-align: center;
    }
  }
</style>