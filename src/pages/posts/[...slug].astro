---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BlogPost.astro';
import Breadcrumbs from '../../components/blog/Breadcrumbs.astro';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const postSeries = await getCollection('post-series');
  
  return posts.map(post => {
    // post.id is like "2026-nfl-draft/top-wr-prospects"
    // Use the full path as slug to maintain directory structure in URL
    const slug = post.id;
    
    // Get the full series data
    const series = postSeries.find(s => s.id === post.data.postSeries.id);
    
    return {
      params: { 
        slug  // This will be "2026-nfl-draft/top-wr-prospects"
      },
      props: { 
        post,
        series
      }
    };
  });
}

interface Props {
  post: import('astro:content').CollectionEntry<'posts'>;
  series: import('astro:content').CollectionEntry<'post-series'>;
}

const { post, series } = Astro.props;
const { Content } = await render(post);

// Format published date
const formattedDate = post.data.publishedAt
  ? new Date(post.data.publishedAt).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    })
  : '';

// Get post series info
const postSeries = series;
---

<BaseLayout 
  title={post.data.title} 
  excerpt={post.data.excerpt} 
  publishedAt={post.data.publishedAt} 
  heroImage={post.data.heroImage} 
  tags={post.data.tags} 
  themes={post.data.themes} 
  status={post.data.status} 
  postSeries={post.data.postSeries} 
  position={post.data.position}
>
  <main class="container">
    <article class="post">
      <header class="post-header">
        <Breadcrumbs series={postSeries} />
        
        <h1 class="post-title">{post.data.title}</h1>
        <div class="hero-image">
					{post.data.heroImage && <Image width={1020} height={510} src={post.data.heroImage} alt="" />}
				</div>
        <div class="post-meta">
          {formattedDate && (
            <time datetime={post.data.publishedAt?.toISOString()}>
              {formattedDate}
            </time>
          )}
          
          {post.data.tags.length > 0 && (
            <div class="tags">
              {post.data.tags.map((tag: string) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )}
        </div>
      </header>

      <div class="post-content prose">
        <Content />
      </div>

      <footer class="post-footer">
        <nav class="post-navigation">
          <a href={`/post-series/${series.id}`} class="back-to-series">
            ← Back to {series.data.title} Series
          </a>
        </nav>
      </footer>
    </article>
  </main>
</BaseLayout>

<style>
  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  .post {
    line-height: 1.6;
  }

  .post-header {
    margin-bottom: var(--space-12);
  }

  .separator {
    margin: 0 var(--space-2);
  }

  .post-title {
    font-size: var(--text-4xl);
    font-weight: 800;
    margin-bottom: var(--space-6);
    color: var(--text-primary);
    line-height: 1.2;
  }

  .post-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border);
  }

  .post-meta time {
    font-size: var(--text-lg);
    color: var(--text-secondary);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag {
    font-size: var(--text-sm);
    padding: var(--space-1) var(--space-3);
    background-color: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    color: var(--text-secondary);
  }

  .post-content {
    margin-bottom: var(--space-12);
  }

  .post-content :global(h1),
  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4),
  .post-content :global(h5),
  .post-content :global(h6) {
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
    color: var(--text-primary);
  }

  .post-content :global(h1) {
    font-size: var(--text-3xl);
  }

  .post-content :global(h2) {
    font-size: var(--text-2xl);
  }

  .post-content :global(h3) {
    font-size: var(--text-xl);
  }

  .post-content :global(p) {
    margin-bottom: var(--space-6);
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: var(--space-6);
    padding-left: var(--space-6);
  }

  .post-content :global(li) {
    margin-bottom: var(--space-2);
  }

  .post-content :global(blockquote) {
    margin: var(--space-8) 0;
    padding: var(--space-4) var(--space-6);
    border-left: 4px solid var(--accent);
    background-color: var(--bg-secondary);
    font-style: italic;
  }

  .post-content :global(code) {
    background-color: var(--bg-secondary);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .post-content :global(pre) {
    background-color: var(--bg-secondary);
    padding: var(--space-4);
    border-radius: var(--radius);
    overflow-x: auto;
    margin: var(--space-6) 0;
  }

  .post-content :global(pre code) {
    background: none;
    padding: 0;
  }

  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-6) 0;
  }

  .post-content :global(th),
  .post-content :global(td) {
    padding: var(--space-2) var(--space-3);
    text-align: left;
    border-bottom: 1px solid var(--border);
  }

  .post-content :global(th) {
    font-weight: 600;
    color: var(--text-primary);
  }

  .post-footer {
    padding-top: var(--space-8);
    border-top: 1px solid var(--border);
  }

  .post-navigation {
    display: flex;
    justify-content: center;
  }

  .back-to-series {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    background-color: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text-primary);
    font-weight: 500;
    transition: all var(--transition-fast);
  }

  .back-to-series:hover {
    background-color: var(--bg-card-hover);
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }

  @media (max-width: 768px) {
    .container {
      padding: var(--space-6) var(--space-4);
    }

    .post-title {
      font-size: var(--text-3xl);
    }

    .post-content :global(h1) {
      font-size: var(--text-2xl);
    }

    .post-content :global(h2) {
      font-size: var(--text-xl);
    }

    .post-content :global(h3) {
      font-size: var(--text-lg);
    }
  }

  .hero-image {
    width: 100%;
  }
  .hero-image img {
    display: block;
    margin: 0 auto;
    border-radius: 12px;
    box-shadow: var(--box-shadow);
    margin-bottom: 1em;
  }

  .date {
    margin-bottom: 0.5em;
    color: var(--text-secondary);
  }
</style>
