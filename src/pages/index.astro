---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/portfolio/NavBar.astro';
import Hero from '../components/portfolio/Hero.astro';
import ProjectBento from '../components/portfolio/ProjectBento.astro';
---

<Layout title="Jon | Writer, Musician, Developer, Teacher" description="Writer, musician, developer and teacher. I build to help me write and teach, usually with Astro and TypeScript.">
	
	<!-- Premium background gradients -->
	<div class="glow glow-1"></div>
	<div class="glow glow-2"></div>

	<NavBar />
	
	<main>
		<Hero />
		<ProjectBento />
	</main>
	
</Layout>

<style>
	main {
		position: relative;
		z-index: 10;
	}

	/* Ambient Background Glows */
	.glow {
		position: fixed;
		width: 600px;
		height: 600px;
		border-radius: 50%;
		filter: blur(120px);
		z-index: 0;
		pointer-events: none;
		opacity: 0.15;
		animation: float 20s ease-in-out infinite alternate;
	}

	.glow-1 {
		top: -100px;
		left: -200px;
		background: var(--accent);
	}

	.glow-2 {
		bottom: -200px;
		right: -100px;
		background: var(--primary);
		animation-delay: -10s;
	}

	@keyframes float {
		0% { transform: translate(0, 0) scale(1); }
		100% { transform: translate(100px, 100px) scale(1.1); }
	}
</style>
