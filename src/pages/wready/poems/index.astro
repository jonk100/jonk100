---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Poems - wReady Showcase" description="Poetry collection with form analysis">
  <section class="poems-hero">
    <div class="container">
      <h1>Poems</h1>
      <p class="intro">
        A curated collection of original poetry with form analysis, thematic connections, 
        and cross-references to other creative work.
      </p>
    </div>
  </section>

  <section class="poems-list">
    <div class="container">
      <h2>Sample Poem</h2>
      
      <article class="poem-card featured">
        <div class="poem-header">
          <h3>Voice</h3>
          <span class="poem-meta">Free Verse</span>
        </div>
        
        <div class="poem-excerpt">
          <p class="stanza">
            The voice that speaks through silence<br>
            carries weight the shouting never could—<br>
            a whisper in the margins,<br>
            ink bleeding through the page.
          </p>
          <p class="stanza">
            We mistake volume for truth,<br>
            confuse the echo with the source,<br>
            but the real work happens<br>
            in the quiet spaces between words.
          </p>
          <p class="read-more">[Read full poem →]</p>
        </div>

        <div class="poem-details">
          <h4>About This Poem</h4>
          <p>
            An exploration of authenticity and the power of restraint in creative expression. 
            The poem examines how genuine voice emerges not from volume or performance, 
            but from careful attention to the spaces between words.
          </p>
        </div>

        <div class="poem-features">
          <div class="feature-item">
            <strong>Form:</strong> Free verse with irregular stanza structure
          </div>
          <div class="feature-item">
            <strong>Themes:</strong> Authenticity, Creative voice, Restraint
          </div>
          <div class="feature-item">
            <strong>Status:</strong> <span class="status-badge">Published</span>
          </div>
        </div>

        <a href="/wready/poems/voice" class="view-poem-btn">View Full Poem →</a>
      </article>

      <div class="more-poems">
        <p>Additional poems available in various forms: sonnets, haiku, free verse, and experimental forms</p>
      </div>
    </div>
  </section>

  <section class="features-section">
    <div class="container">
      <h2>Poetry Management Features</h2>
      <div class="features-grid">
        <div class="feature-card">
          <h3>📝 Form Analysis</h3>
          <p>Track poetic forms, meter, rhyme schemes, and structural elements for each piece.</p>
        </div>
        <div class="feature-card">
          <h3>🎨 Thematic Connections</h3>
          <p>Link poems to themes and cross-reference with other creative work like songs and screenplays.</p>
        </div>
        <div class="feature-card">
          <h3>📊 Collection Organization</h3>
          <p>Group poems into collections with ordering, publication status, and metadata.</p>
        </div>
        <div class="feature-card">
          <h3>✍️ Revision Tracking</h3>
          <p>Maintain version history and track the evolution of each poem through drafts.</p>
        </div>
        <div class="feature-card">
          <h3>🔗 Cross-References</h3>
          <p>Connect poems to related songs, themes, and narrative projects.</p>
        </div>
        <div class="feature-card">
          <h3>📅 Publication Timeline</h3>
          <p>Track submission history, publication dates, and venue information.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="integration-section">
    <div class="container">
      <h2>Integration with Other Collections</h2>
      <p class="section-intro">
        Poems in wReady aren't isolated—they connect to the broader creative ecosystem:
      </p>
      <div class="integration-examples">
        <div class="integration-item">
          <h3>🎵 Songs</h3>
          <p>Poems can evolve into song lyrics, maintaining the connection between written and musical forms.</p>
        </div>
        <div class="integration-item">
          <h3>🎭 Projects</h3>
          <p>Thematic elements from poems inform screenplay themes and character development.</p>
        </div>
        <div class="integration-item">
          <h3>📖 Short Stories</h3>
          <p>Poetic imagery and themes carry over into prose narrative work.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .poems-hero {
    padding: 4rem 0;
    border-bottom: 1px solid var(--border);
  }

  .poems-hero h1 {
    margin-bottom: 1rem;
    font-size: var(--text-4xl);
  }

  .intro {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    max-width: 700px;
    line-height: 1.6;
  }

  .poems-list {
    padding: 3rem 0;
    border-bottom: 1px solid var(--border);
  }

  h2 {
    margin-bottom: 2rem;
    font-size: var(--text-2xl);
  }

  .poem-card {
    padding: 2.5rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--bg);
  }

  .poem-card.featured {
    border-color: var(--accent);
    border-width: 2px;
  }

  .poem-header {
    margin-bottom: 2rem;
  }

  .poem-card h3 {
    margin: 0 0 0.5rem 0;
    font-size: var(--text-2xl);
    color: var(--accent);
    font-style: italic;
  }

  .poem-meta {
    font-size: var(--text-sm);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .poem-excerpt {
    margin-bottom: 2rem;
    padding: 2rem;
    background: var(--bg-secondary);
    border-left: 3px solid var(--accent);
    border-radius: 0.25rem;
  }

  .stanza {
    margin: 0 0 1.5rem 0;
    font-family: Georgia, serif;
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--text);
  }

  .stanza:last-of-type {
    margin-bottom: 1rem;
  }

  .read-more {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
    font-style: italic;
  }

  .poem-details {
    margin-bottom: 2rem;
  }

  .poem-details h4 {
    margin: 0 0 0.75rem 0;
    font-size: var(--text-lg);
    color: var(--text);
  }

  .poem-details p {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .poem-features {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
    padding: 1.5rem;
    background: var(--bg-secondary);
    border-radius: 0.25rem;
  }

  .feature-item {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .feature-item strong {
    color: var(--text);
  }

  .status-badge {
    padding: 0.25rem 0.75rem;
    background: var(--status-published);
    border-radius: 1rem;
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .view-poem-btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--accent);
    color: white;
    text-decoration: none;
    border-radius: 0.25rem;
    font-weight: 600;
    transition: all var(--transition-fast);
  }

  .view-poem-btn:hover {
    background: var(--accent-dark);
    transform: translateX(4px);
  }

  .more-poems {
    margin-top: 3rem;
    padding: 2rem;
    text-align: center;
    color: var(--text-muted);
    font-style: italic;
  }

  .features-section {
    padding: 3rem 0;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .feature-card {
    padding: 1.5rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
  }

  .feature-card h3 {
    margin: 0 0 0.75rem 0;
    font-size: var(--text-lg);
    color: var(--text);
  }

  .feature-card p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .integration-section {
    padding: 3rem 0;
  }

  .section-intro {
    margin-bottom: 2rem;
    color: var(--text-secondary);
    font-size: var(--text-base);
    line-height: 1.6;
  }

  .integration-examples {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .integration-item h3 {
    margin: 0 0 0.5rem 0;
    font-size: var(--text-lg);
    color: var(--accent);
  }

  .integration-item p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 720px) {
    .poems-hero h1 {
      font-size: var(--text-3xl);
    }

    .features-grid,
    .integration-examples {
      grid-template-columns: 1fr;
    }
  }
</style>