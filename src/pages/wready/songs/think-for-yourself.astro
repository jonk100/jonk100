---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Think for Yourself - wReady Showcase" description="Original song with chord chart and lyrics">
  <article class="song-detail">
    
    <!-- Hero Section -->
    <section class="song-hero">
      <div class="container">
        <div class="breadcrumb">
          <a href="/wready">wReady</a> / <a href="/wready/songs">Songs</a> / Think for Yourself
        </div>
        <h1>Think for Yourself</h1>
        <div class="song-meta">
          <span class="meta-item"><strong>Key:</strong> G Major</span>
          <span class="meta-item"><strong>Tempo:</strong> 120 BPM</span>
          <span class="meta-item"><strong>Time:</strong> 4/4</span>
          <span class="meta-item"><strong>Status:</strong> Arranged</span>
        </div>
      </div>
    </section>

    <!-- Song Info -->
    <section class="song-info">
      <div class="container">
        <div class="info-grid">
          <div class="info-card">
            <h2>About</h2>
            <p>
              A folk-rock anthem about independent thinking and questioning authority. 
              Features a driving acoustic rhythm with electric lead accents. The song 
              challenges listeners to think critically rather than blindly following 
              influential voices, whether they're politicians, media figures, or cultural icons.
            </p>
          </div>
          
          <div class="info-card">
            <h2>Structure</h2>
            <ul class="structure-list">
              <li>Intro (8 bars)</li>
              <li>Verse 1</li>
              <li>Chorus</li>
              <li>Verse 2</li>
              <li>Chorus</li>
              <li>Solo (16 bars)</li>
              <li>Chorus (Key change to A Major)</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Chord Progression -->
    <section class="chords-section">
      <div class="container">
        <h2>Chord Progressions</h2>
        
        <div class="progression-grid">
          <div class="progression-card">
            <h3>Intro</h3>
            <p class="chord-line">Dsus2 - D7sus2 - Am - G - Em - Em7 - Em - Em</p>
            <p class="bars-info">8 bars</p>
          </div>

          <div class="progression-card">
            <h3>Verse</h3>
            <p class="chord-line">Am - Am - G - G - C - C - C - C</p>
            <p class="chord-line">Am - Am - G - G - Em - Em - G - G</p>
            <p class="bars-info">16 bars</p>
          </div>

          <div class="progression-card">
            <h3>Chorus</h3>
            <p class="chord-line">C - C - G - G - C - C - G - G</p>
            <p class="chord-line">C - C - G - G - Em - Em - D - D</p>
            <p class="chord-line">C - C - Em - Em</p>
            <p class="bars-info">20 bars</p>
          </div>

          <div class="progression-card">
            <h3>Solo</h3>
            <p class="chord-line">Em - Em - D - D - Am - Am - B - B</p>
            <p class="bars-info">8 bars × 2</p>
          </div>
        </div>

        <div class="key-change-note">
          <strong>Note:</strong> Final chorus modulates to A Major (D - A - F#m - E progression)
        </div>
      </div>
    </section>

    <!-- Lyrics -->
    <section class="lyrics-section">
      <div class="container">
        <h2>Lyrics</h2>
        
        <div class="lyrics-content">
          <div class="verse">
            <h3>Verse 1</h3>
            <p>
              If a wise man said<br>
              That you'd be better off dead<br>
              Would you just believe him?
            </p>
            <p>
              If a real cool fool<br>
              Told you to shoot up a school<br>
              Would you think to disagree?
            </p>
          </div>

          <div class="chorus">
            <h3>Chorus</h3>
            <p>
              Take a minute and think for yourself<br>
              Just sit and think<br>
              Think about what it means to you<br>
              And everybody else
            </p>
            <p>
              Just think for yourself<br>
              But do it sometime close to now<br>
              Or twisted forces paying cash<br>
              Will do it for you, only they know how
            </p>
          </div>

          <div class="verse">
            <h3>Verse 2</h3>
            <p>
              If you wrote a politician<br>
              And he wrote back that he was fishin'<br>
              Would that surprise you?<br>
              Did you think that he or she would listen?
            </p>
            <p>
              If another person you thought was good<br>
              Were doing things you didn't think he should<br>
              Would you still be disappointed?<br>
              Or would you wait to see what MSNBC said?
            </p>
          </div>

          <div class="chorus">
            <h3>Chorus</h3>
            <p>
              Just think yourself<br>
              Think about what it means for you<br>
              And everybody else
            </p>
            <p>
              Think for yourself<br>
              But do it sometime close to now<br>
              Or twisted forces paying cash<br>
              Will do it for you, only they know how
            </p>
          </div>

          <div class="solo">
            <h3>Solo</h3>
            <p class="instrumental">[INSTRUMENTAL] × 2</p>
          </div>

          <div class="chorus">
            <h3>Final Chorus (Key: A Major)</h3>
            <p>
              Take a minute and think for yourself<br>
              Just sit and think<br>
              Think about what it means to you<br>
              And everybody else
            </p>
            <p>
              Just think for yourself<br>
              But do it sometime close to now<br>
              Or twisted forces paying cash<br>
              Will do it for you, only they know how
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Chords Used -->
    <section class="chords-used-section">
      <div class="container">
        <h2>Chords Used</h2>
        <p class="section-intro">
          This song uses the following chord voicings. Click on any chord to see the full diagram and fingering.
        </p>
        <div class="chord-tags">
          <span class="chord-tag">G</span>
          <span class="chord-tag">Em</span>
          <span class="chord-tag">C</span>
          <span class="chord-tag">D</span>
          <span class="chord-tag">Am</span>
          <span class="chord-tag">Dsus2</span>
          <span class="chord-tag">D7sus2</span>
          <span class="chord-tag">Em7</span>
          <span class="chord-tag">A</span>
          <span class="chord-tag">F#m</span>
          <span class="chord-tag">E</span>
          <span class="chord-tag">B</span>
        </div>
        <a href="/wready/chords" class="view-chords-link">View Full Chord Library →</a>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-box">
          <h2>More Songs</h2>
          <p>Explore other original songs with chord charts and lyrics.</p>
          <a href="/wready/songs" class="cta-button">← Back to Songs</a>
        </div>
      </div>
    </section>

  </article>
</BaseLayout>

<style>
  .song-detail {
    width: 100%;
  }

  .container {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 var(--space-8);
  }

  /* Hero */
  .song-hero {
    padding: 3rem 0 2rem;
    border-bottom: 1px solid var(--border);
  }

  .breadcrumb {
    margin-bottom: 1.5rem;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .breadcrumb a {
    color: var(--accent);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  h1 {
    margin: 0 0 1rem 0;
    font-size: var(--text-4xl);
    color: var(--accent);
  }

  .song-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-size: var(--text-sm);
  }

  .meta-item {
    color: var(--text-secondary);
  }

  .meta-item strong {
    color: var(--text);
  }

  /* Sections */
  .song-info,
  .chords-section,
  .lyrics-section,
  .chords-used-section {
    padding: 3rem 0;
    border-bottom: 1px solid var(--border);
  }

  .chords-section,
  .chords-used-section {
    background: var(--bg-secondary);
  }

  h2 {
    margin: 0 0 2rem 0;
    font-size: var(--text-2xl);
  }

  .section-intro {
    margin-bottom: 2rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Info Grid */
  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .info-card {
    padding: 2rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
  }

  .info-card h2 {
    margin: 0 0 1rem 0;
    font-size: var(--text-xl);
    color: var(--accent);
  }

  .info-card p {
    margin: 0;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .structure-list {
    margin: 0;
    padding-left: 1.5rem;
    list-style: disc;
  }

  .structure-list li {
    margin-bottom: 0.5rem;
    color: var(--text-secondary);
  }

  /* Chord Progressions */
  .progression-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .progression-card {
    padding: 1.5rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
  }

  .progression-card h3 {
    margin: 0 0 1rem 0;
    font-size: var(--text-lg);
    color: var(--accent);
  }

  .chord-line {
    margin: 0 0 0.5rem 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text);
  }

  .bars-info {
    margin: 1rem 0 0 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
    font-style: italic;
  }

  .key-change-note {
    padding: 1.5rem;
    background: var(--bg);
    border-left: 3px solid var(--accent);
    border-radius: 0.25rem;
  }

  .key-change-note strong {
    color: var(--accent);
  }

  /* Lyrics */
  .lyrics-content {
    max-width: 700px;
  }

  .verse,
  .chorus,
  .solo {
    margin-bottom: 3rem;
  }

  .verse h3,
  .chorus h3,
  .solo h3 {
    margin: 0 0 1rem 0;
    font-size: var(--text-lg);
    color: var(--accent);
  }

  .verse p,
  .chorus p {
    margin: 0 0 1.5rem 0;
    line-height: 1.8;
    color: var(--text);
    font-family: Georgia, serif;
  }

  .instrumental {
    font-style: italic;
    color: var(--text-muted);
  }

  /* Chords Used */
  .chord-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .chord-tag {
    padding: 0.5rem 1rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text);
    transition: all var(--transition-fast);
    cursor: pointer;
  }

  .chord-tag:hover {
    border-color: var(--accent);
    background: var(--bg-raised);
  }

  .view-chords-link {
    display: inline-block;
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
    transition: all var(--transition-fast);
  }

  .view-chords-link:hover {
    transform: translateX(4px);
  }

  /* CTA */
  .cta-section {
    padding: 3rem 0;
  }

  .cta-box {
    padding: 3rem;
    background: var(--bg-secondary);
    border: 2px solid var(--border);
    border-radius: 0.5rem;
    text-align: center;
  }

  .cta-box h2 {
    margin: 0 0 1rem 0;
  }

  .cta-box p {
    margin: 0 0 2rem 0;
    color: var(--text-secondary);
  }

  .cta-button {
    display: inline-block;
    padding: 1rem 2rem;
    background: var(--accent);
    color: white;
    text-decoration: none;
    border-radius: 0.25rem;
    font-weight: 600;
    transition: all var(--transition-fast);
  }

  .cta-button:hover {
    background: var(--accent-dark);
    transform: translateY(-2px);
  }

  @media (max-width: 720px) {
    .container {
      padding: 0 var(--space-4);
    }

    h1 {
      font-size: var(--text-3xl);
    }

    .song-meta {
      flex-direction: column;
      gap: 0.5rem;
    }

    .info-grid,
    .progression-grid {
      grid-template-columns: 1fr;
    }

    .cta-box {
      padding: 2rem;
    }
  }
</style>