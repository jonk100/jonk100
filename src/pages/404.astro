---
/**
 * src/pages/404.astro
 * Premium custom 404 error experience page.
 * - Displays a stunning design with visual typography and dynamic status labels.
 * - Guides users back home, to projects, or to writing collection lists.
 * - Adheres strictly to the portfolio layout aesthetics and JSDoc rules.
 */

import Layout from '../layouts/Layout.astro';
import Box from '../components/ui/layout/Box.astro';
import Stack from '../components/ui/layout/Stack.astro';
import Inline from '../components/ui/layout/Inline.astro';
import Text from '../components/ui/typography/Text.astro';
import Button from '../components/ui/controls/Button.astro';
import NavBar from '../components/portfolio/NavBar.astro';
---

<Layout title="404: Page Not Found | Jon" description="The page you are looking for does not exist. Let's get you back on track.">
  <NavBar />
  
  <div class="glow glow-1"></div>
  <div class="glow glow-2"></div>

  <main class="error-page">
    <Box class="container">
      <Stack gap="xl" align="center" class="content">
        <!-- Huge Visual 404 Header -->
        <h1 class="error-code animate-slide-up delay-1">
          4<em>0</em>4
        </h1>

        <!-- Eyebrow label -->
        <Text as="p" type="label" tone="accent" class="error-eyebrow animate-slide-up delay-2">
          Page Not Found
        </Text>

        <!-- Descriptive Copy -->
        <Text as="p" type="body" tone="subtle" class="error-tagline animate-slide-up delay-3">
          It looks like you've wandered off the track. The resource you are looking for has been moved, deleted, or was never here in the first place.
        </Text>

        <!-- Action Items -->
        <Inline gap="md" align="center" class="animate-slide-up delay-4">
          <Button href="/" theme="primary" size="md">
            Go Back Home
          </Button>
          <Button href="/projects" theme="ghost" size="md">
            Browse Projects
          </Button>
          <Button href="/blog" theme="ghost" size="md">
            Read Blog
          </Button>
        </Inline>
      </Stack>
    </Box>
  </main>
</Layout>

<style>
  .error-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: var(--space-24);
    padding-bottom: var(--space-20);
    position: relative;
    z-index: 10;
  }

  .container {
    width: 100%;
    max-width: var(--max-width, 1280px);
    margin: 0 auto;
    padding: 0 var(--space-8);
  }

  .content {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .error-code {
    font-family: var(--display);
    font-size: clamp(6rem, 15vw, 12rem);
    font-weight: 300;
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: var(--text);
    margin: 0;
  }

  .error-code em {
    font-style: normal;
    font-weight: 500;
    color: var(--accent);
  }

  .error-eyebrow {
    font-family: var(--mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .error-tagline {
    line-height: 1.8;
  }

  /* Ambient Background Glows */
  .glow {
    position: fixed;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    filter: blur(120px);
    z-index: 0;
    pointer-events: none;
    opacity: 0.15;
    animation: float 20s ease-in-out infinite alternate;
  }

  .glow-1 {
    top: -100px;
    left: -200px;
    background: var(--accent);
  }

  .glow-2 {
    bottom: -200px;
    right: -100px;
    background: var(--primary);
    animation-delay: -10s;
  }

  @keyframes float {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(100px, 100px) scale(1.1); }
  }
</style>
