---
/**
 * src/pages/design/[slug].astro
 * Dynamic routing and specialized visual layout for individual Design System component sheets.
 * - Compiles and displays dynamic MDX documentation entries with live previews
 * - Features sticky sidebar navigation lists, active state tracking, and category grouping
 * - Automatically renders tabular property tables from frontmatter metadata schemas
 * - Connects custom Hue and Radius sliders to update styling in real-time
 */

import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Text from '../../components/ui/typography/Text.astro';
import Divider from '../../components/ui/layout/Divider.astro';
import Sidebar from '../../components/design/index/Sidebar.astro';
import { componentCategories } from '../../lib/queries/designCategories';
import { groupComponentsByCategory } from '../../lib/queries/designGrouping';
import List from '../../components/ui/typography/List.astro';
import Quote from '../../components/ui/typography/Quote.astro';

import '../../styles/global.css';
import Link from '/src/components/ui/primitives/Link.astro';

export async function getStaticPaths() {
  const entries = await getCollection('design');
  return entries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { slug } = Astro.params;
const { Content } = await render(entry);

// Get all entries for the sidebar nav
const allComponents = await getCollection('design');
const sortedComponents = allComponents.sort((a, b) => a.data.order - b.data.order);

const groupedComponents =
  groupComponentsByCategory(sortedComponents);

const components = {
  ul: List,
  blockquote: Quote,
  a: Link
};
---

<Layout title={`${entry.data.title} | Design System Blueprints`} description={entry.data.description}>
  <div class="glow glow-sidebar"></div>
  <div class="glow glow-content"></div>

  <div class="design-workspace">
    <Sidebar components={groupedComponents} categories={componentCategories} />

    <!-- Main Content Docs Panel -->
    <main class="main-content">
      <div class="docs-container">
        <!-- Breadcrumbs -->
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol class="breadcrumb-list">
            <li><a href="/design" class="breadcrumb-link">Blueprints</a></li>
            <li class="separator">/</li>
            <li><span class="breadcrumb-link text-uppercase">{entry.data.category}</span></li>
            <li class="separator">/</li>
            <li aria-current="page"><span class="breadcrumb-active">{entry.data.title}</span></li>
          </ol>
        </nav>

        <!-- Document Header Section -->
        <header class="doc-header">
          <Text as="h1" type="h1" class="doc-title">{entry.data.title}</Text>
          <Text as="p" type="lead" tone="subtle" class="doc-subtitle">{entry.data.description}</Text>
        </header>

        <Divider class="header-divider" />

        <div class="doc-body">
          <!-- Render MDX Content containing Live Previews -->
          <article class="markdown-content">
            <Content components={components} />
          </article>

          <!-- Render Property Summary Table from Frontmatter Metadata -->
          {entry.data.propsTable && entry.data.propsTable.length > 0 && (
            <section class="props-section">
              <Divider class="section-divider" />
              <Text as="h3" type="h3" tone="accent" class="props-section-title">Component Properties</Text>
              <Text type="body-sm" tone="subtle" class="props-section-subtitle">
                Configure visual styling modifiers, interactive overlays, and theme bindings using these properties.
              </Text>
              
              <div class="table-container">
                <table class="props-table">
                  <thead>
                    <tr>
                      <th>Prop</th>
                      <th>Type</th>
                      <th>Default</th>
                      <th>Description</th>
                    </tr>
                  </thead>
                  <tbody>
                    {entry.data.propsTable.map(prop => (
                      <tr>
                        <td><code class="prop-code">{prop.name}</code></td>
                        <td><code class="type-code">{prop.type}</code></td>
                        <td>{prop.defaultValue ? <code class="default-code">{prop.defaultValue}</code> : <span class="muted">—</span>}</td>
                        <td><Text type="body-sm" class="prop-desc">{prop.description}</Text></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          )}
        </div>
      </div>
    </main>
  </div>
</Layout>

<style>
  .design-workspace {
    display: flex;
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
    position: relative;
  }

  /* Ambient Curated Glows */
  .glow {
    position: fixed;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    filter: blur(140px);
    z-index: 0;
    pointer-events: none;
    opacity: 0.08;
  }
  .glow-sidebar {
    top: -200px;
    left: -200px;
    background: var(--primary);
  }
  .glow-content {
    bottom: -200px;
    right: -200px;
    background: var(--accent);
  }

  /* Main content layout */
  .main-content {
    flex-grow: 1;
    max-width: calc(100% - 280px);
    padding: var(--space-12) var(--space-16);
    position: relative;
    z-index: 10;
    overflow-y: auto;
  }

  .docs-container {
    max-width: 900px;
  }

  /* Breadcrumbs */
  .breadcrumbs {
    margin-bottom: var(--space-6);
  }

  .breadcrumb-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .breadcrumb-link {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb-link:hover {
    color: var(--text);
  }

  .separator {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .text-uppercase {
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .breadcrumb-active {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent);
  }

  /* Document Header */
  .doc-header {
    margin-bottom: var(--space-8);
  }

  .doc-title {
    font-size: var(--text-5xl);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-2);
  }

  .doc-subtitle {
    margin: 0;
  }

  .header-divider {
    margin-bottom: var(--space-10);
  }

  /* MDX Markdown overrides for styling */
  .markdown-content :global(h3) {
    font-size: var(--text-xl);
    color: var(--text-4);
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    font-weight: 600;
  }

  .markdown-content :global(h4) {
    font-size: var(--text-md);
    color: var(--text-3);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    font-weight: 600;
  }

  .markdown-content :global(p) {
    font-size: var(--text-base);
    color: var(--text-subtle);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-6);
  }

  .markdown-content :global(code:not(pre code)) {
    font-family: var(--mono);
    font-size: 85%;
    padding: var(--space-1) var(--space-2);
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
    border-radius: var(--rad-sm);
    color: var(--accent);
  }

  /* Properties Section */
  .props-section {
    margin-top: var(--space-16);
  }

  .section-divider {
    margin-bottom: var(--space-10);
  }

  .props-section-title {
    margin-bottom: var(--space-1);
  }

  .props-section-subtitle {
    margin-bottom: var(--space-8);
  }

  .table-container {
    width: 100%;
    overflow-x: auto;
    border-radius: var(--rad-md);
    border: 1px solid var(--border-subtle);
    background: var(--surface-0);
  }

  .props-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: var(--text-sm);
  }

  .props-table th, .props-table td {
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--border-subtle);
  }

  .props-table th {
    background: var(--surface-1);
    color: var(--text);
    font-weight: 600;
    font-family: var(--sans);
  }

  .props-table tr:last-child td {
    border-bottom: none;
  }

  .prop-code, .type-code, .default-code {
    padding: 2px var(--space-2);
    border-radius: var(--rad-sm);
    background: var(--surface-2) !important;
    border: 1px solid var(--border-subtle);
    font-size: 0.85em;
  }

  .prop-code {
    font-family: var(--mono);
    color: var(--accent);
    font-weight: 600;
  }

  .type-code {
    font-family: var(--mono);
    color: var(--primary-light, #60a5fa);
  }

  .default-code {
    font-family: var(--mono);
    color: var(--text-2, #cbd5e1);
  }

  .prop-desc {
    margin: 0;
  }

  @media (max-width: 1024px) {
    .sidebar {
      display: none;
    }
    .main-content {
      max-width: 100%;
      padding: var(--space-6) var(--space-8);
    }
  }
</style>
