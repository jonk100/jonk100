---
/**
 * src/pages/design/[slug].astro
 * Dynamic routing and specialized visual layout for individual Design System component sheets.
 * - Compiles and displays dynamic MDX documentation entries with live previews
 * - Features sticky sidebar navigation lists, active state tracking, and category grouping
 * - Automatically renders tabular property tables from frontmatter metadata schemas
 * - Connects custom Hue and Radius sliders to update styling in real-time
 */

import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Text from '../../components/ui/typography/Text.astro';
import Stack from '../../components/ui/layout/Stack.astro';
import Inline from '../../components/ui/layout/Inline.astro';
import Grid from '../../components/ui/layout/Grid.astro';
import Paper from '../../components/ui/primitives/Paper.astro';
import Badge from '../../components/ui/feedback/Badge.astro';
import Icon from '../../components/ui/primitives/Icon.astro';
import Divider from '../../components/ui/layout/Divider.astro';

import '../../styles/global.css';

export async function getStaticPaths() {
  const entries = await getCollection('design');
  return entries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { slug } = Astro.params;
const { Content } = await render(entry);

// Get all entries for the sidebar nav
const allComponents = await getCollection('design');
const sortedComponents = allComponents.sort((a, b) => a.data.order - b.data.order);

const categories = ['primitives', 'layouts', 'controls', 'overlays', 'feedback'];
const groupedComponents = categories.reduce((acc, cat) => {
  acc[cat] = sortedComponents.filter(c => c.data.category === cat);
  return acc;
}, {} as Record<string, typeof sortedComponents>);

const categoryTitles: Record<string, string> = {
  primitives: "Primitives",
  layouts: "Layouts",
  controls: "Controls",
  overlays: "Overlays",
  feedback: "Feedback"
};

const categoryIcons: Record<string, string> = {
  primitives: "zap",
  layouts: "info",
  controls: "check-circle",
  overlays: "alert-circle",
  feedback: "alert-triangle"
};
---

<Layout title={`${entry.data.title} | Design System Blueprints`} description={entry.data.description}>
  <div class="glow glow-sidebar"></div>
  <div class="glow glow-content"></div>

  <div class="design-workspace">
    <!-- Sticky Navigation Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-brand">
        <a href="/design" class="catalog-link">
          <div class="brand-arrow">
            <Icon name="arrow-left" size="sm" />
          </div>
          <span class="brand-text">Blueprints</span>
        </a>
      </div>

      <nav class="sidebar-nav">
        {categories.map(cat => {
          const list = groupedComponents[cat];
          if (list.length === 0) return null;
          const icon = categoryIcons[cat] || 'info';

          return (
            <div class="nav-group">
              <span class="nav-group-title">{categoryTitles[cat] || cat}</span>
              <div class="nav-group-links">
                {list.map(comp => (
                  <a 
                    href={`/design/${comp.id}`} 
                    class:list={['nav-item', { 'is-active': comp.id === slug }]}
                  >
                    <Icon name={icon} size="sm" class="nav-item-icon" />
                    <span>{comp.data.title}</span>
                  </a>
                ))}
              </div>
            </div>
          );
        })}
      </nav>

      <!-- Token Range Slider Sandbox Inside Sticky Sidebar -->
      <div class="sidebar-sandbox">
        <Divider class="sandbox-divider" />
        <Stack gap="xs" class="sidebar-sandbox-panel">
          <Text as="strong" type="caption" tone="accent" class="sandbox-panel-title">Sandbox Controllers</Text>
          <Stack gap="xs">
            <Stack gap="3xs">
              <label for="accent-hue" class="slider-label">
                <Text type="caption" tone="subtle" style="font-size: 10px;">Accent Hue: <span id="hue-val">200</span>°</Text>
              </label>
              <input type="range" id="accent-hue" min="0" max="360" value="200" class="slider-range" />
            </Stack>
            <Stack gap="3xs">
              <label for="border-radius" class="slider-label">
                <Text type="caption" tone="subtle" style="font-size: 10px;">Border Radius: <span id="radius-val">8</span>px</Text>
              </label>
              <input type="range" id="border-radius" min="0" max="24" value="8" class="slider-range" />
            </Stack>
          </Stack>
        </Stack>
      </div>
      
      <div class="sidebar-footer">
        <Text type="caption" tone="muted">Jon.Design System • v2.0</Text>
      </div>
    </aside>

    <!-- Main Content Docs Panel -->
    <main class="main-content">
      <div class="docs-container">
        <!-- Breadcrumbs -->
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol class="breadcrumb-list">
            <li><a href="/design" class="breadcrumb-link">Blueprints</a></li>
            <li class="separator">/</li>
            <li><span class="breadcrumb-link text-uppercase">{entry.data.category}</span></li>
            <li class="separator">/</li>
            <li aria-current="page"><span class="breadcrumb-active">{entry.data.title}</span></li>
          </ol>
        </nav>

        <!-- Document Header Section -->
        <header class="doc-header">
          <Text as="h1" type="h1" class="doc-title">{entry.data.title}</Text>
          <Text as="p" type="lead" tone="subtle" class="doc-subtitle">{entry.data.description}</Text>
        </header>

        <Divider class="header-divider" />

        <div class="doc-body">
          <!-- Render MDX Content containing Live Previews -->
          <article class="markdown-content">
            <Content />
          </article>

          <!-- Render Property Summary Table from Frontmatter Metadata -->
          {entry.data.propsTable && entry.data.propsTable.length > 0 && (
            <section class="props-section">
              <Divider class="section-divider" />
              <Text as="h3" type="h3" tone="accent" class="props-section-title">Component Properties</Text>
              <Text type="body-sm" tone="subtle" class="props-section-subtitle">
                Configure visual styling modifiers, interactive overlays, and theme bindings using these properties.
              </Text>
              
              <div class="table-container">
                <table class="props-table">
                  <thead>
                    <tr>
                      <th>Prop</th>
                      <th>Type</th>
                      <th>Default</th>
                      <th>Description</th>
                    </tr>
                  </thead>
                  <tbody>
                    {entry.data.propsTable.map(prop => (
                      <tr>
                        <td><code class="prop-code">{prop.name}</code></td>
                        <td><code class="type-code">{prop.type}</code></td>
                        <td>{prop.defaultValue ? <code class="default-code">{prop.defaultValue}</code> : <span class="muted">—</span>}</td>
                        <td><Text type="body-sm" class="prop-desc">{prop.description}</Text></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          )}
        </div>
      </div>
    </main>
  </div>
</Layout>

<script is:inline>
  const runSandbox = () => {
    const hueSlider = document.getElementById('accent-hue');
    const radiusSlider = document.getElementById('border-radius');
    const hueVal = document.getElementById('hue-val');
    const radiusVal = document.getElementById('radius-val');
    
    if (!hueSlider || !radiusSlider) return;
    
    const updateAccent = () => {
      const hue = hueSlider.value;
      if (hueVal) hueVal.textContent = hue;
      
      // Calculate related colors in HSL
      document.documentElement.style.setProperty('--accent', `hsl(${hue}, 53%, 66%)`);
      document.documentElement.style.setProperty('--accent-dim', `hsl(${hue}, 53%, 23%)`);
      document.documentElement.style.setProperty('--accent-border', `hsl(${hue}, 53%, 35%)`);
      document.documentElement.style.setProperty('--accent-border-strong', `hsl(${hue}, 53%, 68%)`);
      document.documentElement.style.setProperty('--accent-hover', `hsl(${hue}, 53%, 50%)`);
    };
    
    const updateRadius = () => {
      const rad = radiusSlider.value;
      if (radiusVal) radiusVal.textContent = rad;
      
      // Calculate related border radii
      document.documentElement.style.setProperty('--rad-sm', `${Math.max(0, rad - 4)}px`);
      document.documentElement.style.setProperty('--rad-md', `${rad}px`);
      document.documentElement.style.setProperty('--rad-lg', `${Number(rad) + 4}px`);
      document.documentElement.style.setProperty('--rad-xl', `${Number(rad) + 8}px`);
    };
    
    hueSlider.addEventListener('input', updateAccent);
    radiusSlider.addEventListener('input', updateRadius);
    
    // Initial triggers
    updateAccent();
    updateRadius();
  };
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', runSandbox);
  } else {
    runSandbox();
  }
  document.addEventListener('astro:page-load', runSandbox);
</script>

<style>
  .design-workspace {
    display: flex;
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
    position: relative;
  }

  /* Ambient Curated Glows */
  .glow {
    position: fixed;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    filter: blur(140px);
    z-index: 0;
    pointer-events: none;
    opacity: 0.08;
  }
  .glow-sidebar {
    top: -200px;
    left: -200px;
    background: var(--primary);
  }
  .glow-content {
    bottom: -200px;
    right: -200px;
    background: var(--accent);
  }

  /* Sidebar styling */
  .sidebar {
    width: 280px;
    background: var(--bg-surface);
    border-right: 1px solid var(--border-subtle);
    position: sticky;
    top: 0;
    height: 100vh;
    padding: var(--space-8) var(--space-6);
    display: flex;
    flex-direction: column;
    z-index: 100;
    overflow-y: auto;
  }

  .sidebar-brand {
    margin-bottom: var(--space-8);
  }

  .catalog-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text);
    font-family: var(--display);
    font-weight: 600;
    font-size: var(--text-lg);
    text-decoration: none;
  }

  .brand-arrow {
    display: flex;
    align-items: center;
    color: var(--text-subtle);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                color 0.3s ease;
  }
  .catalog-link:hover .brand-arrow {
    transform: translateX(-4px);
    color: var(--accent);
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    flex-grow: 1;
  }

  .nav-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .nav-group-title {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    padding-left: var(--space-4);
  }

  .nav-group-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--rad-md);
    color: var(--text-subtle);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .nav-item:hover {
    color: var(--text);
    background: var(--bg-elevated);
  }

  .nav-item.is-active {
    color: var(--accent);
    background: var(--bg-elevated);
    border-left: 2px solid var(--accent);
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    padding-left: calc(var(--space-4) - 2px);
    font-weight: 600;
  }

  .nav-item-icon {
    flex-shrink: 0;
    color: var(--text-muted);
  }
  
  .nav-item.is-active .nav-item-icon {
    color: var(--accent);
  }

  /* Sidebar Sandbox Controllers */
  .sidebar-sandbox {
    margin-top: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .sandbox-divider {
    margin-bottom: var(--space-4);
  }

  .sandbox-panel-title {
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .slider-label {
    display: block;
  }

  .slider-range {
    width: 100%;
    accent-color: var(--accent);
    cursor: pointer;
    background: var(--bg-elevated);
    height: 4px;
    border-radius: var(--rad-full);
    border: none;
  }

  .sidebar-footer {
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }

  /* Main content layout */
  .main-content {
    flex-grow: 1;
    max-width: calc(100% - 280px);
    padding: var(--space-12) var(--space-16);
    position: relative;
    z-index: 10;
    overflow-y: auto;
  }

  .docs-container {
    max-width: 900px;
  }

  /* Breadcrumbs */
  .breadcrumbs {
    margin-bottom: var(--space-6);
  }

  .breadcrumb-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .breadcrumb-link {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb-link:hover {
    color: var(--text);
  }

  .separator {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .text-uppercase {
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .breadcrumb-active {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent);
  }

  /* Document Header */
  .doc-header {
    margin-bottom: var(--space-8);
  }

  .doc-title {
    font-size: var(--text-5xl);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-2);
  }

  .doc-subtitle {
    margin: 0;
  }

  .header-divider {
    margin-bottom: var(--space-10);
  }

  /* MDX Markdown overrides for styling */
  .markdown-content :global(h3) {
    font-size: var(--text-xl);
    color: var(--text-4);
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    font-weight: 600;
  }

  .markdown-content :global(h4) {
    font-size: var(--text-md);
    color: var(--text-3);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    font-weight: 600;
  }

  .markdown-content :global(p) {
    font-size: var(--text-base);
    color: var(--text-subtle);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-6);
  }

  .markdown-content :global(code:not(pre code)) {
    font-family: var(--mono);
    font-size: 85%;
    padding: var(--space-1) var(--space-2);
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
    border-radius: var(--rad-sm);
    color: var(--accent);
  }

  /* Properties Section */
  .props-section {
    margin-top: var(--space-16);
  }

  .section-divider {
    margin-bottom: var(--space-10);
  }

  .props-section-title {
    margin-bottom: var(--space-1);
  }

  .props-section-subtitle {
    margin-bottom: var(--space-8);
  }

  .table-container {
    width: 100%;
    overflow-x: auto;
    border-radius: var(--rad-md);
    border: 1px solid var(--border-subtle);
    background: var(--surface-0);
  }

  .props-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: var(--text-sm);
  }

  .props-table th, .props-table td {
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--border-subtle);
  }

  .props-table th {
    background: var(--surface-1);
    color: var(--text);
    font-weight: 600;
    font-family: var(--sans);
  }

  .props-table tr:last-child td {
    border-bottom: none;
  }

  .prop-code {
    font-family: var(--mono);
    color: var(--accent);
    font-weight: 600;
  }

  .type-code {
    font-family: var(--mono);
    color: var(--primary);
  }

  .default-code {
    font-family: var(--mono);
    color: var(--text-muted);
  }

  .prop-desc {
    margin: 0;
  }

  @media (max-width: 1024px) {
    .sidebar {
      display: none;
    }
    .main-content {
      max-width: 100%;
      padding: var(--space-6) var(--space-8);
    }
  }
</style>
