---
/**
 * src/pages/design/index.astro
 * The dynamic index catalog and cover showcase for our Design System.
 * - Queries the 'design' content collection and groups components by category
 * - Provides dynamic sliders to adjust global accent hues and border-radii at runtime
 * - Shared, unified sticky sidebar layout for complete UX consistency
 */
import { getCollection } from 'astro:content';
import { componentCategories } from '../../lib/queries/designCategories';
import { groupComponentsByCategory } from '../../lib/queries/designGrouping';
import { getCategory, categories } from '../../lib/queries/designCategories';

import Layout from '../../layouts/Layout.astro';
import Stack from '../../components/ui/layout/Stack.astro';
import Sidebar from '../../components/design/index/Sidebar.astro';
import DesignHeader from '../../components/design/index/DesignHeader.astro';
import CategorySection from '../../components/design/index/CategorySection.astro';
import '../../styles/global.css';

const components = await getCollection('design');

const sortedComponents = [...components].sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);

const groupedComponents =
  groupComponentsByCategory(sortedComponents);

---

<Layout title="Blueprints | Jon.Design Showcase System">
  <div class="glow glow-sidebar"></div>
  <div class="glow glow-content"></div>

  <div class="design-workspace">

    <Sidebar components={groupedComponents} categories={componentCategories} />

    <!-- Main Content Catalog Showcase -->
    <main class="main-content">
      <div class="docs-container">
        <DesignHeader />
        
        <!-- Categories & Components Directory -->
        <Stack gap="xl">
          {categories.map((category) => (
            <CategorySection
              cat={getCategory(category)}
              list={groupedComponents[category]}
            />
          ))}
        </Stack>
      </div>
    </main>
  </div>
</Layout>

<style>
  .design-workspace {
    display: flex;
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
    position: relative;
  }

  /* Curated Ambient Glow Effects */
  .glow {
    position: fixed;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    filter: blur(140px);
    z-index: 0;
    pointer-events: none;
    opacity: 0.08;
  }

  .glow-sidebar {
    top: -200px;
    left: -200px;
    background: var(--primary);
  }

  .glow-content {
    bottom: -200px;
    right: -200px;
    background: var(--accent);
  }

  /* Main content layout */
  .main-content {
    flex-grow: 1;
    max-width: calc(100% - 280px);
    padding: var(--space-12) var(--space-16);
    position: relative;
    z-index: 10;
    overflow-y: auto;
  }

  .docs-container {
    max-width: 900px;
  }

  @media (max-width: 1024px) {
    .sidebar {
      display: none;
    }

    .main-content {
      max-width: 100%;
      padding: var(--space-6) var(--space-8);
    }
  }
</style>
