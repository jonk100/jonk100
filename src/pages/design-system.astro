---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Link from '../components/ui/primitives/Link.astro';
import Paper from '../components/ui/primitives/Paper.astro';
import Frame from '../components/ui/primitives/Frame.astro';
import Text from '../components/ui/primitives/Text.astro';

// Layout Primitives
import Box from '../components/ui/layout/Box.astro';
import Stack from '../components/ui/layout/Stack.astro';
import Inline from '../components/ui/layout/Inline.astro';
import Grid from '../components/ui/layout/Grid.astro';
import Center from '../components/ui/layout/Center.astro';
import VisuallyHidden from '../components/ui/layout/VisuallyHidden.astro';
import VisuallyInteractive from '../components/ui/layout/VisuallyInteractive.astro';

// Feedback & Input Primitives
import Input from '../components/ui/input/Input.astro';
import Badge from '../components/ui/feedback/Badge.astro';
import Spinner from '../components/ui/feedback/Spinner.astro';
import Skeleton from '../components/ui/feedback/Skeleton.astro';
import Avatar from '../components/ui/feedback/Avatar.astro';
import Icon from '../components/ui/media/Icon.astro';

// Overlays & Portals
import Modal from '../components/ui/overlay/Modal.astro';
import Popover from '../components/ui/overlay/Popover.astro';
import Tooltip from '../components/ui/overlay/Tooltip.astro';

// Animation & State
import Transition from '../components/ui/animation/Transition.astro';

import '../styles/global.css';
---

<Layout title="Design System & Architecture Test">
	<main class="p-fluid">
		
		<Center class="m-xl">
			<Text as="h1" type="h1" tone="primary">Design System Verification</Text>
		</Center>

		<Stack gap="xl" divider>
			
			<Box padding="md">
				<Text as="h2" type="h2">Phase 1 & 2: Forms & Layout</Text>
				<Grid cols={2} gap="lg" class="mt-4">
					<Input label="Email Address" type="email" placeholder="you@example.com" required hint="We will never share your email." />
					<Input label="Search" type="search" placeholder="Search projects..." error="Invalid search term." />
				</Grid>
				<Inline gap="lg" class="mt-4">
					<Avatar src="https://i.pravatar.cc/150?img=1" size="lg" status="online" />
					<Avatar fallback="JB" size="lg" status="busy" shape="rounded" />
					<Badge theme="primary">New Feature</Badge>
					<Badge theme="ghost" outlined>System Stable</Badge>
				</Inline>
			</Box>

			<Box padding="md">
				<Text as="h2" type="h2">Phase 3: Native Overlays (Modals & Popovers)</Text>
				<Inline gap="md" class="mt-4">
					<button commandfor="test-modal" command="show-modal" class="control variant--primary control--md">
						Open Modal
					</button>

					<Modal id="test-modal" title="Confirm Action">
						<Stack gap="md">
							<Text>Are you sure you want to perform this highly destructive action? This uses the native dialog element and allows light dismiss.</Text>
							<Inline gap="sm" justify="end">
								<button commandfor="test-modal" command="close" class="control variant--ghost control--md">Cancel</button>
								<button commandfor="test-modal" command="close" class="control variant--primary control--md">Confirm</button>
							</Inline>
						</Stack>
					</Modal>

					<button id="pop-btn" style="anchor-name: --pop-btn;" commandfor="test-popover" command="toggle-popover" class="control variant--secondary control--md">
						Toggle Popover
					</button>

					<Popover id="test-popover" anchor="pop-btn" placement="bottom">
						<Stack gap="sm">
							<Text as="strong">Options Menu</Text>
							<button class="control variant--ghost control--sm">Edit Profile</button>
							<button class="control variant--ghost control--sm">Sign Out</button>
						</Stack>
					</Popover>

					<button id="tip-btn" style="anchor-name: --tip-btn;" class="control variant--outline control--md">
						Hover Me
					</button>

					<Tooltip id="test-tooltip" anchor="tip-btn" placement="top">
						This is a helpful tip!
					</Tooltip>
				</Inline>
			</Box>

			<Box padding="md">
				<Text as="h2" type="h2">Phase 4: Transition & View Transitions</Text>
				<Stack gap="md" class="mt-4">
					<Text tone="subtle">Hover over the boxes below to see CSS generic transitions managed by Transition.astro.</Text>
					
					<Inline gap="md">
						<Transition as="div" duration="fast" easing="linear" class="hover-box">
							<Text>Fast Linear</Text>
						</Transition>

						<Transition as="div" duration="normal" easing="bounce" class="hover-box">
							<Text>Normal Bounce</Text>
						</Transition>

						<Transition as="div" duration="slow" easing="ease-in-out" class="hover-box">
							<Text>Slow EaseInOut</Text>
						</Transition>
					</Inline>

					<Text tone="subtle" class="mt-4">
						Astro's View Transitions are enabled! If you navigate to another page, elements with `view-transition-name` will smoothly morph.
					</Text>
				</Stack>
			</Box>

		</Stack>

	</main>
</Layout>

<style>
	main {
		max-width: var(--max-width);
		margin: 0 auto;
	}
	.bg-surface {
		background: var(--bg-surface);
		border-radius: var(--rad-md);
	}
	.mt-4 { margin-top: var(--space-4); }

	.hover-box {
		padding: var(--space-4);
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: var(--rad-md);
		cursor: pointer;
	}
	.hover-box:hover {
		transform: translateY(-5px);
		background: var(--primary);
	}
	.hover-box:hover :global(.text) {
		color: var(--text-inverse);
	}
</style>
