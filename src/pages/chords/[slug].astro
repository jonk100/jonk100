---
// File: src/pages/chords/[slug].astro
import { getCollection, render } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ChordDiagram from "../../components/songs/ChordDiagram.astro";
import { GUITAR_FRETBOARD } from "../../utils/music/instruments";

export const getStaticPaths = (async () => {
  const chords = await getCollection("chords");
  return chords.map((entry) => ({
    params: { slug: entry.id }, 
    props: { entry },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props as Props;
const { data } = entry;
const { Content } = await render(entry);

/**
 * Normalizes "barre (e-shape)" to "E-Shape Barre"
 */
const normalizeVoicing = (label: string) => {
  const match = label.match(/\((.+)\)/);
  if (match) {
    const shape = match[1].split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join('-');
    return `${shape} Barre`;
  }
  return label;
};

const normalizedTitle = `${data.displayName} (${normalizeVoicing(data.voicingLabel || '')})`;

const calculatedPitches = data.frets.map((fret: number | string, index: number): string | null => {
  if (fret === 'x' || fret === -1) return null;
  const stringData = GUITAR_FRETBOARD[index];
  return stringData ? stringData.notes[Number(fret)] : null;
}).filter((pitch): pitch is string => pitch !== null);
---

<BaseLayout title={normalizedTitle}>
  <article class="chord-detail">
    <header class="chord-header">
      <div class="header-content">
        <h1>{data.displayName}</h1>
        <p class="subtitle">{data.voicingLabel}</p>
      </div>
      <a href="/chords" class="back-link">← Back to Library</a>
    </header>

    <div class="chord-grid">
      <section class="diagram-section">
        <ChordDiagram 
          displayName={data.displayName}
          voicingLabel={data.voicingLabel}
          baseFret={data.baseFret}
          fingering={data.fingering}
          frets={data.frets}
          barre={data.barre}
        />
      </section>

      <section class="info-section">
        <div class="theory-card">
          <header class="theory-header">
             <h3>Theory & Voicing</h3>
             <h2 class="normalized-voicing">{normalizedTitle}</h2>
          </header>
          
          <ul class="meta-list">
            <li>
              <span class="label">Base Fret</span>
              <span class="value">{data.baseFret}</span>
            </li>
            <li>
              <span class="label">Pitches</span>
              <div class="pitch-tag-container">
                {calculatedPitches.map((pitch: string) => (
                  <span class="pitch-tag">{pitch}</span>
                ))}
              </div>
            </li>
          </ul>
        </div>
      </section>
    </div>

    <section class="prose-section">
      <Content />
    </section>
  </article>
</BaseLayout>

<style>
  .chord-detail {
    max-width: 1000px;
    margin: 0 auto;
    padding: var(--space-12) var(--space-4);
  }

  .chord-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-10);
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-6);
  }

  .subtitle {
    font-size: var(--text-xl);
    color: var(--text-muted);
  }

  .chord-grid {
    display: flex;
    gap: var(--space-4);
    align-items: stretch; 
    margin-bottom: var(--space-12);
  }

  .theory-card {
    background: var(--surface-subtle);
    /* Tightened padding to match the new compact ChordDiagram card */
    padding: var(--space-4) var(--space-6); 
    border-radius: var(--rounded-lg);
    border: 1px solid var(--border);
    height: 100%;
    min-width: 340px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .theory-header {
    /* Reduced margin to keep it compact */
    margin-bottom: var(--space-4);
  }

  .theory-card h3 {
    margin: 0;
    font-size: var(--text-xs); /* Slightly smaller sub-header */
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-muted);
    font-weight: 700;
  }

  .normalized-voicing {
    font-size: var(--text-xl); /* Balanced with the new square diagram height */
    font-weight: 800;
    margin-top: var(--space-1);
    color: var(--text-primary);
    line-height: 1.2;
  }

  .meta-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: var(--space-8); /* Side-by-side layout for metadata to save vertical space */
    align-items: flex-start;
  }

  .meta-list li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .value {
    font-size: var(--text-3xl); /* Punchy but fits the height */
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1;
  }

  .pitch-tag-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: var(--space-1);
  }

  .pitch-tag {
    background: var(--accent-subtle);
    color: var(--accent);
    /* Tighter padding to keep the pitch squares small but bold */
    padding: 0.3rem 0.6rem; 
    border-radius: 6px;
    font-size: var(--text-lg);
    font-family: var(--font-mono);
    font-weight: 800;
    border: 2px solid var(--accent-muted);
    min-width: 2.8rem;
    text-align: center;
  }

  .prose-section {
    max-width: 65ch;
    margin-top: var(--space-12);
  }

  @media (max-width: 800px) {
    .chord-grid {
      flex-direction: column;
    }
    .meta-list {
      flex-direction: column;
      gap: var(--space-6);
    }
    .theory-card {
      min-width: 0;
    }
  }
</style>