---
/**
 * /chords/index.astro
 *
 * Index page for all chord voicings. Cards show the chord name,
 * voicing label, and fingering information. Uses ChordCard components
 * for consistent styling with other collection pages.
 */

import { getCollection, type CollectionEntry } from "astro:content";
import IndexLayout from "../../layouts/IndexLayout.astro";
import ChordCard from "../../components/collection-cards/ChordCard.astro";
import ChordFilter from "../../components/filters/ChordFilter.astro";
import ChordAnalyser from "../../components/chords/ChordAnalyser.astro";
import ChordCreateForm from "../../components/chords/ChordCreateForm.astro";

const chords = await getCollection("chords");

// Sort by displayName then by slug (which encodes voicing number)
const sorted = chords.sort((a, b) => {
  const nameCompare = a.data.displayName.localeCompare(b.data.displayName);
  if (nameCompare !== 0) return nameCompare;
  return a.id.localeCompare(b.id);
});
---

<IndexLayout
  title="Chords"
  count={sorted.length}
  description="Guitar chord voicing reference library."
>
  <ChordAnalyser />
  <ChordCreateForm />
  <ChordFilter chords={sorted} />
  {sorted.length === 0 ? (
    <p class="empty">No chords yet.</p>
  ) : (
    <ul class="grid grid--cols-4">
      {sorted.map((entry) => (
        <li>
          <ChordCard entry={entry} />
        </li>
      ))}
    </ul>
  )}
</IndexLayout>

<style>
  .grid {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
    margin: 0;
  }

  .grid--cols-4 { grid-template-columns: repeat(4, 1fr); }

  /* Responsive: collapse to fewer columns on smaller screens */
  @media (max-width: 900px) {
    .grid--cols-4 { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 600px) {
    .grid--cols-4 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 400px) {
    .grid--cols-4 { grid-template-columns: 1fr; }
  }

  .empty {
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-style: italic;
    padding: var(--space-8) 0;
    text-align: center;
  }

  /* Chord-specific CSS variables */
  :root {
    --chord-major: #3b82f6;
    --chord-minor: #ef4444;
    --chord-seventh: #8b5cf6;
  }
</style>