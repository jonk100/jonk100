---
/**
 * /scenes/index.astro
 *
 * Index page for all scenes across all projects.
 * Uses SceneCard components for consistent styling with other collection pages.
 */

import { getCollection, type CollectionEntry } from "astro:content";
import IndexLayout from "../../layouts/IndexLayout.astro";
import SceneCard from "../../components/collection-cards/SceneCard.astro";

const scenes = await getCollection("scenes");

// Sort by project, then by scene number
const sorted = scenes.sort((a, b) => {
  const projectCompare = a.data.project.id.localeCompare(b.data.project.id);
  if (projectCompare !== 0) return projectCompare;
  return (a.data.sceneNumber || 0) - (b.data.sceneNumber || 0);
});
---

<IndexLayout
  title="Scenes"
  count={sorted.length}
  description="All scenes from all projects."
>
  {sorted.length === 0 ? (
    <p class="empty">No scenes yet.</p>
  ) : (
    <ul class="grid grid--cols-3">
      {sorted.map((entry) => (
        <li>
          <SceneCard entry={entry} />
        </li>
      ))}
    </ul>
  )}
</IndexLayout>

<style>
  .grid {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
    margin: 0;
  }

  .grid--cols-3 { grid-template-columns: repeat(3, 1fr); }

  /* Responsive: collapse to fewer columns on smaller screens */
  @media (max-width: 900px) {
    .grid--cols-3 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .grid--cols-3 { grid-template-columns: 1fr; }
  }

  .empty {
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-style: italic;
    padding: var(--space-8) 0;
    text-align: center;
  }
</style>
