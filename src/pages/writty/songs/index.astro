---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { cardConfig } from '../../../collections.config';

const songs = await getCollection('songs');
const sorted = songs.sort((a, b) => {
  const aTitle = a.data.title.toLowerCase();
  const bTitle = b.data.title.toLowerCase();
  return aTitle.localeCompare(bTitle);
});
---

<BaseLayout title="Songs - wReady" description="Original music with chord progressions and arrangements.">
  <section class="hub-detail">
    <div class="container">
      <a href="/writty" class="breadcrumb">← wReady</a>

      <h1>Songs</h1>
      <p class="section-intro">Original music with chord progressions and arrangements.</p>

      <div class="songs-grid">
        {sorted.map(song => {
          const card = cardConfig.songs(song);
          return (
            <a href={card.href} class="song-card">
              <h2>{card.title}</h2>
              {card.subtitle && <p class="album">{card.subtitle}</p>}
              <p class="meta">{card.meta}</p>
              {card.badge && <span class="badge">{card.badge}</span>}
            </a>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .breadcrumb {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color var(--transition-fast);
  }

  .breadcrumb:hover {
    color: var(--accent);
  }

  .section-intro {
    color: var(--text-secondary);
    font-size: var(--text-lg);
    margin-bottom: 3rem;
  }

  .songs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .song-card {
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-normal);
    position: relative;
  }

  .song-card:hover {
    border-color: var(--accent);
    background: var(--bg-secondary);
  }

  .song-card h2 {
    margin: 0 0 0.5rem 0;
    font-size: var(--text-base);
  }

  .song-card .album {
    margin: 0 0 0.5rem 0;
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .song-card .meta {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .song-card .badge {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.25rem 0.5rem;
    background: var(--accent);
    color: var(--bg);
    border-radius: 0.25rem;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
  }
</style>
