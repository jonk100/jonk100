---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="wReady - Creative Workbench" description="Explore creative projects, writings, and musical work.">
  <section class="hub">
    <div class="container">
      <h1>wReady</h1>
      <p class="hub-intro">
        A personal creative workbench for managing screenplays, songs, poems, and interconnected creative content.
      </p>

      <div class="hub-grid">
        <a href="/writty/projects" class="hub-card">
          <h2>Projects</h2>
          <p>Screenplay series, films, and books in development</p>
        </a>

        <a href="/writty/writings" class="hub-card">
          <h2>Writings</h2>
          <p>Poems, short stories, reviews, and essays</p>
        </a>

        <a href="/writty/songs" class="hub-card">
          <h2>Songs</h2>
          <p>Original music with chord progressions and arrangements</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hub-intro {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin-bottom: 3rem;
  }

  .hub-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .hub-card {
    padding: 2rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-normal);
  }

  .hub-card:hover {
    border-color: var(--accent);
    background: var(--bg-secondary);
  }

  .hub-card h2 {
    margin: 0 0 0.5rem 0;
    color: var(--accent);
  }

  .hub-card p {
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }
</style>
