---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { cardConfig } from '../../../collections.config';

const poems = await getCollection('poems');
const stories = await getCollection('short-stories');
const reviews = await getCollection('reviews');
---

<BaseLayout title="Writings - wReady" description="Poems, short stories, and reviews.">
  <section class="hub-detail">
    <div class="container">
      <a href="/writty" class="breadcrumb">← wReady</a>

      <h1>Writings</h1>
      <p class="section-intro">Poems, short stories, reviews, and essays.</p>

      {poems.length > 0 && (
        <div class="writing-section">
          <h2>Poems</h2>
          <div class="writings-list">
            {poems.map(poem => {
              const card = cardConfig.poems(poem);
              return (
                <a href={card.href} class="writing-item">
                  <span class="title">{card.title}</span>
                  {card.meta && <span class="meta">{card.meta}</span>}
                  {card.badge && <span class="badge">{card.badge}</span>}
                </a>
              );
            })}
          </div>
        </div>
      )}

      {stories.length > 0 && (
        <div class="writing-section">
          <h2>Short Stories</h2>
          <div class="writings-list">
            {stories.map(story => {
              const card = cardConfig["short-stories"](story);
              return (
                <a href={card.href} class="writing-item">
                  <span class="title">{card.title}</span>
                  {card.meta && <span class="meta">{card.meta}</span>}
                  {card.badge && <span class="badge">{card.badge}</span>}
                </a>
              );
            })}
          </div>
        </div>
      )}

      {reviews.length > 0 && (
        <div class="writing-section">
          <h2>Reviews</h2>
          <div class="writings-list">
            {reviews.map(review => {
              const card = cardConfig.reviews(review);
              return (
                <a href={card.href} class="writing-item">
                  <span class="title">{card.title}</span>
                  {card.meta && <span class="meta">{card.meta}</span>}
                  {card.badge && <span class="badge">{card.badge}</span>}
                </a>
              );
            })}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .breadcrumb {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color var(--transition-fast);
  }

  .breadcrumb:hover {
    color: var(--accent);
  }

  .section-intro {
    color: var(--text-secondary);
    font-size: var(--text-lg);
    margin-bottom: 3rem;
  }

  .writing-section {
    margin-bottom: 3rem;
  }

  .writing-section h2 {
    font-size: var(--text-base);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
  }

  .writings-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .writing-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-fast);
  }

  .writing-item:hover {
    border-color: var(--accent);
    background: var(--bg-secondary);
  }

  .writing-item .title {
    flex: 1;
    font-weight: 500;
  }

  .writing-item .meta {
    color: var(--text-muted);
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .writing-item .badge {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    background: var(--accent);
    color: var(--bg);
    border-radius: 0.25rem;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    white-space: nowrap;
  }
</style>
