---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { cardConfig } from '../../../collections.config';

const projects = await getCollection('projects');
const sorted = projects.sort((a, b) =>
  (b.data.updatedAt?.getTime() || 0) - (a.data.updatedAt?.getTime() || 0)
);
---

<BaseLayout title="Projects - wReady" description="Creative projects in development.">
  <section class="hub-detail">
    <div class="container">
      <a href="/writty" class="breadcrumb">← wReady</a>

      <h1>Projects</h1>
      <p class="section-intro">Screenplays, films, and books in active development.</p>

      <div class="projects-grid">
        {sorted.map(project => {
          const card = cardConfig.projects(project);
          return (
            <a href={card.href} class="project-card">
              <div class="project-header">
                <h2>{card.title}</h2>
                {card.badge && <span class="badge">{card.badge}</span>}
              </div>
              {card.subtitle && <p class="tagline">{card.subtitle}</p>}
              {card.meta && <p class="type">{card.meta}</p>}
            </a>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .breadcrumb {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color var(--transition-fast);
  }

  .breadcrumb:hover {
    color: var(--accent);
  }

  .section-intro {
    color: var(--text-secondary);
    font-size: var(--text-lg);
    margin-bottom: 3rem;
  }

  .projects-grid {
    display: grid;
    gap: 1.5rem;
  }

  .project-card {
    padding: 2rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-normal);
  }

  .project-card:hover {
    border-color: var(--accent);
    background: var(--bg-secondary);
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .project-card h2 {
    margin: 0;
    font-size: var(--text-lg);
  }

  .badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: var(--accent);
    color: var(--bg);
    border-radius: 0.25rem;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .tagline {
    margin: 0 0 0.5rem 0;
    font-style: italic;
    color: var(--text-secondary);
  }

  .type {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
</style>
