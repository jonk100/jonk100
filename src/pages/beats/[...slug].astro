---
import { getEntry, getCollection, render } from "astro:content";
import Layout from "../../layouts/BaseLayout.astro";
import type { CollectionEntry } from "astro:content";
import Screenplay from "../../components/screenplay/Screenplay.astro";
import Scene from "../../components/screenplay/Scene.astro";
import Action from "../../components/screenplay/Action.astro";
import Character from "../../components/screenplay/Character.astro";
import Dialogue from "../../components/screenplay/Dialogue.astro";
import Parenthetical from "../../components/screenplay/Parenthetical.astro";
import Transition from "../../components/screenplay/Transition.astro";
import ActBreak from "../../components/screenplay/ActBreak.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";

/**
 * Generate static paths for beat pages
 */
export async function getStaticPaths() {
  const beats = await getCollection("beats");

  return beats.map((beat) => {
    const slug = beat.id
      .replace("src/content/beats/", "")
      .replace(/\.(md|mdx)$/, "");

    return {
      params: { slug },
      props: { beat },
    };
  });
}

const { beat } = Astro.props;
const { Content, headings } = await render(beat);

// Extract project from beat data
const project = beat.data.project.id || 'unknown';

// Get project data for title
let projectTitle = project;
try {
  if (project) {
    const projectData = await getEntry(beat.data.project) as any;
    projectTitle = projectData?.data?.title || project;
  }
} catch (error) {
  // Use project slug as fallback
  console.warn(`Could not load project data for ${project}:`, error);
}

// Get scene data if beat references a scene
let sceneData = null;
let sceneTitle = '';
let episodeData = null;
if (beat.data.scene) {
  try {
    sceneData = await getEntry(beat.data.scene);
    sceneTitle = sceneData?.data?.title || 'Unknown Scene';
    
    // Also get episode data if scene has episode reference
    if (sceneData?.data?.episode) {
      episodeData = await getEntry(sceneData.data.episode);
    }
  } catch (error) {
    console.warn(`Could not load scene data:`, error);
  }
}

// Get plot data for all plots this beat affects
const plotData = await Promise.all(
  beat.data.plots.map(async (plotRef) => {
    try {
      // Handle nested plot reference structure
      const plotId = (plotRef as any)?.plot?.id || (plotRef as any)?.id;
      if (!plotId) {
        console.warn(`Invalid plot reference:`, plotRef);
        return null;
      }
      return await getEntry(plotId);
    } catch (error) {
      const plotId = (plotRef as any)?.plot?.id || (plotRef as any)?.id;
      console.warn(`Could not load plot data for ${plotId}:`, error);
      return null;
    }
  })
);

const validPlots = plotData.filter(plot => plot !== null);
---

<Layout title={`${beat.data.summary} - Beats`}>
  <div class="container">
    <Breadcrumb 
      items={[
        { label: projectTitle, href: `/projects/${project}` },
        { label: "Beats", href: `/projects/${project}/beats` },
        { label: `Beat ${(beat as any).beatNumber || 'Unknown'}` }
      ]} 
    />
    
    <div class="beat-header">
      <h1>Beat {(beat as any).beatNumber}: {beat.data.summary}</h1>
      
      <div class="beat-meta">
        {(beat as any).beatType && (
          <span class="beat-type">{(beat as any).beatType}</span>
        )}
        
        {beat.data.tension && (
          <span class="tension">Tension: {beat.data.tension}/10</span>
        )}
        
        {sceneData && (
          <span class="scene-link">
            Scene: <a href={`/scenes/${sceneData.id.replace('src/content/scenes/', '').replace(/\.(md|mdx)$/, '')}`}>
              {sceneTitle}
            </a>
          </span>
        )}
      </div>
    </div>

    <div class="beat-content">
      <div class="main-content">
        <div class="markdown">
          <Content
          components={{
            Screenplay,
            Scene,
            Action,
            Character,
            Dialogue,
            Parenthetical,
            Transition,
            ActBreak,
          }}
        />
        </div>
      </div>

      <aside class="sidebar">
        {validPlots.length > 0 && (
          <div class="info-card">
            <h3>Advances These Plots</h3>
            <ul class="plot-list">
              {validPlots.map((plot) => (
                <li>
                  <a href={`/plots/${(plot as any).id.replace('src/content/plots/', '').replace(/\.(md|mdx)$/, '')}`}>
                    {(plot as any).data?.title || 'Unknown Plot'}
                  </a>
                  <span class="plot-type">{(plot as any).data?.plotType}</span>
                  {(plot as any).data?.plotLevel && (
                    <span class="plot-level">Level {(plot as any).data.plotLevel}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )}
        
        {beat.data.themes && beat.data.themes.length > 0 && (
          <div class="info-card">
            <h3>Themes</h3>
            <ul>
              {beat.data.themes.map((theme) => (
                <li>{theme.id.replace('-', ' ')}</li>
              ))}
            </ul>
          </div>
        )}
        
        {sceneData && (
          <div class="info-card">
            <h3>Scene Context</h3>
            <p><strong>Scene:</strong> {sceneTitle}</p>
            {episodeData && (
              <p><strong>Episode:</strong> {episodeData.data.episodeNumber}</p>
            )}
            {sceneData.data.synopsis && (
              <p><strong>Synopsis:</strong> {sceneData.data.synopsis}</p>
            )}
          </div>
        )}
      </aside>
    </div>
  </div>
</Layout>

<style>
  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem;
  }

  .beat-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid #eee;
  }

  .beat-header h1 {
    margin: 0 0 1rem 0;
    font-size: 2.5rem;
    font-weight: 700;
  }

  .beat-meta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .beat-type,
  .tension,
  .scene-link {
    background: #f5f5f5;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .beat-type {
    background: #e8f5e8;
    color: #2e7d32;
  }

  .tension {
    background: #fff3e0;
    color: #e65100;
  }

  .scene-link {
    background: #e3f2fd;
    color: #1976d2;
  }

  .scene-link a {
    color: inherit;
    text-decoration: none;
  }

  .scene-link a:hover {
    text-decoration: underline;
  }

  .beat-content {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 3rem;
  }

  .main-content {
    min-width: 0;
  }

  .markdown {
    line-height: 1.7;
  }

  .markdown h1,
  .markdown h2,
  .markdown h3 {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .markdown h1 {
    font-size: 2rem;
    border-bottom: 1px solid #eee;
    padding-bottom: 0.5rem;
  }

  .markdown h2 {
    font-size: 1.5rem;
  }

  .markdown h3 {
    font-size: 1.25rem;
  }

  .markdown p {
    margin-bottom: 1rem;
  }

  .markdown ul,
  .markdown ol {
    margin-bottom: 1rem;
    padding-left: 2rem;
  }

  .markdown li {
    margin-bottom: 0.5rem;
  }

  .sidebar {
    position: sticky;
    top: 2rem;
    height: fit-content;
  }

  .info-card {
    background: #f9f9f9;
    border: 1px solid #eee;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .info-card h3 {
    margin: 0 0 1rem 0;
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #666;
  }

  .info-card p {
    margin: 0 0 0.5rem 0;
    font-size: 0.875rem;
  }

  .info-card ul {
    margin: 0;
    padding-left: 1.5rem;
    font-size: 0.875rem;
  }

  .plot-list {
    list-style: none;
    padding: 0;
  }

  .plot-list li {
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #eee;
  }

  .plot-list li:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .plot-list a {
    display: block;
    color: #333;
    text-decoration: none;
    font-weight: 500;
    margin-bottom: 0.25rem;
  }

  .plot-list a:hover {
    color: #1976d2;
  }

  .plot-type,
  .plot-level {
    display: inline-block;
    background: #f0f0f0;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 500;
    margin-right: 0.5rem;
  }

  .plot-type {
    background: #e8f5e8;
    color: #2e7d32;
  }

  .plot-level {
    background: #e3f2fd;
    color: #1976d2;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .beat-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .sidebar {
      position: static;
      order: -1;
    }

    .info-card {
      margin-bottom: 1rem;
    }
  }

  @media (max-width: 600px) {
    .container {
      padding: 1rem;
    }

    .beat-header h1 {
      font-size: 2rem;
    }

    .beat-meta {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
