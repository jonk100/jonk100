---
import type { ButtonProps } from "./button.props";
import { useButton } from "./button.hook";
import Icon from "~/assets/components/icon/Icon.astro";
import "../../trigger.css";
import "./button.css";

const { Tag, props } = useButton(Astro.props as ButtonProps);
const { icon } = Astro.props;
---

<Tag {...props}>
  {icon && <Icon name={icon} />}
  <slot />
</Tag>