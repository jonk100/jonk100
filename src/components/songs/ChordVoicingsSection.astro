---
import ChordDiagram from "./ChordDiagram.astro";

interface Props {
  chordVoicings: any[];
  chordMap: Map<string, any>;
}

const { chordVoicings, chordMap } = Astro.props;
---

{chordVoicings.length > 0 && (
  <details>
    <summary>
      <span class="summary-title">Chords Used</span>
    </summary>
    <section class="chord-voicings">
      <div class="chord-diagrams-grid">
        {chordVoicings.map((chordRef: any) => {
          // Resolve chord reference using our map
          const chord = chordMap.get(chordRef.id);
          
          if (chord && chord.data) {
            return (
              <div class="chord-diagram-wrapper">
                <ChordDiagram 
                  displayName={chord.data.displayName || chord.id}
                  voicingLabel={chord.data.voicingLabel}
                  baseFret={chord.data.baseFret}
                  fingering={chord.data.fingering}
                  frets={chord.data.frets}
                  barre={chord.data.barre}
                />
                <a href={`/chords/${chordRef.id}`} class="chord-link">
                  View Details →
                </a>
              </div>
            );
          } else {
            // Fallback for chords without proper data
            return (
              <div class="chord-diagram-wrapper">
                <a href={`/chords/${chordRef.id}`} class="chord-ref">
                  {chordRef.id}
                </a>
              </div>
            );
          }
        })}
      </div>
    </section>
  </details>
)}
</style>

<style>
  .summary-title {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--text-primary);
  }

  summary {
    cursor: pointer;
  }

  summary:hover .summary-title {
    color: var(--accent);
  }

  .chord-voicings {
    margin-bottom: var(--space-8);
  }

  .chord-voicings h2 {
    font-size: var(--text-2xl);
    font-weight: 700;
    margin: 0 0 var(--space-4) 0;
    color: var(--text-primary);
  }

  .chord-diagrams-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-6);
  }

  .chord-diagram-wrapper {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    text-align: center;
    transition: all var(--transition-fast);
  }

  .chord-diagram-wrapper:hover {
    border-color: var(--accent);
    background: var(--bg-card-hover);
  }

  .chord-link {
    display: inline-block;
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
  }

  .chord-link:hover {
    text-decoration: underline;
  }

  .chord-ref {
    display: block;
    padding: var(--space-3);
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 500;
  }

  .chord-ref:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .chord-diagrams-grid {
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: var(--space-4);
    }
  }
</style>
