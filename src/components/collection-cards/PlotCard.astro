---
/**
 * PlotCard.astro
 *
 * Renders a single plot card using BaseCard as foundation.
 * Works specifically with plot collection entries.
 */

import type { CollectionEntry } from "astro:content";
import BaseCard from "./BaseCard.astro";

interface Props {
  entry: CollectionEntry<"plots">;
}

const { entry } = Astro.props;
const { data } = entry;

// Build meta array for BaseCard
const meta: string[] = [];
meta.push(data.plotType);

if (data.parentPlot) {
  const parentName = data.parentPlot.id.split('/').pop();
  meta.push(`Subplot of ${parentName}`);
}

// Status color mapping for plot types
const plotTypeColorMap: Record<string, string> = {
  main: "var(--status-locked)",
  sub: "var(--status-progress)",
};

const badgeColor = plotTypeColorMap[data.plotType] ?? "var(--status-draft)";
---

<BaseCard
  href={`/plots/${entry.id}`}
  title={data.title}
  subtitle={data.summary}
  badge={data.plotType}
  badgeColor={badgeColor}
  meta={meta}
/>
