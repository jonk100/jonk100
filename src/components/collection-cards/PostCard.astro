---
import BaseCard from './BaseCard.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;

// Extract post data
const { title, excerpt, publishedAt, tags } = post.data;

// Format date for display
const formattedDate = publishedAt 
  ? new Date(publishedAt).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric'
    })
  : '';

// Create meta array for card
const meta = [formattedDate, ...tags.slice(0, 3)]; // Show date and first 3 tags

// Generate href for the post
// The post.id includes the relative path without extension, e.g. "2026-nfl-draft/top-wr-prospects"
const href = `/posts/${post.id}`;
---

<BaseCard
  href={href}
  title={title}
  subtitle={excerpt}
  meta={meta}
  badge={tags.length > 3 ? `+${tags.length - 3}` : undefined}
/>
