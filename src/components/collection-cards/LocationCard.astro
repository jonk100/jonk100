---
/**
 * LocationCard.astro
 *
 * Renders a single location card using BaseCard as foundation.
 * Works specifically with location collection entries.
 */

import type { CollectionEntry } from "astro:content";
import BaseCard from "./BaseCard.astro";

interface Props {
  entry: CollectionEntry<"locations">;
}

const { entry } = Astro.props;
const { data } = entry;

// Build meta array for BaseCard
const meta: string[] = [];
if (data.intOrExt) {
  meta.push(data.intOrExt);
}

if (data.realWorldRef) {
  meta.push(data.realWorldRef);
}

// Status color mapping for location types
const locationTypeColorMap: Record<string, string> = {
  INT: "var(--status-draft)",
  EXT: "var(--status-progress)",
  "INT/EXT": "var(--status-complete)",
};

const badgeColor = data.intOrExt ? (locationTypeColorMap[data.intOrExt] ?? "var(--status-draft)") : undefined;
---

<BaseCard
  href={`/locations/${entry.id}`}
  title={data.name}
  badge={data.intOrExt}
  badgeColor={badgeColor}
  meta={meta}
/>
