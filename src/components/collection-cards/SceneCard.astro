---
/**
 * SceneCard.astro
 *
 * Renders a single scene card using BaseCard as foundation.
 * Works specifically with scene collection entries.
 */

import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";
import BaseCard from "./BaseCard.astro";

interface Props {
  entry: CollectionEntry<"scenes">;
}

const { entry } = Astro.props;
const { data } = entry;

// Resolve location names
const locationNames: string[] = [];
if (data.location && Array.isArray(data.location)) {
  for (const locationRef of data.location) {
    // Extract name from the reference path
    const refString = typeof locationRef === 'string' ? locationRef : locationRef.id;
    const nameFromPath = refString.split('/').pop()?.replace(/-/g, ' ');
    if (nameFromPath) {
      locationNames.push(nameFromPath);
    }
  }
}

// Build meta array for BaseCard
const meta: string[] = [];
meta.push(data.intOrExt);
meta.push(data.timeOfDay);

// Add episode information to meta for filtering
if (data.episode) {
  const episodeRef = typeof data.episode === 'string' ? data.episode : data.episode.id;
  const episodeMatch = episodeRef.match(/episode-(\d+)/i);
  const episodeNumber = episodeMatch ? `Episode ${episodeMatch[1]}` : 'Unknown';
  meta.push(episodeNumber);
}

// Add resolved location names if available
if (locationNames.length > 0) {
  meta.push(locationNames.join(', '));
}

if (data.sceneNumber) {
  meta.push(`Scene ${data.sceneNumber}`);
}

if (data.pageCount) {
  meta.push(`${data.pageCount} pages`);
}

// Build character list for footer
const characterNames = data.characters.slice(0, 3).map(char => char.id.split('/').pop()).join(', ');
const moreCharacters = data.characters.length > 3 ? ` +${data.characters.length - 3}` : '';
const characterList = characterNames + moreCharacters;

// Status color mapping
const statusColorMap: Record<string, string> = {
  outline: "var(--status-draft)",
  "first-draft": "var(--status-progress)",
  revised: "var(--status-progress)",
  locked: "var(--status-complete)",
};

const badgeColor = data.status ? (statusColorMap[data.status] ?? "var(--status-draft)") : undefined;
---

<BaseCard
  href={`/scenes/${entry.id}`}
  title={`Scene ${data.sceneNumber} - ${data.title}`}
  subtitle={data.synopsis}
  badge={data.status}
  badgeColor={badgeColor}
  meta={meta}
  footer={data.characters.length > 0 ? characterList : undefined}
/>
