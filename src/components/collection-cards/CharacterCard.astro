---
/**
 * CharacterCard.astro
 *
 * Renders a single character card using BaseCard as foundation.
 * Works specifically with character collection entries.
 */

import type { CollectionEntry } from "astro:content";
import BaseCard from "./BaseCard.astro";

interface Props {
  entry: CollectionEntry<"characters">;
}

const { entry } = Astro.props;
const { data } = entry;

// Build meta array for BaseCard
const meta: string[] = [];
if (data.role) {
  meta.push(data.role);
}

if (data.themes && data.themes.length > 0) {
  const themeNames = data.themes.slice(0, 2).map(theme => theme.id.replace('-', ' '));
  meta.push(themeNames.join(', '));
}

// Build footer text
const footer = data.arc ? `Arc: ${data.arc.substring(0, 50)}${data.arc.length > 50 ? '...' : ''}` : undefined;
---

<BaseCard
  href={`/characters/${entry.id}`}
  title={data.name}
  subtitle={data.role}
  meta={meta}
  footer={footer}
/>
