---
/**
 * BeatCard.astro
 *
 * Renders a single beat card using BaseCard as foundation.
 * Works specifically with beat collection entries.
 */

import type { CollectionEntry } from "astro:content";
import BaseCard from "./BaseCard.astro";

interface Props {
  entry: CollectionEntry<"beats">;
  showPlots?: boolean;
}

const { entry, showPlots = true } = Astro.props;
const { data } = entry;

// Build meta array for BaseCard
const meta: string[] = [];

// Get beat number from first plot if available
const beatNumber = data.plots && data.plots.length > 0 ? data.plots[0].beatNumber : undefined;
if (beatNumber) {
  meta.push(`Beat ${beatNumber}`);
}

if (data.beatType) {
  meta.push(data.beatType);
}

if (data.tension) {
  meta.push(`Tension: ${data.tension}/10`);
}

// Get plot names (handle multiple plots)
const plotNames = data.plots && data.plots.length > 0 
  ? data.plots.map((plot) => plot.plot.id.split('/').pop()).join(', ')
  : 'No plots assigned';

// Status color mapping for beat types
const beatTypeColorMap: Record<string, string> = {
  setup: "var(--status-draft)",
  turn: "var(--status-progress)",
  payoff: "var(--status-complete)",
  revelation: "var(--accent)",
  decision: "var(--status-locked)",
};

const badgeColor = data.beatType ? (beatTypeColorMap[data.beatType] ?? "var(--status-draft)") : undefined;
---

<BaseCard
  href={`/beats/${entry.id}`}
  title={data.summary}
  badge={data.beatType}
  badgeColor={badgeColor}
  meta={meta}
  footer={showPlots ? plotNames : undefined}
/>
