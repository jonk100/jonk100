---
/**
 * src/components/ui/controls/ToggleButton.astro
 * Binary state button using aria-pressed.
 * - Uses global .variant--* classes for theme styling
 * - Supports size and theme props from design system
 * @props (local): id, label, icon, pressed, theme, size
 * @props (global): class, class:list
 * - pressed: Current pressed state (controlled)
 * - theme: Visual style theme aligning with design system themes
 * - size: Button size from design system scale
 */
import Icon from '../primitives/Icon.astro';
import type { ComponentTheme, Sizes } from 'src/types/variants.types';

export interface Props {
  id?: string;
  label?: string;
  icon?: string;
  pressed?: boolean;
  theme?: ComponentTheme;
  size?: Sizes;
  class?: string;
  "class:list"?: any;
  [key: string]: any;
}

const {
  id,
  label,
  icon,
  pressed = false,
  theme = 'default',
  size = 'base',
  class: className = '',
  "class:list": classList = {},
  ...rest
} = Astro.props;
---
<button
  type="button"
  id={id}
  class:list={['control', `variant--${theme}`, `control--${size}`, { 'control--pressed': pressed }, className, classList]}
  aria-pressed={pressed ? "true" : "false"}
  onclick="this.setAttribute('aria-pressed', this.getAttribute('aria-pressed') === 'true' ? 'false' : 'true')"
  {...rest}
>
  {icon && <Icon name={icon} size="sm" />}
  {label && <span>{label}</span>}
  <slot />
</button>

<style>
  .control--pressed {
    opacity: 0.8;
  }
</style>
