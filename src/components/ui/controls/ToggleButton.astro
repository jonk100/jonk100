---
/**
 * src/components/ui/controls/ToggleButton.astro
 * Binary state button using aria-pressed.
 */
import Icon from '../primitives/Icon.astro';

export interface Props {
  id?: string;
  label?: string;
  icon?: string;
  pressed?: boolean;
  class?: string;
  "class:list"?: any;
  [key: string]: any;
}

const {
  id,
  label,
  icon,
  pressed = false,
  class: className = '',
  "class:list": classList = {},
  ...rest
} = Astro.props;
---
<button
  type="button"
  id={id}
  class:list={['toggle-btn', className, classList]}
  aria-pressed={pressed ? "true" : "false"}
  onclick="this.setAttribute('aria-pressed', this.getAttribute('aria-pressed') === 'true' ? 'false' : 'true')"
  {...rest}
>
  {icon && <Icon name={icon} size="sm" />}
  {label && <span>{label}</span>}
  <slot />
</button>

<style>
  .toggle-btn {
    display: inline-flex; align-items: center; gap: var(--space-2);
    padding: 0 var(--space-4); height: 2.25rem; border-radius: var(--rad-md);
    border: 1px solid var(--border); background: transparent;
    cursor: pointer; font-size: var(--text-sm); color: var(--text-subtle);
    font-family: var(--sans); transition: all 0.15s ease;
    font-weight: 500;
  }
  
  .toggle-btn[aria-pressed="true"] {
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    color: var(--accent);
  }
  
  .toggle-btn:hover:not([aria-pressed="true"]) { 
    background: var(--surface-1); 
    color: var(--text); 
    border-color: var(--border-strong);
  }

  .toggle-btn:active {
    transform: scale(0.97);
  }

  .toggle-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
