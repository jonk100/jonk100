---
/**
 * src/components/ui/controls/TabPanel.astro
 * A container for content associated with a specific tab.
 * @props (local): id
 * @props (global): class, class:list
 */
export interface Props {
  id: string;
  class?: string;
  "class:list"?: Record<string, boolean> | any[];
  [key: string]: any;
}

const {
  id,
  class: className = '',
  "class:list": classList = {},
  ...rest
} = Astro.props;
---

<div
  id={id}
  role="tabpanel"
  tabindex="0"
  data-state="inactive"
  class:list={['tab-panel', className, classList]}
  {...rest}
>
  <slot />
</div>

<style>
  .tab-panel {
    display: none;
    width: 100%;
    outline: none;
  }

  .tab-panel[data-state="active"] {
    display: block;
    animation: fade-in 0.3s ease-out;
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
