---
/**
 * src/components/ui/controls/Button.astro
 * Base button component with variant + size system.
 * - Delegates class merging to Astro's native class:list system
 * - Supports rendering as <button>, <a>, or <div> based on props
 * - Leverages variant theme styling in src/styles/variants/themes.css and sizes in typography.css
 * @props (local): href, theme, tone, size, as, type, animate, loading
 * @props (global): class, class:list, frame, effects
 * - theme: Visual style theme ('primary', 'secondary', etc.)
 * - tone: Specifies text color
 * - size: Button dimensions ('base', 'sm', 'lg', etc.)
 * - as: HTML tag to render
 * - animate: Optional animation choice ('pulse', 'float', etc. defined in src/styles/variants/animations.css)
 * - loading: If true, disables the button and displays a centered Spinner
 */
import type { ComponentTheme, TextTone, Sizes, FrameVariant, AnimationType } from 'src/types/variants.types';
import Text from '../typography/Text.astro';
import Spinner from '../feedback/Spinner.astro';

type ElementTag = "button" | "a" | "div";

export interface Props {
  href?: string;
  label?: string;
  theme?: ComponentTheme;
  tone?: TextTone;
  size?: Sizes;
  frame?: FrameVariant;
  as?: ElementTag;
  type?: "button" | "submit" | "reset";
  animate?: AnimationType;
  loading?: boolean;
  class?: string;
  "class:list"?: Record<string, boolean> | any[];
  [key: string]: any;
}

const {
  href,
  label,
  theme = "default",
  tone,
  size = "base",
  frame = "none",
  as,
  type = "button",
  animate = "none",
  loading = false,
  class: cls = "",
  "class:list": classList = {},
  ...rest
} = Astro.props;

const Tag = as || (href ? "a" : "button");

const classes = [
  "control", 
  `variant--${theme}`, 
  tone ? `text--${tone}` : '',
  `control--${size}`, 
  frame !== 'none' ? `frame-variant--${frame}` : '',
  animate !== 'none' ? `animate-${animate}` : '',
  { "control--loading": loading },
  cls
];

const tagProps =
  Tag === "button"
    ? { type, disabled: loading, ...rest }
    : { href: loading ? undefined : href, ...rest };

const currentColor = tone ? `var(--text-${tone})` : `var(--text-subtle)`;
---

<Tag class:list={[classes, classList]} {...tagProps}>
  <div class="control-content">
    {label ? <Text as="span" type="label" tone={tone}>{label}</Text> : <slot />}
  </div>
  {loading && (
    <div class="control-loader" data-testid="control-loader">
      <Spinner size={size} tone={currentColor} />
    </div>
  )}
</Tag>

<style>
  /* See src/styles/variants/themes.css for theme-based styles */
  .control {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--sans);
    letter-spacing: 0.03em;
    font-size: var(--text-sm);
    transition: all 0.25s ease;
    cursor: pointer;
    border: 1px solid transparent;
    position: relative;
    overflow: hidden;
  }

  .control--loading {
    cursor: wait;
    pointer-events: none;
  }

  .control--loading .control-content {
    opacity: 0;
  }

  .control-loader {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :where(.control):hover {
    border-color: var(--border-strong);
    color: var(--surface-5);
  }

  /* Defensive override for MDX-compiled child paragraph tags */
  .control :global(p) {
    margin: 0 !important;
    padding: 0 !important;
    color: inherit !important;
    display: inline !important;
    font-size: inherit !important;
    font-family: inherit !important;
    font-weight: inherit !important;
    line-height: inherit !important;
  }
</style>
