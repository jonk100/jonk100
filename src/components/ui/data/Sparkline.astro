---
// src/components/ui/data/Sparkline.astro
/**
 * A tiny inline chart (Sparkline).
 * Renders a simple SVG path based on an array of numbers.
 */
import Box from "../layout/Box.astro";

export interface Props {
  data: number[];
  width?: number;
  height?: number;
  strokeWidth?: number;
  strokeColor?: string;
  fill?: boolean;
  fillColor?: string;
  class?: string;
  "class:list"?: Record<string, boolean> | any[];
}
const {
  data = [],
  width = 100,
  height = 30,
  strokeWidth = 2,
  strokeColor = "var(--accent)",
  fill = false,
  fillColor = "color-mix(in srgb, var(--accent) 20%, transparent)",
  class: className = "",
  "class:list": classList = {}
} = Astro.props;

let pathD = "";
let fillPathD = "";

if (data.length > 1) {
  const max = Math.max(...data);
  const min = Math.min(...data);
  const range = max - min || 1; // avoid division by zero
  
  const stepX = width / (data.length - 1);
  const points = data.map((val, i) => {
    const x = i * stepX;
    // Padding to avoid clipping stroke
    const y = strokeWidth + ((max - val) / range) * (height - strokeWidth * 2);
    return `${x},${y}`;
  });
  
  pathD = `M ${points.join(" L ")}`;
  fillPathD = `${pathD} L ${width},${height} L 0,${height} Z`;
}
---
<Box as="span" display="inline-block" class:list={["sparkline", className, classList]}>
  {data.length > 1 ? (
    <svg width={width} height={height} viewBox={`0 0 ${width} ${height}`} class="sparkline-svg">
      {fill && <path d={fillPathD} fill={fillColor} stroke="none" />}
      <path d={pathD} fill="none" stroke={strokeColor} stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  ) : (
    <span class="sparkline-empty">No data</span>
  )}
</Box>

<style>
  .sparkline {
    vertical-align: middle;
  }
  .sparkline-svg {
    display: block;
    overflow: visible; /* so stroke doesn't clip badly */
  }
  .sparkline-empty {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
</style>
