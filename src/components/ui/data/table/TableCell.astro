---
/**
 * src/components/ui/data/TableCell.astro
 * A standard data cell within a table.
 * @props (local): align
 * @props (global): class, class:list
 */
export interface Props {
  align?: 'left' | 'center' | 'right';
  class?: string;
  "class:list"?: Record<string, boolean> | any[];
  [key: string]: any;
}

const {
  align = 'left',
  class: className = '',
  "class:list": classList = {},
  ...rest
} = Astro.props;
---

<td class:list={['table-cell', `text-${align}`, className, classList]} {...rest}>
  <slot />
</td>

<style>
  .table-cell {
    padding: var(--space-3) var(--space-4);
    color: var(--text);
    vertical-align: middle;
  }

  .text-left { text-align: left; }
  .text-center { text-align: center; }
  .text-right { text-align: right; }
</style>
