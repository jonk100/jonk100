---
/**
 * src/components/ui/feedback/Badge.astro
 * Provides a small label or status indicator for inline items.
 * - Supports multiple predefined variants and sizes using global design system
 * - Offers an outlined style option for lighter visuals
 * - Uses global .variant--* classes for theme styling
 * @props (local): theme, size, outlined
 * @props (global): class, class:list, frame, effects
 * - theme: Visual style theme aligning with design system themes
 * - size: Size scaling of the badge
 * - outlined: Removes background for lighter visual style
 */
import type { ComponentTheme, Sizes, FrameVariant, ComponentEffect as ImageEffect, ComponentRadius } from '/src/types/variants.types';

export interface Props {
  theme?: ComponentTheme;
  size?: Sizes;
  outlined?: boolean;
  frame?: FrameVariant;
  effects?: ImageEffect | ImageEffect[];
  class?: string;
  "class:list"?: Record<string, boolean> | any[];
  [key: string]: any;
}

const {
  theme = 'secondary',
  size = 'sm',
  outlined = false,
  frame = 'none',
  effects = [],
  class: className = '',
  "class:list": classList = {},
  ...rest
} = Astro.props;
---

<span
  class:list={[
    'badge',
    `variant--${theme}`,
    `control--${size}`,
    { 'badge--outlined': outlined },
    frame !== 'none' ? `frame-variant--${frame}` : '',
    ...([effects].flat().filter(Boolean).map(e => `effect--${e}`)),
    className,
    classList
  ]}
  {...rest}
>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--rad-full);
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    border: 1px solid transparent; /* default */
    width: fit-content;
  }

  .badge--outlined {
    background: transparent !important;
    border: 1px solid currentColor;
  }
</style>
