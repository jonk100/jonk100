---
/**
 * src/components/ui/feedback/Chip.astro
 * Interactive Tag variant, dismissible, selectable state.
 * - Uses global .variant--* classes for theme styling
 * - Supports size and theme props from design system
 * @props (local): label, value, selected, dismissible, icon, theme, size
 * @props (global): class, class:list
 * - selected: Current selected state (controlled)
 * - dismissible: Shows a dismiss button to remove the chip
 * - theme: Visual style theme aligning with design system themes
 * - size: Chip size from design system scale
 */
import Icon from '../primitives/Icon.astro';
import type { ComponentTheme, Sizes } from 'src/types/variants.types';

export interface Props {
  label: string;
  value?: string;
  selected?: boolean;
  dismissible?: boolean;
  icon?: string;
  theme?: ComponentTheme;
  size?: Sizes;
  class?: string;
  "class:list"?: any;
  [key: string]: any;
}

const {
  label,
  value,
  selected = false,
  dismissible = false,
  icon,
  theme = 'default',
  size = 'sm',
  class: className = '',
  "class:list": classList = {},
  ...rest
} = Astro.props;
---
<button
  type="button"
  class:list={['control', `variant--${theme}`, `control--${size}`, { 'control--selected': selected }, className, classList]}
  role="option"
  aria-selected={selected ? "true" : "false"}
  data-value={value || label}
  onclick="if(!event.target.closest('.chip-dismiss')){this.classList.toggle('control--selected'); this.setAttribute('aria-selected', this.classList.contains('control--selected'));}"
  {...rest}
>
  {icon && <Icon name={icon} size="sm" class="chip-icon" />}
  <span>{label}</span>
  {dismissible && (
    <span
      class="chip-dismiss"
      aria-label={`Remove ${label}`}
      onclick="event.stopPropagation(); this.parentElement.remove();"
    >
      &times;
    </span>
  )}
</button>

<style>
  .chip-icon { opacity: 0.8; }

  .control--selected {
    opacity: 0.8;
  }

  .chip-dismiss {
    font-size: 16px; margin-left: 2px; opacity: 0.6;
    line-height: 1; margin-top: -1px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 50%; width: 18px; height: 18px;
  }
  .chip-dismiss:hover { opacity: 1; }
  .chip-dismiss:hover { background: rgba(0,0,0,0.1); color: var(--text-danger); }
</style>
