---
/**
 * src/components/ui/feedback/Tag.astro
 * Non-interactive semantic label with optional dot or icon.
 */
import Icon from '../primitives/Icon.astro';
import type { ComponentTheme } from 'src/types/variants.types';

export interface Props {
  label: string;
  theme?: ComponentTheme;
  dot?: boolean;
  icon?: string;
  class?: string;
  "class:list"?: any;
  [key: string]: any;
}

const {
  label,
  theme = 'default',
  dot = false,
  icon,
  class: className = '',
  "class:list": classList = {},
  ...rest
} = Astro.props;
---
<span class:list={['tag', `tag--${theme}`, className, classList]} {...rest}>
  {dot && <span class="tag-dot"></span>}
  {icon && <Icon name={icon} size="sm" class="tag-icon" />}
  {label}
</span>

<style>
  .tag {
    display: inline-flex; align-items: center; gap: var(--space-1);
    padding: 2px var(--space-3); border-radius: var(--rad-full); 
    font-size: var(--text-xs); font-weight: 500;
    letter-spacing: 0.01em; border: 1px solid transparent;
    line-height: 1.5; white-space: nowrap; width: fit-content;
  }
  
  .tag-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
  .tag-icon { opacity: 0.8; }

  /* Theme Variants */
  .tag--default { 
    background: var(--surface-2); border-color: var(--border); color: var(--text-subtle); 
  }
  .tag--default .tag-dot { background: var(--text-muted); }
  
  .tag--primary { 
    background: color-mix(in srgb, var(--primary) 12%, transparent); 
    border-color: color-mix(in srgb, var(--primary) 35%, transparent); 
    color: var(--primary); 
  }
  .tag--primary .tag-dot { background: var(--primary); }

  .tag--accent { 
    background: color-mix(in srgb, var(--accent) 12%, transparent); 
    border-color: color-mix(in srgb, var(--accent) 35%, transparent); 
    color: var(--accent); 
  }
  .tag--accent .tag-dot { background: var(--accent); }

  .tag--success { 
    background: color-mix(in srgb, var(--text-success) 12%, transparent); 
    border-color: color-mix(in srgb, var(--text-success) 35%, transparent); 
    color: var(--text-success); 
  }
  .tag--success .tag-dot { background: var(--text-success); }

  .tag--warning { 
    background: color-mix(in srgb, var(--text-warning) 12%, transparent); 
    border-color: color-mix(in srgb, var(--text-warning) 35%, transparent); 
    color: var(--text-warning); 
  }
  .tag--warning .tag-dot { background: var(--text-warning); }

  .tag--danger { 
    background: color-mix(in srgb, var(--text-danger) 12%, transparent); 
    border-color: color-mix(in srgb, var(--text-danger) 35%, transparent); 
    color: var(--text-danger); 
  }
  .tag--danger .tag-dot { background: var(--text-danger); }
</style>
