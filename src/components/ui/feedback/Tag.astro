---
/**
 * src/components/ui/feedback/Tag.astro
 * Non-interactive semantic label with optional dot or icon.
 * - Uses global .variant--* classes for theme styling
 * @props (local): label, theme, dot, icon
 * @props (global): class, class:list
 * - theme: Visual style theme aligning with design system themes
 * - dot: Shows a colored dot indicator before the label
 * - icon: Displays an icon before the label
 */
import Icon from '../primitives/Icon.astro';
import type { ComponentTheme } from 'src/types/variants.types';

export interface Props {
  label: string;
  theme?: ComponentTheme;
  dot?: boolean;
  icon?: string;
  class?: string;
  "class:list"?: any;
  [key: string]: any;
}

const {
  label,
  theme = 'default',
  dot = false,
  icon,
  class: className = '',
  "class:list": classList = {},
  ...rest
} = Astro.props;
---
<span class:list={['tag', `variant--${theme}`, className, classList]} {...rest}>
  {dot && <span class="tag-dot"></span>}
  {icon && <Icon name={icon} size="sm" class="tag-icon" />}
  {label}
</span>

<style>
  .tag {
    display: inline-flex; align-items: center; gap: var(--space-1);
    padding: 2px var(--space-3); border-radius: var(--rad-full);
    font-size: var(--text-xs); font-weight: 500;
    letter-spacing: 0.01em; border: 1px solid transparent;
    line-height: 1.5; white-space: nowrap; width: fit-content;
  }

  .tag-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
  .tag-icon { opacity: 0.8; }
</style>
