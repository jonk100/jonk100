---
/**
 * src/components/ui/feedback/Spinner.astro
 * Displays a rotating SVG spinner to indicate loading states.
 * - Configurable size, rotation speed, and color tones.
 * - Pure SVG implementation without external dependencies.
 * @props (local): size, speed, tone
 * @props (global): class, class:list
 * - size: Predefined size preset ('sm', 'md', 'lg', 'xl') or custom dimension.
 * - speed: Rotation animation speed preset ('fast', 'normal', 'slow').
 * - tone: Color variant of the spinner head matching theme colors.
 */
export interface Props {
  size?: 'sm' | 'md' | 'lg' | 'xl' | string;
  speed?: 'fast' | 'normal' | 'slow';
  tone?: 'primary' | 'secondary' | 'accent' | 'text' | 'muted';
  class?: string;
  "class:list"?: Record<string, boolean> | any[];
  [key: string]: any;
}

const {
  size = 'md',
  speed = 'normal',
  tone = 'primary',
  class: className = '',
  "class:list": classList = {},
  ...rest
} = Astro.props;

const sizeMap: Record<string, string> = {
  sm: '16px',
  md: '24px',
  lg: '32px',
  xl: '48px'
};

const dimension = sizeMap[size] || size;
---

<svg
  class:list={[
    'spinner',
    `spinner--${speed}`,
    `spinner--tone-${tone}`,
    className,
    classList
  ]}
  width={dimension}
  height={dimension}
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  {...rest}
>
  <circle
    class="spinner-track"
    cx="12"
    cy="12"
    r="10"
    stroke="currentColor"
    stroke-width="3"
  />
  <circle
    class="spinner-head"
    cx="12"
    cy="12"
    r="10"
    stroke="currentColor"
    stroke-width="3"
    stroke-linecap="round"
  />
</svg>

<style>
  .spinner {
    animation: spinner-rotate var(--speed, 1s) linear infinite;
  }
  
  .spinner--fast { --speed: 0.6s; }
  .spinner--normal { --speed: 1s; }
  .spinner--slow { --speed: 1.5s; }
  
  .spinner--tone-primary { color: var(--primary); }
  .spinner--tone-secondary { color: var(--secondary); }
  .spinner--tone-accent { color: var(--accent); }
  .spinner--tone-text { color: var(--text); }
  .spinner--tone-muted { color: var(--text-muted); }

  .spinner-track {
    opacity: 0.2;
  }
  
  .spinner-head {
    stroke-dasharray: 45;
    stroke-dashoffset: 15;
  }

  @keyframes spinner-rotate {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
</style>
