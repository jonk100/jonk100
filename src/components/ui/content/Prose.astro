---
/**
 * Prose component props.
 *
 * Provides typography styling for arbitrary rich content
 * such as Markdown, MDX, CMS content, articles, and docs.
 */

export interface ProseProps {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['prose', className]}>
  <slot />
</div>

<style>
  /**
 * Prose
 *
 * Rich text styling for Markdown and MDX content.
 */

.prose {
  width: 100%;
}

/* -------------------------------------------------- */
/* Headings                                            */
/* -------------------------------------------------- */

.prose h2 {
  font-family: var(--display);
  font-size: var(--text-3xl);
  font-weight: 400;
  line-height: 1.2;
  margin: var(--space-12) 0 var(--space-6);
}

.prose h3 {
  font-family: var(--display);
  font-size: var(--text-2xl);
  font-weight: 400;
  line-height: 1.3;
  margin: var(--space-10) 0 var(--space-4);
}

/* -------------------------------------------------- */
/* Paragraphs                                          */
/* -------------------------------------------------- */

.prose p {
  color: var(--text-subtle);
  font-size: var(--text-lg);
  line-height: 1.8;
  margin-bottom: var(--space-6);
}

/* -------------------------------------------------- */
/* Lists                                               */
/* -------------------------------------------------- */

.prose ul {
  list-style: disc;
  padding-left: var(--space-6);
  margin-bottom: var(--space-6);
}

.prose ol {
  list-style: decimal;
  padding-left: var(--space-6);
  margin-bottom: var(--space-6);
}

.prose li {
  font-size: var(--text-lg);
  line-height: 1.8;
  margin-bottom: var(--space-2);
}

/* -------------------------------------------------- */
/* Inline                                              */
/* -------------------------------------------------- */

.prose strong {
  color: var(--text);
  font-weight: 600;
}

.prose a {
  color: var(--accent);
}

.prose code:not(pre code) {
  font-family: var(--mono);
}
</style>