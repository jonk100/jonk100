---
/**
 * src/components/ui/layout/LinkGroup.astro
 * Physically attaches multiple links together into a single segmented control.
 * @props (local): None
 * @props (global): class, class:list
 */
export interface Props {
  bg?: string;
  tone?: string;
  gap?: string;
  class?: string;
  "class:list"?: Record<string, boolean> | any[];
  [key: string]: any;
}

const {
  bg = 'surface-1',
  tone = 'accent',
  gap = 'none',
  class: className = '',
  "class:list": classList = {},
  style = '',
  ...rest
} = Astro.props;

const internalStyle = gap !== 'none' ? `gap: var(--space-${gap === 'lg' ? '6' : gap === 'md' ? '4' : gap === 'sm' ? '2' : '0'});` : '';
const combinedStyle = [internalStyle, typeof style === 'string' ? style : Object.entries(style || {}).map(([k, v]) => `${k}:${v}`).join(';')].filter(Boolean).join(';');
---

<div class:list={[
  'link-group',
  `text-${tone}`, 
  `background--${bg}`,
  className, 
  classList
  ]} 
  style={combinedStyle}
  {...rest}
>
  <slot />
</div>

<style>
  .link-group {
    display: inline-flex;
    align-items: center;
    border-radius: var(--rad-md);
    overflow: hidden;
  }

  /* Target the actual link elements */
  .link-group :global(> .custom-link),
  .link-group :global(> a) {
    border-radius: 0;
    /* Override the padding: 0 !important from Link.astro */
    padding: var(--space-2) var(--space-4) !important;
    text-decoration: none !important;
  }

  /* Restore outer border radii if NO gap */
  .link-group:not([style*="gap"]) :global(> *:first-child) {
    border-top-left-radius: var(--rad-md);
    border-bottom-left-radius: var(--rad-md);
  }

  .link-group:not([style*="gap"]) :global(> *:last-child) {
    border-top-right-radius: var(--rad-md);
    border-bottom-right-radius: var(--rad-md);
  }

  /* Add subtle separation lines between items if NO gap */
  .link-group:not([style*="gap"]) :global(> *:not(:last-child)) {
    border-right: 1px solid var(--border-subtle);
  }
</style>
