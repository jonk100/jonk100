---
/**
 * src/components/ui/layout/LinkGroup.astro
 * Physically attaches multiple links together into a single segmented control.
 * @props (local): None
 * @props (global): class, class:list
 */
export interface Props {
  bg?: string;
  tone?: string;
  gap?: string;
  class?: string;
  "class:list"?: Record<string, boolean> | any[];
  [key: string]: any;
}

const {
  bg = 'surface-1',
  tone = 'accent',
  gap = 'lg',
  class: className = '',
  "class:list": classList = {},
  ...rest
} = Astro.props;
---

<div class:list={[
  'link-group',
  `text-${tone}`, 
  `control--gap-${gap}`,
  `background--${bg}`,
  className, 
  classList
  ]} {...rest}
>
  <slot />
</div>

<style>
  .link-group {
    display: inline-flex;
    border-radius: var(--rad-md);
  }

  .link-group :global(> .control),
  .link-group :global(> a) {
    border-radius: 0;
  }

  .link-group :global(> *:first-child) {
    border-top-left-radius: var(--rad-md);
    border-bottom-left-radius: var(--rad-md);
  }

  .link-group :global(> *:last-child) {
    border-top-right-radius: var(--rad-md);
    border-bottom-right-radius: var(--rad-md);
  }

  .link-group :global(> *:not(:last-child)) {
    border-right: 1px solid var(--border-subtle);
  }
</style>
