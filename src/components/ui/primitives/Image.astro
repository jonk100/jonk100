---
/**
 * src/components/ui/primitives/Image.astro
 * An advanced image component with loading skeletons and fallback support.
 * - Displays a shimmer effect while the image is loading
 * - Replaces broken image sources with a provided fallback or a transparent pixel
 * - Centralized RGB variables from colors-rgb.css mapped for translucent overlays
 * @props (local): src, alt, shape, fallbackSrc, position
 * @props (global): class, class:list, frame, effects
 * - shape: Determines the crop shape of the image container
 * - fallbackSrc: Image source to display if the primary src fails to load
 * - effects: Applies visual effects from predefined ImageEffect types
 * - frame: Applies a decorative frame variant styling
 * - position: Adjusts the object-position CSS property
 * - fit: Sets the object-fit property (cover, contain, etc)
 * - zoomable: Enables a lightbox on click (defaults to true if fit="cover")
 */
import type { HTMLAttributes } from 'astro/types';
import type { ComponentShape, ComponentRadius, FrameVariant, ComponentEffect } from '/src/types/variants.types';

export interface Props extends HTMLAttributes<'img'> {
  src: string;
  alt: string;
  shape?: ComponentShape;
  radius?: ComponentRadius;
  fallbackSrc?: string;
  effects?: ComponentEffect | ComponentEffect[];
  loading?: 'eager' | 'lazy';
  frame?: FrameVariant;
  position?: string;
  fit?: 'cover' | 'contain' | 'fill' | 'none';
  height?: string;
  zoomable?: boolean;
  caption?: string;
  captionPosition?: 'top' | 'bottom' | 'o-top' | 'o-bottom';
  captionAlign?: 'left' | 'center' | 'right';
  class?: string;
  style?: string | Record<string, any>;
  "class:list"?: Record<string, boolean> | any[];
}

const {
  src,
  alt,
  shape = 'landscape',
  radius,
  loading = 'lazy',
  fallbackSrc,
  effects = [],
  frame = 'none',
  position = 'center',
  fit = 'cover',
  height,
  zoomable,
  caption,
  captionPosition = 'bottom',
  captionAlign = 'center',
  class: className = '',
  style = '',
  "class:list": classList = {},
  ...rest
} = Astro.props;

// Normalize effects to an array
const effectsArray = Array.isArray(effects) ? effects : [effects];
const effectClasses = effectsArray.map(e => `effect--${e}`);

// Add frame class if applicable
const frameClass = frame !== 'none' ? `frame-variant--${frame}` : '';

// Use a tiny 1x1 transparent PNG or the provided fallback if the main image fails
const errorFallback = fallbackSrc || 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';

const isZoomable = zoomable ?? (fit === 'cover');
const imageId = rest.id || `img-${Math.random().toString(36).substring(2, 9)}`;
const onLoadScript = isZoomable 
  ? "this.parentElement.previousElementSibling.style.opacity = '0'" 
  : "this.previousElementSibling.style.opacity = '0'";

const containerStyle = [
  height && `height: ${height}`
].filter(Boolean).join(';');

const mergedStyle = [
  `object-position: ${position}`,
  `object-fit: ${fit}`,
  typeof style === 'string' ? style : Object.entries(style || {}).map(([k, v]) => `${k}:${v}`).join(';')
].filter(Boolean).join(';');

const isPolaroid = frame === 'polaroid';
---

<figure class:list={["figure-container", { "figure--polaroid": isPolaroid }, className, classList]}>
  {caption && captionPosition === 'top' && (
    <figcaption class="image-caption caption--top" style={`text-align: ${captionAlign};`}>{caption}</figcaption>
  )}
  <div
    class:list={[
      "image-container",
      "base-frame",
      `shape--${shape}`,
      radius && `radius--${radius}`,
      frameClass,
      ...effectClasses
    ]}
    style={containerStyle}
  >
    <div class="image-skeleton effect--shimmer" aria-hidden="true"></div>
    {isZoomable ? (
      <>
        <button popovertarget={`lightbox-${imageId}`} class="zoom-btn" title="View full image">
          <img
            class="image-element"
            src={src}
            alt={alt}
            loading={loading}
            style={mergedStyle}
            onload={onLoadScript}
            onerror={`this.onerror=null; this.src='${errorFallback}';`}
            {...rest}
          />
        </button>
        <div popover id={`lightbox-${imageId}`} class="lightbox">
          <button popovertarget={`lightbox-${imageId}`} popovertargetaction="hide" class="lightbox-close" title="Close full image">
            <img src={src} alt={alt} class="lightbox-img" />
          </button>
        </div>
      </>
    ) : (
      <img
        class="image-element"
        src={src}
        alt={alt}
        loading={loading}
        style={mergedStyle}
        onload={onLoadScript}
        onerror={`this.onerror=null; this.src='${errorFallback}';`}
        {...rest}
      />
    )}
    {caption && captionPosition === 'o-top' && (
      <figcaption class="image-caption caption--o-top" style={`text-align: ${captionAlign};`}>{caption}</figcaption>
    )}
    {caption && captionPosition === 'o-bottom' && !isPolaroid && (
      <figcaption class="image-caption caption--o-bottom" style={`text-align: ${captionAlign};`}>{caption}</figcaption>
    )}
  </div>
  {caption && (captionPosition === 'bottom' || (isPolaroid && captionPosition === 'o-bottom')) && (
    <figcaption 
      class:list={[
        "image-caption", 
        "caption--bottom", 
        { "caption--polaroid": isPolaroid }
      ]} 
      style={`text-align: ${captionAlign};`}
    >
      {caption}
    </figcaption>
  )}
  <slot />
</figure>

<style>
  .figure-container {
    margin: 1rem;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    position: relative;
  }

  .figure--polaroid {
    gap: 0;
  }

  .image-container {
    position: relative;
    width: 100%;
    margin: 0;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .image-caption {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: var(--leading-snug);
  }

  .caption--polaroid {
    position: absolute;
    bottom: 0.75rem;
    left: 0;
    right: 0;
    z-index: 10;
    color: #444;
    font-family: cursive;
    font-size: var(--text-lg);
    padding: 0 1.5rem;
  }

  .caption--o-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-3);
    background: linear-gradient(to top, rgba(var(--overlay-rgb), 0.8) 0%, transparent 100%);
    color: var(--neutral-255);
    z-index: 2;
  }

  .caption--o-top {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    padding: var(--space-3);
    background: linear-gradient(to bottom, rgba(var(--overlay-rgb), 0.8) 0%, transparent 100%);
    color: var(--neutral-255);
    z-index: 2;
  }

  .base-frame {
    background: var(--bg-elevated, rgba(var(--overlay-rgb), 0.1));
  }

  .image-element {
    width: 100%;
    height: 100%;
    display: block;
    transition: opacity 0.3s ease, filter 0.3s ease;
    position: relative;
    z-index: 1;
  }

  /* ─────────────────────────────
     Lightbox
  ───────────────────────────── */

  .zoom-btn {
    appearance: none;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    width: 100%;
    height: 100%;
    cursor: zoom-in;
    display: block;
  }

  .lightbox {
    margin: auto;
    padding: 0;
    border: none;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
  }
  
  .lightbox::backdrop {
    background: rgba(var(--overlay-rgb), 0.8);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .lightbox-close {
    appearance: none;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    cursor: zoom-out;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100vw;
    height: 100vh;
  }

  .lightbox-img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: var(--rad-md);
    box-shadow: var(--shadow-2xl);
  }



  /* ─────────────────────────────
     Skeletons
  ───────────────────────────── */

  .image-skeleton {
    position: absolute;
    top: inherit;
    left: inherit;
    right: inherit;
    bottom: inherit;
    width: 100%;
    height: 100%;
    z-index: 0;
    transition: opacity 0.5s ease;
  }
</style>
