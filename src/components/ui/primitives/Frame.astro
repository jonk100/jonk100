---
/**
 * src/components/ui/primitives/Frame.astro
 * A layout primitive for displaying images in constrained shapes.
 * - Supports multiple predefined aspect ratios and corner radii
 * - Uses lazy loading for performance optimization
 * @props (local): src, alt, shape
 * @props (global): class, class:list
 * - shape: Determines the visual shape and aspect ratio
 */
import type { ComponentShape, ComponentRadius } from '/src/types/variants.types';

export interface Props {
  src: string;
  alt: string;
  shape?: ComponentShape;
  radius?: ComponentRadius;
  class?: string;
  "class:list"?: Record<string, boolean> | any[];
  [key: string]: any;
}

const {
  src,
  alt,
  shape = 'landscape',
  radius,
  class: className = '',
  "class:list": classList = {},
  ...rest
} = Astro.props;
---

<figure
  class:list={[
    'frame',
    `shape--${shape}`,
    radius && `radius--${radius}`,
    className,
    classList
  ]}
  {...rest}
>
  <img
    class="frame__image"
    src={src}
    alt={alt}
    loading="lazy"
  />
</figure>

<style>
.frame {
  overflow: hidden;
  background: var(--bg-elevated);
}

.frame__image {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

</style>