---
/**
 * src/components/ui/primitives/Text.astro
 * A polymorphic typography component for consistent text styling.
 * - Renders content as variable HTML tags dynamically
 * - Standardizes font sizes, lines heights, and semantic tones
 * @props (local): type, as, tone
 * @props (global): class, class:list
 * - type: Selects the typographic block type (e.g., 'body', 'heading-1')
 * - as: The HTML tag to render the text element as
 * - tone: Specifies the text color intention
 */
import type { BlockType, TextTone } from '/src/types/variants.types';

export interface Props {
  type?: BlockType;
  as?: keyof HTMLElementTagNameMap | string;
  tone?: TextTone;
  class?: string;
  "class:list"?: Record<string, boolean> | any[];
  [key: string]: any;
}

const {
  type = 'body',
  tone = 'default',
  as = 'p',
  class: className = '',
  "class:list": classList = {},
  ...rest
} = Astro.props;

const Tag = as;
---

<Tag
  class:list={[
    'text',
    `text--${type}`,
    `text--${tone}`,
    className,
    classList
  ]}
  {...rest}
>
  <slot />
</Tag>

<style>
.text {
  margin: 0;
  color: var(--text);
}

/* ─────────────────────────────
   Variants
───────────────────────────── */

.text--body {
  font-size: var(--font-size-400);
  line-height: 1.6;
}

.text--body-sm {
  font-size: var(--font-size-300);
  line-height: 1.5;
}

.text--heading-1 {
  font-size: var(--font-size-900);
  line-height: 1.05;
  letter-spacing: -0.04em;
  font-weight: 700;
}

.text--heading-2 {
  font-size: var(--font-size-800);
  line-height: 1.1;
  letter-spacing: -0.03em;
  font-weight: 650;
}

.text--heading-3 {
  font-size: var(--font-size-700);
  line-height: 1.15;
  font-weight: 600;
}

.text--caption {
  font-size: var(--font-size-200);
  line-height: 1.4;
}

.text--label {
  font-size: var(--font-size-200);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
</style>