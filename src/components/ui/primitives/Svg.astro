---
/**
 * src/components/ui/primitives/Svg.astro
 * Renders a typed design-system SVG icon.
 * - Uses Astro SVG component imports
 * - Provides autocomplete and type safety
 * - Supports semantic sizing and SVG attributes
 * @props (local): name, size, stroke
 * @props (global): class, class:list
 * - name: Design-system icon identifier
 * - size: Semantic size token or CSS length value
 */

import { icons } from '../../../design/icons';
import type { SvgName } from '../../../design/icons';

export interface Props {
  name: SvgName;
  size?: 'sm' | 'md' | 'lg' | 'xl' | string;
  stroke?: string;
  class?: string;
  'class:list'?: Record<string, boolean> | any[];
  [key: string]: any;
}

const {
  name,
  size = 'md',
  stroke = 'currentColor',
  class: className = '',
  'class:list': classList = {},
  ...rest
} = Astro.props;

const sizeMap: Record<string, string> = {
  sm: 'var(--space-6)',
  md: 'var(--space-16)',
  lg: 'var(--space-20)',
  xl: 'var(--space-24)'
};

const dimension = sizeMap[size] ?? size;

const SvgComponent = icons[name];


---

<SvgComponent
  class:list={[
    'svg',
    className,
    classList
  ]}
  width={dimension}
  height={dimension}
  stroke={stroke}
  {...rest}
/>

<style>
  .svg {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
  }
</style>