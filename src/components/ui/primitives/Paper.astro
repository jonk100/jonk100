---
/**
 * src/components/ui/primitives/Paper.astro
 * A structural container with customizable elevation and radius.
 * - Supports elevation levels that affect backgrounds and shadows
 * - Integrates with global frame and effect variants
 * @props (local): layer, radius, padding, bordered
 * @props (global): class, class:list, frame, effects
 * - layer: Defines depth/elevation (-1 to 5) affecting shadows and background
 * - radius: Specifies the border radius scale
 * - padding: Sets spacing around the content
 */
import type { ComponentTheme, ComponentRadius, SpacingScale, FrameVariant, ComponentEffect, ComponentLayer } from '/src/types/variants.types';
import Text from '../typography/Text.astro';

export interface Props {
  layer?: ComponentLayer;
  radius?: ComponentRadius;
  padding?: SpacingScale;
  bordered?: boolean;
  frame?: FrameVariant;
  effects?: ComponentEffect | ComponentEffect[];
  class?: string;
  "class:list"?: Record<string, boolean> | any[];
  theme?: ComponentTheme;
  caption?: string;
  [key: string]: any;
}

const {
  layer = 0,
  radius = 'md',
  padding = 'md',
  bordered = false,
  frame = 'none',
  theme,
  caption,
  effects = [],
  class: className = '',
  "class:list": classList = {},
  ...rest
} = Astro.props;

// Normalize effects to an array
const effectsArray = Array.isArray(effects) ? effects : [effects];
const effectClasses = effectsArray.map(e => `effect--${e}`);

// Add frame class if applicable
const frameClass = frame !== 'none' ? `frame-variant--${frame}` : '';
---

<div
  class:list={[
    'paper',
    `layer--${layer}`,
    `p-${padding}`,
    `paper--radius-${radius}`,
    { 'paper--bordered': bordered },
    frameClass,
    theme ? `surface--${theme}` : '',
    ...effectClasses,
    className,
    classList
  ]}
  {...rest}
>
  <slot />
  {caption && (
    <div class="paper-caption">
      <Text type="caption">{caption}</Text>
    </div>
  )}
</div>

<style>
/* .paper {
  background: var(--paper-bg, var(--bg-surface));
  color: var(--text);
  transition:
    background-color 160ms ease,
    box-shadow 160ms ease,
    border-color 160ms ease;
} */

.paper-caption {
  margin-top: var(--space-4);
  padding: var(--space-2) var(--space-4);
  background: var(--bg-card);
  border-top: 1px solid var(--border-strong);
  border-radius: var(--rad-sm);
}

/* ─────────────────────────────
   Radius
───────────────────────────── */

.paper--radius-none {
  border-radius: 0;
}

.paper--radius-sm {
  border-radius: var(--rad-sm);
}

.paper--radius-md {
  border-radius: var(--rad-md);
}

.paper--radius-lg {
  border-radius: var(--rad-lg);
}

.paper--radius-xl {
  border-radius: var(--rad-xl);
}


/* ─────────────────────────────
   Border
───────────────────────────── */

.paper--bordered {
  border: 1px solid var(--border-subtle);
}
</style>