---
/**
 * src/components/ui/typography/Quote.astro
 * Blockquote with attribution, pull-quote and inline variants.
 * - Reuses Text typography classes for size, tone, weight, and alignment
 * - Only quote-specific styles (borders, attribution layout) remain scoped
 * @props (local): text, author, source, variant
 * @props (global): class, class:list
 * - variant: Display style ('block' for standard quote, 'pull' for centered pull-quote)
 * - text: Quote content (optional, slot used if not provided)
 * - author: Attribution author name
 * - source: Attribution source/context
 */
import type { FontSize, TextTone } from '/src/types/variants.types';
import Text from './Text.astro';

export interface Props {
  text?: string;
  author?: string;
  source?: string;
  variant?: 'block' | 'pull';
  size?: FontSize;
  tone?: TextTone;
  class?: string;
  "class:list"?: any;
  [key: string]: any;
}

const {
  text,
  author,
  source,
  variant = 'block',
  size = 'base',
  tone = 'default',
  class: className = '',
  "class:list": classList = {},
  ...rest
} = Astro.props;
---
<blockquote class:list={[`quote-${variant}`, className, classList]} {...rest}>
  <Text type="body" size={size} tone={tone} class="quote-text">
    {text ? text : <slot />}
  </Text>
  {(author || source) && (
    <div class="quote-attribution">
      <span class="quote-dash">—</span>
      {author && <Text type="caption" tone="subtle" class="quote-author">{author}</Text>}
      {source && <Text type="caption" tone="muted" class="quote-source">· {source}</Text>}
    </div>
  )}
</blockquote>

<style>
  .quote-block {
    border-left: 2px solid var(--accent);
    padding: var(--space-3) var(--space-4); 
    background: color-mix(in srgb, var(--accent) 5%, transparent);
    border-radius: 0 var(--rad-md) var(--rad-md) 0;
    margin: var(--space-6) 0;
  }
  
  .quote-text { 
    font-style: italic; 
    margin: 0;
  }
  
  .quote-attribution { 
    display: flex; align-items: center; gap: var(--space-2); 
    margin-top: var(--space-3); 
    flex-wrap: wrap;
  }
  
  .quote-dash { font-family: var(--mono); color: var(--accent-dim); }
  .quote-author { font-weight: 500; }
  .quote-source { }
  
  .quote-pull {
    text-align: center; 
    padding: var(--space-6) var(--space-8);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    margin: var(--space-8) 0;
  }
  
  .quote-pull .quote-text { 
    font-family: var(--display);
  }
  
  .quote-pull .quote-attribution { 
    justify-content: center; 
  }
</style>
