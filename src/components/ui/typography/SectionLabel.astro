---
/**
 * src/components/SectionLabel.astro
 * Section label with trailing divider.
 * - Delegates class merging to Astro's native class:list system
 * @props (local): text, theme, tone, size, animate
 * @props (global): class, class:list
 */

import Inline from '../layout/Inline.astro';
import Text from './Text.astro';
import Divider from '../layout/Divider.astro';
import type { ComponentTheme, TextTone, Sizes, AnimationType } from 'src/types/variants.types';

export interface Props {
  bg?: string;
  text?: string;
  theme?: ComponentTheme;
  tone?: TextTone;
  size?: Sizes;
  animate?: AnimationType;
  class?: string;
  'class:list'?: string | Record<string, boolean> | (string | Record<string, boolean>)[];
  [key: string]: any;
}

const {
  text,
  theme = 'default',
  tone = 'subtle',
  size = 'base',
  animate = 'none',
  bg = 'transparent',
  class: cls = '',
  'class:list': classList = {},
  ...rest
} = Astro.props;

const dividerColor = tone ? `var(--text-${tone})` : `var(--text-subtle)`;

const classes = [
  bg ? `bg--${bg}` : '',
  tone ? `text--${tone}` : '',
  'section-label',
  `variant--${theme}`,
  `control--${size}`,
  animate !== 'none' ? `animate-${animate}` : '',
  cls,
].filter(Boolean);
---

<Inline
  align="center"
  gap="md"
  class:list={[...classes, classList]}
  {...rest}
>
  <Text
    as="span"
    type="label"
    tone={tone}
    class="section-label-text"
  >
    {text ? text : <slot />}
  </Text>
  <Divider
    class="section-rule"
    aria-hidden="true"
    style={`color: ${dividerColor}`}
  />
</Inline>

<style>
  .section-label {
    margin-bottom: var(--space-10);
  }

  .section-label-text {
    font-family: var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    white-space: nowrap;
  }

  .section-rule {
    flex: 1;
    height: 1px;
    color: currentColor;
    background: currentColor;
  }
</style>