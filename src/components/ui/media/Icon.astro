---
/**
 * src/components/ui/media/Icon.astro
 * Dynamically loads and renders raw SVG icons.
 * - Resolves SVGs from the icons directory at build time
 * - Applies custom sizing and stroke colors seamlessly
 * @props (local): name, size, stroke
 * @props (global): class, class:list
 * - name: Name of the SVG file in the icons folder to import
 * - size: Maps to predefined dimensions ('sm', 'md', 'lg', 'xl') or accepts custom CSS lengths
 * - stroke: Defines the stroke color of the rendered SVG
 */
export interface Props {
  name: string;
  size?: 'sm' | 'md' | 'lg' | 'xl' | string;
  stroke?: string;
  class?: string;
  "class:list"?: Record<string, boolean> | any[];
  [key: string]: any;
}

const {
  name,
  size = 'md',
  stroke = 'currentColor',
  class: className = '',
  "class:list": classList = {},
  ...rest
} = Astro.props;

const sizeMap: Record<string, string> = {
  sm: 'var(--space-4)',  /* 16px */
  md: 'var(--space-6)',  /* 24px */
  lg: 'var(--space-8)',  /* 32px */
  xl: 'var(--space-12)'  /* 48px */
};

const dimension = sizeMap[size] || size;

// Dynamically import all SVGs in the icons folder as raw text
const svgs = import.meta.glob('../../../icons/*.svg', { as: 'raw' });
const iconPath = `../../../icons/${name}.svg`;

let innerHTML = '';
if (svgs[iconPath]) {
  innerHTML = await svgs[iconPath]();
} else {
  console.error(`[Icon.astro] Icon "${name}" not found.`);
}
---

<span
  class:list={['icon-wrapper', className, classList]}
  style={`width: ${dimension}; height: ${dimension}; color: ${stroke};`}
  {...rest}
  set:html={innerHTML}
/>

<style>
  .icon-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  
  /* Ensure the injected SVG fills the wrapper */
  .icon-wrapper :global(svg) {
    width: 100%;
    height: 100%;
    stroke: currentColor; /* Matches wrapper color */
  }
</style>
