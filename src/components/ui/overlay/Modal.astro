---
/**
 * src/components/ui/overlay/Modal.astro
 * Provides a modal dialog overlay using the native HTML dialog element.
 * - Includes animated backdrop and entry/exit transitions.
 * - Supports click-outside-to-close behavior automatically.
 * @props (local): id, title, size
 * @props (global): class, class:list, frame
 * - id: Required unique identifier for dialog invocation and a11y labels.
 * - size: Maximum width configuration for the modal ('sm', 'md', 'lg', 'full').
 */
import type { FrameVariant, WrapperSize } from 'src/types/variants.types';

export interface Props {
  id: string;
  title?: string;
  size?: WrapperSize;
  frame?: FrameVariant;
  class?: string;
  "class:list"?: Record<string, boolean> | any[];
  [key: string]: any;
}

const {
  id,
  title,
  size = 'md',
  frame = 'none',
  class: className = '',
  "class:list": classList = {},
  ...rest
} = Astro.props;
---

<dialog
  id={id}
  closedby="any"
  class:list={['modal', `modal--size-${size}`, frame !== 'none' ? `frame-variant--${frame}` : '', className, classList]}
  aria-labelledby={title ? `${id}-title` : undefined}
  {...rest}
>
  <div class="modal-content">
    {title && (
      <header class="modal-header">
        <h2 id={`${id}-title`} class="modal-title">{title}</h2>
        <button commandfor={id} command="close" class="modal-close" aria-label="Close dialog">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </header>
    )}
    <div class="modal-body">
      <slot />
    </div>
  </div>
</dialog>

<script>
  // Fallback for light-dismiss if closedby="any" is not supported
  // Astro runs this script on the client side automatically
  const initializeModals = () => {
    const dialogs = document.querySelectorAll('dialog[closedby="any"]');
    
    // Feature detect closedBy support
    if (!('closedBy' in HTMLDialogElement.prototype)) {
      dialogs.forEach(dialog => {
        dialog.addEventListener('click', (event) => {
          if (event.target !== dialog) return;
          const rect = dialog.getBoundingClientRect();
          const isDialogContent = (
            rect.top <= event.clientY &&
            event.clientY <= rect.top + rect.height &&
            rect.left <= event.clientX &&
            event.clientX <= rect.left + rect.width
          );
          if (!isDialogContent) dialog.close();
        });
      });
    }
  };
  
  // Run on initial load
  initializeModals();
  // Support Astro View Transitions if enabled
  document.addEventListener('astro:page-load', initializeModals);
</script>

<style>
  .modal {
    padding: 0;
    border: none;
    border-radius: var(--rad-lg);
    background: var(--bg-surface);
    color: var(--text);
    box-shadow: var(--shadow-xl);
    width: 100%;
    max-height: 90vh;
    overflow: hidden;

    /* Fix centering for native dialogs overridden by global resets */
    margin: auto;
    inset: 0;
    
    /* Native CSS Presence */
    transition: opacity 0.3s ease-out, transform 0.3s ease-out, display 0.3s allow-discrete, overlay 0.3s allow-discrete;
    opacity: 0;
    transform: translateY(10px) scale(0.98);
  }
  
  .modal[open] {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  @starting-style {
    .modal[open] {
      opacity: 0;
      transform: translateY(10px) scale(0.98);
    }
  }

  /* Built-in backdrop */
  .modal::backdrop {
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    transition: background-color 0.3s ease-out, backdrop-filter 0.3s ease-out, display 0.3s allow-discrete, overlay 0.3s allow-discrete;
  }
  
  @starting-style {
    .modal[open]::backdrop {
      background: rgba(0, 0, 0, 0);
      backdrop-filter: blur(0px);
    }
  }

  .modal--size-sm { max-width: 400px; }
  .modal--size-md { max-width: 600px; }
  .modal--size-lg { max-width: 800px; }
  .modal--size-full { max-width: 95vw; height: 95vh; }

  .modal-content {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }

  .modal-title {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .modal-close {
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: var(--space-2);
    margin: calc(var(--space-2) * -1);
    border-radius: var(--rad-md);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }

  .modal-close:hover {
    background: var(--bg-elevated);
    color: var(--text);
  }

  .modal-body {
    padding: var(--space-6);
    overflow-y: auto;
  }
</style>
