---
export interface Props {
  class?: string;
  "class:list"?: Record<string, boolean> | any[];
  [key: string]: any;
}
const { class: className = '', "class:list": classList = {}, ...rest } = Astro.props;
---
<div class:list={["sheet-body", className, classList]} {...rest}>
  <slot />
</div>
<style>
  .sheet-body {
    padding: var(--space-6);
    overflow-y: auto;
    flex-grow: 1;
  }
</style>
