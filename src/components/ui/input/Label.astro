---
/**
 * src/components/ui/input/Label.astro
 * Form label with optional required marker, helper text, error state.
 */
import Icon from '../primitives/Icon.astro';

export interface Props {
  for: string;
  label: string;
  required?: boolean;
  optional?: boolean;
  helperText?: string;
  error?: string;
  class?: string;
  "class:list"?: any;
  [key: string]: any;
}

const {
  for: htmlFor,
  label,
  required = false,
  optional = false,
  helperText,
  error,
  class: className = '',
  "class:list": classList = {},
  ...rest
} = Astro.props;
---
<div class:list={['label-group', className, classList]} {...rest}>
  <label class="form-label" for={htmlFor}>
    {label}
    {required && <span class="required" aria-label="required">*</span>}
    {optional && !required && <span class="optional">(optional)</span>}
  </label>
  
  <slot />
  
  {error ? (
    <p class="error-text" id={`${htmlFor}-err`} role="alert">
      <Icon name="alert-circle" size="xs" />
      {error}
    </p>
  ) : helperText ? (
    <p class="helper-text">{helperText}</p>
  ) : null}
</div>

<style>
  .label-group { 
    display: flex; flex-direction: column; gap: var(--space-1); 
    width: 100%;
  }
  
  .form-label { 
    display: flex; align-items: baseline; gap: var(--space-1); 
    font-size: var(--text-sm); font-weight: 500; color: var(--text); 
  }
  
  .form-label .required { color: var(--text-danger); font-size: var(--text-xs); }
  .form-label .optional { font-size: var(--text-xs); color: var(--text-muted); font-weight: 400; font-family: var(--mono); }
  
  .helper-text { font-size: var(--text-xs); color: var(--text-muted); line-height: 1.5; margin: 0; }
  
  .error-text { 
    font-size: var(--text-xs); color: var(--text-danger); line-height: 1.5; 
    display: flex; align-items: center; gap: 4px; margin: 0;
  }

  /* Make sure slotted inputs style correctly when error is present */
  .label-group:has(.error-text) :global(.form-input),
  .label-group:has(.error-text) :global(input),
  .label-group:has(.error-text) :global(.control) {
    border-color: var(--text-danger);
  }
</style>
