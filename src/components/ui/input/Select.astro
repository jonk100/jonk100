---
/**
 * src/components/ui/input/Select.astro
 * A styled native select dropdown.
 * - Visual container, label, and error layout styles defined in src/styles/variants/controls.css
 * @props (local): label, error, hint, disabled, required, theme, size, id, name
 * @props (global): class, class:list
 */
import type { ComponentTheme, Sizes } from '/src/types/variants.types';
import Icon from '../primitives/Icon.astro';

export interface Props {
  label?: string;
  error?: string;
  hint?: string;
  disabled?: boolean;
  required?: boolean;
  theme?: ComponentTheme;
  size?: Sizes;
  id?: string;
  name?: string;
  class?: string;
  "class:list"?: Record<string, boolean> | any[];
  [key: string]: any;
}

const {
  label,
  error,
  hint,
  disabled = false,
  required = false,
  theme = 'default',
  size = 'md',
  id = `select-${Math.random().toString(36).substring(2, 9)}`,
  name,
  class: className = '',
  "class:list": classList = {},
  ...rest
} = Astro.props;
---

<div class:list={['input-wrapper', className, classList]}>
  {label && (
    <label for={id} class="input-label">
      {label} {required && <span class="required">*</span>}
    </label>
  )}
  
  <div class="select-container">
    <select
      id={id}
      name={name}
      disabled={disabled}
      required={required}
      aria-invalid={!!error}
      aria-describedby={error ? `${id}-error` : hint ? `${id}-hint` : undefined}
      class:list={[
        'control',
        `variant--${theme}`,
        `control--${size}`,
        'select-field',
        { 'input-field--error': error }
      ]}
      {...rest}
    >
      <slot />
    </select>
    <div class="select-icon-wrapper" aria-hidden="true">
      <Icon name="chevron-down" size="sm" class="select-icon" />
    </div>
  </div>
  
  {error && <span id={`${id}-error`} class="input-error">{error}</span>}
  {hint && !error && <span id={`${id}-hint`} class="input-hint">{hint}</span>}
</div>

<style>
  .select-container {
    position: relative;
    display: flex;
    align-items: center;
  }

  .select-field {
    width: 100%;
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
    padding-right: var(--space-8); /* Make room for icon */
  }

  .select-field:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -1px;
  }

  .select-icon-wrapper {
    position: absolute;
    right: var(--space-3);
    pointer-events: none;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
