---
/**
 * src/components/ui/input/Multiselect.astro
 * Custom dropdown with keyboard nav, chip display of selected values.
 */
import Icon from '../primitives/Icon.astro';

export interface Props {
  id?: string;
  name?: string;
  label?: string;
  placeholder?: string;
  options: { label: string; value: string }[];
  initialSelected?: string[];
  class?: string;
  "class:list"?: any;
  [key: string]: any;
}

const {
  id = `ms-${Math.random().toString(36).substr(2, 9)}`,
  name,
  label,
  placeholder = "Select options...",
  options = [],
  initialSelected = [],
  class: className = '',
  "class:list": classList = {},
  ...rest
} = Astro.props;
---
<div class:list={['ms-container', className, classList]} id={`${id}-root`}>
  {label && <label class="ms-label">{label}</label>}
  
  {/* Fallback for form submission */}
  <select multiple name={name} id={`${id}-hidden`} style="display: none;" aria-hidden="true">
    {options.map(opt => (
      <option value={opt.value} selected={initialSelected.includes(opt.value)}>{opt.label}</option>
    ))}
  </select>

  <div class="ms-wrap">
    <div 
      class="ms-trigger" 
      id={`${id}-trigger`} 
      tabindex="0" 
      role="combobox" 
      aria-expanded="false" 
      aria-haspopup="listbox"
      aria-controls={`${id}-dropdown`}
    >
      <div class="ms-chips" id={`${id}-chips`}></div>
      <input 
        class="ms-input" 
        id={`${id}-input`} 
        placeholder={placeholder} 
        aria-label="Filter options"
        autocomplete="off"
        {...rest}
      >
      <Icon name="chevron-down" class="ms-chevron" size="sm" />
    </div>
    
    <div class="ms-dropdown" id={`${id}-dropdown`} role="listbox" aria-multiselectable="true">
      <div id={`${id}-options-container`}>
        <!-- Rendered via JS -->
      </div>
      <div class="ms-empty" id={`${id}-empty`} style="display: none;">No matches</div>
    </div>
  </div>
</div>

<script define:vars={{ id, options, initialSelected }}>
  class MultiselectController {
    constructor() {
      this.selected = new Set(initialSelected);
      this.filter = '';
      this.root = document.getElementById(`${id}-root`);
      this.trigger = document.getElementById(`${id}-trigger`);
      this.input = document.getElementById(`${id}-input`);
      this.dropdown = document.getElementById(`${id}-dropdown`);
      this.optionsContainer = document.getElementById(`${id}-options-container`);
      this.chipsContainer = document.getElementById(`${id}-chips`);
      this.hiddenSelect = document.getElementById(`${id}-hidden`);
      this.emptyState = document.getElementById(`${id}-empty`);
      
      if (!this.root || !this.input) return;
      this.init();
    }

    init() {
      this.renderChips();
      this.renderOptions();

      this.trigger.addEventListener('click', (e) => {
        // Don't toggle if clicking a chip remove button
        if ((e.target as HTMLElement).closest('.ms-chip-remove')) return;
        this.toggleDropdown();
      });

      this.input.addEventListener('input', () => {
        this.filter = this.input.value;
        this.renderOptions();
        this.openDropdown();
      });

      this.input.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') this.closeDropdown();
        if (e.key === 'Backspace' && this.input.value === '') {
          // Remove last chip
          const items = Array.from(this.selected);
          if (items.length > 0) {
            this.toggleOption(items[items.length - 1]);
          }
        }
      });

      document.addEventListener('click', (e) => {
        if (!this.root.contains(e.target)) this.closeDropdown();
      });
      
      // Export functions to global scope for inline event handlers generated by renderOptions
      window[`msToggle_${id}`] = (val) => this.toggleOption(val);
      window[`msRemove_${id}`] = (e, val) => {
        e.stopPropagation();
        this.toggleOption(val);
      };
    }

    renderChips() {
      this.chipsContainer.innerHTML = '';
      this.selected.forEach(val => {
        const opt = options.find(o => o.value === val);
        if (!opt) return;
        
        const chip = document.createElement('span');
        chip.className = 'ms-chip';
        chip.innerHTML = `
          ${opt.label}
          <button type="button" class="ms-chip-remove" aria-label="Remove ${opt.label}" onclick="window['msRemove_${id}'](event, '${val}')">&times;</button>
        `;
        this.chipsContainer.appendChild(chip);
      });
      this.updateHiddenSelect();
    }

    renderOptions() {
      const filtered = options.filter(o => o.label.toLowerCase().includes(this.filter.toLowerCase()));
      
      if (filtered.length === 0) {
        this.optionsContainer.innerHTML = '';
        this.emptyState.style.display = 'block';
        return;
      }
      
      this.emptyState.style.display = 'none';
      this.optionsContainer.innerHTML = filtered.map(o => {
        const isSel = this.selected.has(o.value);
        return `
          <div class="ms-option ${isSel ? 'selected' : ''}" role="option" aria-selected="${isSel}" tabindex="0" onclick="window['msToggle_${id}']('${o.value}')" onkeydown="if(event.key==='Enter') window['msToggle_${id}']('${o.value}')">
            <span class="ms-check">${isSel ? '✓' : ''}</span>
            <span>${o.label}</span>
          </div>
        `;
      }).join('');
    }

    toggleOption(val) {
      if (this.selected.has(val)) {
        this.selected.delete(val);
      } else {
        this.selected.add(val);
      }
      this.filter = '';
      this.input.value = '';
      this.renderChips();
      this.renderOptions();
      this.input.focus();
    }

    updateHiddenSelect() {
      if (!this.hiddenSelect) return;
      Array.from(this.hiddenSelect.options).forEach(opt => {
        opt.selected = this.selected.has(opt.value);
      });
    }

    toggleDropdown() {
      const isOpen = this.dropdown.classList.contains('open');
      if (isOpen) this.closeDropdown();
      else this.openDropdown();
    }

    openDropdown() {
      this.dropdown.classList.add('open');
      this.trigger.setAttribute('aria-expanded', 'true');
      this.input.focus();
    }

    closeDropdown() {
      this.dropdown.classList.remove('open');
      this.trigger.setAttribute('aria-expanded', 'false');
    }
  }

  // Use simple timeout to ensure DOM is ready in Astro
  setTimeout(() => {
    new MultiselectController();
  }, 0);
  document.addEventListener('astro:page-load', () => new MultiselectController());
</script>

<style>
  .ms-container { display: flex; flex-direction: column; gap: var(--space-2); width: 100%; position: relative; }
  .ms-label { font-size: var(--text-sm); font-weight: 500; color: var(--text); }
  
  .ms-wrap { position: relative; }
  
  .ms-trigger { 
    display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-1); 
    min-height: 2.5rem; padding: var(--space-1) var(--space-2); 
    border: 1px solid var(--border); border-radius: var(--rad-md); 
    background: var(--bg-surface); cursor: text; 
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .ms-trigger:focus-within { 
    border-color: var(--accent); 
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 30%, transparent); 
  }
  
  .ms-chips { display: flex; flex-wrap: wrap; gap: var(--space-1); }
  
  .ms-chip { 
    display: inline-flex; align-items: center; gap: var(--space-1); 
    background: color-mix(in srgb, var(--accent) 15%, transparent); 
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent); 
    border-radius: var(--rad-sm); 
    padding: 2px var(--space-2); 
    font-size: var(--text-xs); color: var(--text); 
  }
  .ms-chip-remove { 
    background: none; border: none; cursor: pointer; padding: 0; 
    line-height: 1; color: var(--text-muted); font-size: 14px; 
    display: flex; align-items: center; justify-content: center;
  }
  .ms-chip-remove:hover { color: var(--text-danger); }
  
  .ms-input { 
    border: none; outline: none; background: transparent; 
    font-size: var(--text-sm); color: var(--text); min-width: 80px; flex: 1; 
    font-family: var(--sans); padding: var(--space-1);
  }
  .ms-input::placeholder { color: var(--text-muted); }
  
  .ms-chevron { margin-left: auto; color: var(--text-muted); flex-shrink: 0; pointer-events: none; }
  
  .ms-dropdown { 
    position: absolute; top: calc(100% + 4px); left: 0; right: 0; 
    background: var(--surface-1); border: 1px solid var(--border); 
    border-radius: var(--rad-md); z-index: 50; overflow-y: auto; max-height: 250px;
    display: none; box-shadow: var(--shadow-lg); 
  }
  .ms-dropdown.open { display: block; animation: slide-down-fade 0.2s ease-out; }
  
  .ms-option { 
    padding: var(--space-2) var(--space-3); font-size: var(--text-sm); 
    cursor: pointer; display: flex; align-items: center; gap: var(--space-2); 
    color: var(--text); transition: background 0.1s;
  }
  .ms-option:hover, .ms-option:focus { background: var(--surface-2); outline: none; }
  .ms-option.selected { color: var(--accent); background: color-mix(in srgb, var(--accent) 5%, transparent); }
  
  .ms-check { 
    width: 16px; height: 16px; border: 1px solid var(--border); 
    border-radius: var(--rad-sm); flex-shrink: 0; display: flex; 
    align-items: center; justify-content: center; font-size: 10px; font-weight: bold;
    color: transparent; transition: all 0.2s;
  }
  .ms-option.selected .ms-check { 
    background: var(--accent); border-color: var(--accent); color: var(--neutral-0); 
  }
  
  .ms-empty { padding: var(--space-3); font-size: var(--text-sm); color: var(--text-muted); text-align: center; }

  @keyframes slide-down-fade {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
