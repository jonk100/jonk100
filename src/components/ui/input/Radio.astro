---
/**
 * src/components/ui/input/Radio.astro
 * A styled radio button input.
 * - Utilizes global .sr-only class from src/styles/tokens/layout.css for accessibility visual hiding
 * @props (local): id, name, value, checked, disabled, label, theme
 * @props (global): class, class:list
 */
import type { ComponentTheme } from '/src/types/variants.types';

export interface Props {
  id?: string;
  name: string;
  value: string;
  checked?: boolean;
  disabled?: boolean;
  label?: string;
  theme?: ComponentTheme;
  class?: string;
  "class:list"?: Record<string, boolean> | any[];
  [key: string]: any;
}

const {
  id = `radio-${Math.random().toString(36).substring(2, 9)}`,
  name,
  value,
  checked = false,
  disabled = false,
  label,
  theme = 'primary',
  class: className = '',
  "class:list": classList = {},
  ...rest
} = Astro.props;
---

<label class:list={['radio-wrapper', { 'is-disabled': disabled }, className, classList]} for={id}>
  <input
    type="radio"
    id={id}
    name={name}
    value={value}
    checked={checked}
    disabled={disabled}
    class="sr-only radio-input"
    {...rest}
  />
  <div class:list={['radio-circle', `variant--${theme}`]} aria-hidden="true">
    <div class="radio-dot"></div>
  </div>
  {label && <span class="radio-label">{label}</span>}
</label>

<style>
  .radio-wrapper {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    cursor: pointer;
    position: relative;
  }

  .radio-wrapper.is-disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }



  .radio-circle {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background-color: var(--surface-3); /* Progressive surface elevation shade */
    border: 1px solid color-mix(in srgb, var(--text) 45%, transparent); /* Stronger high-contrast border */
    transition: all 0.2s ease-in-out;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .radio-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--variant-text);
    opacity: 0;
    transform: scale(0.5);
    transition: all 0.2s ease-in-out;
  }

  /* Checked states */
  .radio-input:checked + .radio-circle {
    background-color: var(--variant-bg);
    border-color: var(--variant-border);
  }

  .radio-input:checked + .radio-circle .radio-dot {
    opacity: 1;
    transform: scale(1);
  }

  /* Focus states */
  .radio-input:focus-visible + .radio-circle {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .radio-label {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text);
    user-select: none;
  }
</style>
