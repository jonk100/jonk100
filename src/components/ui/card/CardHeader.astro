---
/**
 * src/components/ui/layout/CardHeader.astro
 * The header section of a Card.
 * @props (local): None
 * @props (global): class, class:list
 */
export interface Props {
  class?: string;
  "class:list"?: Record<string, boolean> | any[];
  [key: string]: any;
}

const {
  class: className = '',
  "class:list": classList = {},
  ...rest
} = Astro.props;
---

<div class:list={['card-header', className, classList]} {...rest}>
  <slot />
</div>

<style>
  .card-header {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
</style>
