---
/**
 * src/components/ui/layout/Stack.astro
 * A vertical layout primitive for stacking elements in a column.
 * - Controls the alignment and spacing of stacked children
 * - Optionally injects horizontal dividers between sibling elements
 * @props (local): as, gap, align, justify, divider
 * @props (global): class, class:list
 * - gap: Determines the spacing between stacked elements
 * - divider: Conditionally adds a border-top between sibling elements via lobotomized owl selector
 */
import type { FlexboxProps } from 'src/types/variants.types.ts';

export interface Props extends FlexboxProps {
  as?: string;
  divider?: boolean;
  class?: string;
  "class:list"?: Record<string, boolean> | any[];
  [key: string]: any;
}

const {
  as: Tag = 'div',
  gap = 'md',
  align = 'stretch',
  justify = 'start',
  divider = false,
  class: className = '',
  "class:list": classList = {},
  style = '',
  ...rest
} = Astro.props;

const internalStyle = `align-items: ${align}; justify-content: ${justify};`;
const combinedStyle = [internalStyle, typeof style === 'string' ? style : Object.entries(style || {}).map(([k, v]) => `${k}:${v}`).join(';')].filter(Boolean).join(';');
---

<Tag
  class:list={[
    'stack',
    `gap-${gap}`,
    { 'stack--divided': divider },
    className,
    classList
  ]}
  style={combinedStyle}
  {...rest}
>
  <slot />
</Tag>

<style>
  .stack {
    display: flex;
    flex-direction: column;
  }
  
  /* Lobotomized owl selector for generic sibling borders */
  .stack--divided > :global(* + *) {
    border-top: 1px solid var(--border);
    padding-top: calc(var(--gap-value, 1rem) / 2);
  }
</style>
