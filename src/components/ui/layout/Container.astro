---
/**
 * src/components/Container.astro
 * Container wrapper component.
 * - Delegates class merging to Astro's native class:list system
 * @props (local): as
 * @props (global): class, class:list, frame, effects
 * - as: HTML tag to render
 */

import type { FrameVariant, ComponentEffect } from '/src/types/variants.types';

export interface Props {
  as?: string;
  frame?: FrameVariant;
  effects?: ComponentEffect | ComponentEffect[];
  class?: string;
  "class:list"?: Record<string, boolean>;
  [key: string]: any;
}

const {
  as = "div",
  frame,
  effects,
  class: cls = "",
  "class:list": classList = {},
  ...rest
} = Astro.props;

const Tag = as || "div";

const effectClasses = Array.isArray(effects) 
  ? effects.map(e => `effect--${e}`).join(' ') 
  : effects ? `effect--${effects}` : '';

const classes = [
  "container", 
  frame && `frame-variant--${frame}`, 
  effectClasses, 
  cls
]
  .filter(Boolean)
  .join(" ");
---

<Tag class={classes} class:list={classList} {...rest}>
  <slot />
</Tag>

<style>
  .container {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-4);
  }

  .container.sm {
    padding: var(--space-1)  var(--space-2);
  }

  .container.md {
    padding: var(--space-2)  var(--space-3);
  }

  .container.lg {
    padding: var(--space-3) var(--space-4);
  }
  .container.xl {
    padding: var(--space-4) var(--space-8);
  }
  .container.icon {
    padding: var(--space-2);
  }

  .container.icon-sm {
    padding: var(--space-1);
  }

  .container.icon-lg {
    padding: var(--space-3);
  }

  .container.default {
    background-color: var(--bg-surface);
    color: var(--text);
  }

  .container.primary {
    background-color: color-mix(in srgb, var(--primary) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--primary) 30%, transparent);
    color: var(--primary);
  }
</style>
