---
/**
 * src/components/ui/layout/Bento.astro
 * A specialized grid wrapper for creating asymmetrical "Bento Box" layouts.
 * - Leverages CSS Grid for precise cell positioning
 * - Supports responsive column counts
 * @props (local): columns, gap
 * @props (global): class, class:list
 */
import type { SpacingScale } from 'src/types/variants.types';

export interface Props {
  columns?: number | string;
  gap?: SpacingScale;
  class?: string;
  "class:list"?: Record<string, boolean> | any[];
  [key: string]: any;
}

const {
  columns = 4,
  gap = 'md',
  class: className = '',
  "class:list": classList = {},
  ...rest
} = Astro.props;

const gridTemplateColumns = typeof columns === 'number' 
  ? `repeat(${columns}, minmax(0, 1fr))` 
  : columns;
---

<div 
  class:list={['bento-grid', `gap-${gap}`, className, classList]} 
  style={`grid-template-columns: ${gridTemplateColumns};`}
  {...rest}
>
  <slot />
</div>

<style>
  .bento-grid {
    display: grid;
    /* Bento layouts often benefit from grid-auto-rows to maintain rhythm */
    grid-auto-rows: minmax(100px, auto);
    width: 100%;
  }

  .gap-xs { gap: var(--space-2); }
  .gap-sm { gap: var(--space-4); }
  .gap-md { gap: var(--space-6); }
  .gap-lg { gap: var(--space-8); }
  .gap-xl { gap: var(--space-12); }

  @media (max-width: 768px) {
    .bento-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
  }

  @media (max-width: 480px) {
    .bento-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>
