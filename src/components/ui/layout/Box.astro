---
/**
 * src/components/ui/layout/Box.astro
 * A foundational layout primitive for applying spacing, margins, display, and animation properties.
 * - Supports responsive padding and margin via spacing scale values
 * - Configurable HTML tag rendering with the 'as' prop
 * @props (local): as, padding, margin, display, animate
 * @props (global): class, class:list, frame, effects
 * - padding: Applies padding using a spacing scale value
 * - margin: Applies margin using a spacing scale value
 * - frame: Applies a specific frame style variant to the component
 * - effects: Applies single or multiple image effects to the component
 * - animate: Applies an entrance or loop animation variant (defined in src/styles/variants/animations.css)
 */
import type { SpacingScale, FrameVariant, ComponentEffect, ComponentRadius, AnimationType } from 'src/types/variants.types.ts';

export interface Props {
  as?: string;
  padding?: SpacingScale;
  margin?: SpacingScale;
  display?: 'block' | 'inline-block' | 'inline' | 'flex' | 'grid' | 'none';
  layer?: -1 | 0 | 1 | 2 | 3 | 4 | 5;
  class?: string;
  "class:list"?: Record<string, boolean> | any[];
  frame?: FrameVariant;
  effects?: ComponentEffect | ComponentEffect[];
  radius?: ComponentRadius;
  animate?: AnimationType;
  [key: string]: any;
}

const {
  as: Tag = 'div',
  padding,
  margin,
  display,
  layer,
  class: className = '',
  "class:list": classList = {},
  frame,
  effects,
  radius,
  animate = 'none',
  style = '',
  ...rest
} = Astro.props;

const internalStyle = display ? `display: ${display};` : '';
const combinedStyle = [internalStyle, typeof style === 'string' ? style : Object.entries(style || {}).map(([k, v]) => `${k}:${v}`).join(';')].filter(Boolean).join(';');
---

<Tag
  class:list={[
    'box',
    padding && `p-${padding}`,
    margin && `m-${margin}`,
    layer !== undefined && `layer--${layer}`,
    animate !== 'none' ? `animate-${animate}` : '',
    className,
    classList,
    frame,
    effects,
    radius && `radius--${radius}`
  ]}
  style={combinedStyle}
  {...rest}
>
  <slot />
</Tag>

<style>
  /* Box is purely functional, delegating sizing to global space utilities */
  .box {
    /* Base wrapper properties if needed */
  }
</style>
