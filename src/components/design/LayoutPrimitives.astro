---
/**
 * src/components/design/LayoutPrimitives.astro
 * Layout Primitives section showcasing core structural containers.
 * - Displays responsive bento box grid spanning.
 * - Exhibits flex-inline and ButtonGroup structures.
 * - Anchors sibling tooltip component explanation.
 * @props (local): None
 * @props (global): None
 */

import Text from '../ui/typography/Text.astro';
import Code from '../ui/typography/Code.astro';
import SectionLabel from '../ui/typography/SectionLabel.astro';
import Stack from '../ui/layout/Stack.astro';
import Inline from '../ui/layout/Inline.astro';
import BentoGrid from '../ui/layout/BentoGrid.astro';
import BentoCell from '../ui/layout/BentoCell.astro';
import Divider from '../ui/layout/Divider.astro';
import ButtonGroup from '../ui/layout/ButtonGroup.astro';
import Button from '../ui/controls/Button.astro';
import BadgeGroup from '../ui/feedback/BadgeGroup.astro';
import Badge from '../ui/feedback/Badge.astro';
import Tooltip from '../ui/overlay/Tooltip.astro';
import Paper from '../ui/primitives/Paper.astro';

const layoutBlueprint = `
#LT#BentoGrid gap="md"#GT#
  #LT#BentoCell span="flagship"#GT#
    #LT#Paper layer="3" padding="md"#GT#Flagship Feature#LT#/Paper#GT#
  #LT#/BentoCell#GT#
  #LT#BentoCell span="secondary"#GT#
    #LT#Paper layer="0" padding="md"#GT#Side content#LT#/Paper#GT#
  #LT#/BentoCell#GT#
#LT#/BentoGrid#GT#
`.trim().replaceAll('#LT#', '<').replaceAll('#GT#', '>');

const badgeGroupBlueprint = `
#LT#!-- Badge children automatically inherit theme, size, and outlined states --#GT#
#LT#BadgeGroup theme="primary" size="md" outlined#GT#
  #LT#Badge#GT#Segment 1 (Inherited)#LT#/Badge#GT#
  #LT#Badge#GT#Segment 2 (Inherited)#LT#/Badge#GT#
  #LT#Badge theme="accent" outlined={false}#GT#Overridden Segment#LT#/Badge#GT#
#LT#/BadgeGroup#GT#
`.trim().replaceAll('#LT#', '<').replaceAll('#GT#', '>');
---

<Paper padding="lg" layer="0" bordered id="layout-showcase" style="anchor-name: --layout-showcase;">
  <Stack gap="md">
    <SectionLabel text="02 / layout primitives" />
    <Text as="h2" type="h2">Compositional Structures</Text>
    <Text tone="subtle">Structural containers designed to manage spacing scales, flex directions, alignments, and grid divisions cleanly without duplicated inline styles.</Text>
    
    <Divider />
    
    <!-- Grid and Bento Layout Exhibit -->
    <Stack gap="sm">
      <Text as="h3" type="h3">Responsive Bento Spanning</Text>
      <BentoGrid gap="md" class="bento-blueprint">
        <BentoCell span="flagship">
          <Paper layer="3" padding="md" class="bento-cell-demo">
            <Text as="strong" type="h4">Flagship Cell (7/12 cols)</Text>
            <Text type="caption" tone="subtle">Responsive flex-grow allocation</Text>
          </Paper>
        </BentoCell>
        <BentoCell span="secondary">
          <Paper layer="0" padding="md" class="bento-cell-demo">
            <Text as="strong" type="h4">Secondary (5/12 cols)</Text>
            <Text type="caption" tone="subtle">Standard column stack</Text>
          </Paper>
        </BentoCell>
        <BentoCell span="secondary-alt">
          <Paper layer="0" padding="md" class="bento-cell-demo">
            <Text as="strong" type="h4">Secondary Alt (5/12 cols)</Text>
            <Text type="caption" tone="subtle">Perfect fit for side content</Text>
          </Paper>
        </BentoCell>
        <BentoCell span="wide">
          <Paper layer="0" padding="md" class="bento-cell-demo">
            <Text as="strong" type="h4">Wide Cell (7/12 cols)</Text>
            <Text type="caption" tone="subtle">Perfect for hero project features</Text>
          </Paper>
        </BentoCell>
      </BentoGrid>
    </Stack>
    
    <!-- Inline Flex elements -->
    <Stack gap="sm" class="inline-layouts">
      <Text as="h3" type="h3">Flex Inline, ButtonGroup & BadgeGroup Layouts</Text>
      <Text type="body-sm" tone="subtle">
        Compare horizontal <code>&lt;Inline&gt;</code> elements against joined segmented containers like <code>&lt;ButtonGroup&gt;</code> and <code>&lt;BadgeGroup&gt;</code> that automatically handle border-radius trimming and prop inheritance.
      </Text>
      
      <Inline gap="md" align="center" wrap>
        <Inline gap="xs">
          <Button theme="secondary" size="sm">Inline A</Button>
          <Button theme="secondary" size="sm">Inline B</Button>
        </Inline>
        
        <ButtonGroup>
          <Button theme="secondary" size="sm">Left Segment</Button>
          <Button theme="secondary" size="sm">Middle Segment</Button>
          <Button theme="secondary" size="sm">Right Segment</Button>
        </ButtonGroup>
        
        <BadgeGroup theme="primary" size="md" outlined>
          <Badge>Inherited 1</Badge>
          <Badge>Inherited 2</Badge>
          <Badge theme="accent" outlined={false}>Overridden</Badge>
        </BadgeGroup>
      </Inline>
      
      <details class="code-details">
        <summary><Text type="caption" tone="accent">Show BadgeGroup Inheritance Blueprint</Text></summary>
        <Code inline={false} language="astro">{badgeGroupBlueprint}</Code>
      </details>
    </Stack>

    <!-- Educational Architecture Callout -->
    <Paper layer="2" padding="md" class="architectural-rationale">
      <Stack gap="2xs">
        <Text as="h4" type="h4" tone="accent">Architectural Rationale: Spacing & Clamp Spanning</Text>
        <Text type="body-sm" tone="subtle">
          Spacing scales use fluid containers utilizing CSS <code>clamp()</code> functions linked to container queries. Layout structures automatically adapt to parent aspect ratios, eliminating visual layout thrashing.
        </Text>
        <details class="code-details">
          <summary><Text type="caption" tone="accent">Show Bento Grid Blueprint</Text></summary>
          <Code inline={false} language="astro">{layoutBlueprint}</Code>
        </details>
      </Stack>
    </Paper>
  </Stack>
</Paper>
<Tooltip id="layout-tooltip" anchor="layout-showcase" placement="top">
  Bento Grid layouts responsive spanning configurations!
</Tooltip>

<style>
  @import './DesignPage.css';

  .code-details {
    cursor: pointer;
  }

  .code-details summary {
    font-weight: 500;
    list-style: none;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .code-details summary::-webkit-details-marker {
    display: none;
  }

  .code-details[open] summary {
    margin-bottom: var(--space-3);
  }

  .bento-cell-demo {
    background: var(--bg-surface);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 140px;
    height: 100%;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  .bento-cell-demo:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
  }

  .inline-layouts {
    margin-top: var(--space-lg);
  }
</style>
