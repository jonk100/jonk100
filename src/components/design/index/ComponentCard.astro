---
/**
 * src/components/design/index/ComponentCard.astro
 * A single component card link for the design system catalog.
 * Renders an animated card with icon, title, description, and metadata badges.
 *
 * @prop {object} comp - A design collection entry object
 * @prop {number} index - The card's position in the list, used to stagger animation delay
 */

import Text from '../../ui/typography/Text.astro';
import Stack from '../../ui/layout/Stack.astro';
import Inline from '../../ui/layout/Inline.astro';
import Paper from '../../ui/primitives/Paper.astro';
import Badge from '../../ui/feedback/Badge.astro';
import Icon from '../../ui/primitives/Icon.astro';
import Svg from '../../ui/primitives/Svg.astro';
import { icons } from '../../../design/icons';
import type { SvgName } from '../../../design/icons';

interface Props {
  comp: any; // Replace with your CollectionEntry<'design'> type if available
  index: number;
}

const { comp, index } = Astro.props;

/** Resolve the icon name: use the component id if it exists in the icon map, else fall back to 'box' */
const icon = comp.id in icons ? comp.id : 'box';
---

<a
  href={`/design/${comp.id}`}
  class="component-card-link"
  style={`animation-delay: ${index * 0.08}s;`}
>
  <Paper layer="1" bordered class="component-card">
    <div class="card-accent-bar"></div>

    <Stack gap="sm" class="card-body">
      <Inline justify="between">

        <Inline gap="xs" align="center">
          <Svg name={icon as SvgName} size="sm" class="card-icon" />

          <Text as="strong" type="h4" tone="accent" class="card-title">
            {comp.data.title}
          </Text>
        </Inline>

        <Icon name="arrow-up-right" size="sm" class="card-icon" />
      </Inline>

      <Text type="body-sm" tone="subtle" class="card-desc">
        {comp.data.description}
      </Text>

      <Inline gap="xs" class="card-tags">
        <Badge theme="ghost" outlined>{comp.data.category}</Badge>

        {comp.data.propsTable && (
          <Badge theme="ghost" outlined>
            {comp.data.propsTable.length} properties
          </Badge>
        )}
      </Inline>
    </Stack>
  </Paper>
</a>

<style>
  .component-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .component-card {
    height: 100%;
    position: relative;
    overflow: hidden;
    transition:
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.3s ease;
  }

  .component-card-link:hover .component-card {
    border-color: var(--accent);
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .card-accent-bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 3px;
    background: linear-gradient(to right, var(--accent) 0%, transparent 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 2;
  }

  .component-card-link:hover .card-accent-bar {
    opacity: 1;
  }

  .card-body {
    padding: var(--space-6);
  }

  .card-title {
    margin: 0;
    font-size: var(--text-md);
    transition: color 0.3s ease;
  }

  .component-card-link:hover .card-title {
    color: var(--accent);
  }

  .card-icon {
    color: var(--text-muted);
    transition:
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.3s ease;
  }

  .component-card-link:hover .card-icon {
    transform: translate(2px, -2px);
    color: var(--accent);
  }

  .card-desc {
    margin: 0;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-tags {
    margin-top: var(--space-4);
  }
</style>