---
/**
 * src/components/design/OverlaysDialogs.astro
 * Overlays & Dialogs section showcasing native browser overlay features.
 * - Displays command-triggered native dialog Modals.
 * - Exhibits Anchor-positioned Popover menus.
 * - Shows Anchor-positioned hover Tooltips.
 * - Anchors sibling tooltip component explanation.
 * @props (local): None
 * @props (global): None
 */

import Text from '../ui/typography/Text.astro';
import Code from '../ui/typography/Code.astro';
import SectionLabel from '../ui/typography/SectionLabel.astro';
import Stack from '../ui/layout/Stack.astro';
import Inline from '../ui/layout/Inline.astro';
import Divider from '../ui/layout/Divider.astro';
import Icon from '../ui/media/Icon.astro';
import Button from '../ui/controls/Button.astro';
import Modal from '../ui/modal/Modal.astro';
import ModalHeader from '../ui/modal/ModalHeader.astro';
import ModalBody from '../ui/modal/ModalBody.astro';
import Popover from '../ui/overlay/Popover.astro';
import Tooltip from '../ui/overlay/Tooltip.astro';
import Paper from '../ui/primitives/Paper.astro';

const tooltipBlueprint = `
#LT#button id="target-btn" style="anchor-name: --target-btn;" class="..."#GT#
  Hover Me
#LT#/button#GT#
 
#LT#Tooltip id="info-tooltip" anchor="target-btn" placement="top"#GT#
  CSS Anchor Positioned!
#LT#/Tooltip#GT#
`.trim().replaceAll('#LT#', '<').replaceAll('#GT#', '>');
---

<Paper padding="lg" layer="1" bordered id="overlay-showcase" style="anchor-name: --overlay-showcase;">
  <Stack gap="md">
    <SectionLabel text="05 / overlays & dialogs" />
    <Text as="h2" type="h2">Native Layering Portals</Text>
    <Text tone="subtle">Dismissible dialogs, popovers, and anchors utilizing native web specifications.</Text>
    
    <Divider />
    
    <Inline gap="md" align="center" wrap>
      <!-- Native Modal Button trigger -->
      <Button commandfor="system-modal" command="show-modal" theme="primary" size="md">
        Launch Native Modal
      </Button>
      
      <Modal id="system-modal">
        <ModalHeader>
          <Text as="h3" type="h3">Confirm System Refactoring</Text>
        </ModalHeader>
        <ModalBody>
          <Stack gap="md">
            <Text>This refactoring action will clean relative paths, align CSS anchor positions, and elevate table layers. This uses a native <code>&lt;dialog&gt;</code> element to implement standard keyboard focus traps and background dimming.</Text>
            <Inline gap="sm" justify="end">
              <Button commandfor="system-modal" command="close" theme="ghost" size="md">Cancel</Button>
              <Button commandfor="system-modal" command="close" theme="primary" size="md">Confirm Execution</Button>
            </Inline>
          </Stack>
        </ModalBody>
      </Modal>

      <!-- Popover Toggle Trigger -->
      <Button id="system-pop-btn" style="anchor-name: --system-pop-btn;" commandfor="system-popover" command="toggle-popover" theme="secondary" size="md">
        Toggle Anchor Popover
      </Button>
      
      <Popover id="system-popover" anchor="system-pop-btn" placement="bottom">
        <Stack gap="sm">
          <Text as="strong" type="label" tone="accent">Quick Controls</Text>
          <Button theme="ghost" size="sm" class="text-left">System Diagnostics</Button>
          <Button theme="ghost" size="sm" class="text-left">Deploy Workspace</Button>
        </Stack>
      </Popover>

      <!-- Tooltip Hover Trigger -->
      <Button id="system-tip-btn" style="anchor-name: --system-tip-btn;" theme="outline" size="md">
        Hover Me (Anchor Tooltip)
      </Button>
      
      <Tooltip id="system-action-tooltip" anchor="system-tip-btn" placement="top">
        Native CSS Anchor Positioning!
      </Tooltip>
    </Inline>

    <!-- Educational Architecture Callout -->
    <Paper layer="2" padding="md" class="architectural-rationale">
      <Stack gap="2xs">
        <Text as="h4" type="h4" tone="accent">Architectural Rationale: Popovers & CSS Anchors</Text>
        <Text type="body-sm" tone="subtle">
          Instead of packing heavy third-party coordinate libraries (like Popper.js or Floating UI), our system leverages native CSS Anchor Positioning (<code>position-anchor</code>, <code>anchor()</code>) combined with the native Popover API. Dismiss behavior and positioning calculations are executed natively by the browser's layout engine.
        </Text>
        <details class="code-details">
          <summary><Text type="caption" tone="accent">Show Anchor Tooltip Blueprint</Text></summary>
          <Code inline={false} language="astro">{tooltipBlueprint}</Code>
        </details>
      </Stack>
    </Paper>
  </Stack>
</Paper>
<Tooltip id="overlay-tooltip" anchor="overlay-showcase" placement="top">
  Native dialogs, popovers, and anchor-positioned tooltips!
</Tooltip>

<style>
  @import './DesignPage.css';

  .code-details {
    cursor: pointer;
  }

  .code-details summary {
    font-weight: 500;
    list-style: none;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .code-details summary::-webkit-details-marker {
    display: none;
  }

  .code-details[open] summary {
    margin-bottom: var(--space-3);
  }

  .text-left {
    text-align: left;
    justify-content: flex-start;
  }
</style>
