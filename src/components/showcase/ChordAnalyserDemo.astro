---
/**
 * ChordAnalyserDemo.astro
 * 
 * Portfolio showcase component that demonstrates the interactive chord analyser
 * from Writty. Imports directly from the Writty submodule.
 */
import ChordAnalyser from '@writty/components/chords/ChordAnalyser.astro';
---

<section class="showcase-section">
  <div class="showcase-header">
    <h2>Interactive Chord Analyser</h2>
    <p class="showcase-description">
      A self-contained guitar chord analyser built for Writty. Click frets to place fingers,
      toggle string states, and see which chord names match your voicing. Pure vanilla TypeScript,
      no external dependencies.
    </p>
  </div>

  <div class="showcase-demo">
    <ChordAnalyser />
  </div>

  <div class="showcase-features">
    <h3>Features</h3>
    <ul>
      <li>Interactive fretboard (6 strings × 16 frets)</li>
      <li>Real-time chord name detection</li>
      <li>String state toggling (open/muted/silent)</li>
      <li>Fretboard window shifting</li>
      <li>Standard guitar tuning (E A D G B E)</li>
    </ul>
  </div>
</section>

<style>
  .showcase-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .showcase-header {
    margin-bottom: 2rem;
  }

  .showcase-header h2 {
    font-size: var(--text-2xl);
    margin-bottom: 0.5rem;
  }

  .showcase-description {
    color: var(--text-secondary);
    font-size: var(--text-lg);
    line-height: 1.6;
  }

  .showcase-demo {
    margin: 2rem 0;
    padding: 2rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
  }

  .showcase-features {
    margin-top: 2rem;
  }

  .showcase-features h3 {
    font-size: var(--text-xl);
    margin-bottom: 1rem;
  }

  .showcase-features ul {
    list-style: none;
    padding: 0;
  }

  .showcase-features li {
    padding: 0.5rem 0;
    padding-left: 1.5rem;
    position: relative;
  }

  .showcase-features li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--accent);
  }
</style>