---
/**
 * ChordAnalyser.astro
 *
 * A self-contained guitar chord analyser component.
 * Renders an interactive fretboard (6 strings × 16 frets) that lets the
 * user click to place / remove fingers, toggle strings open/muted/silent,
 * shift the visible window up and down the neck, and see which chord names
 * match the selected notes.
 *
 * No external dependencies — pure vanilla TypeScript in a <script> block.
 *
 * Tuning: Standard (E A D G B E, low→high)
 * Frets shown: 0 (open) through 15, plus an "R" (root) indicator column.
 */
---

<section class="ca-wrap" data-chord-analyser aria-label="Guitar Chord Analyser">

  <!-- ── Header ─────────────────────────────────────────── -->
  <header class="ca-header">
    <div class="ca-chord-name" data-ca-chord-name>
      <span class="ca-chord-root" id="ca-chord-root">—</span>
    </div>

    <div class="ca-tuning">
      <span class="ca-tuning-notes">E A D G B E</span>
      <span class="ca-tuning-label">Standard Tuning</span>
    </div>

    <div class="ca-header-buttons">
      <button class="ca-toggle-btn" data-ca-btn-toggle title="Toggle chord analyser" aria-expanded="true">
        <!-- Simple collapse/expand SVG -->
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
      
      <button class="ca-reset-btn" data-ca-btn-reset title="Reset">
        <!-- Simple reset arrow SVG -->
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
          <path d="M3 3v5h5"/>
        </svg>
      </button>
    </div>
  </header>

  <!-- ── Collapsible Content ─────────────────────────────── -->
  <div class="ca-content" data-ca-content>

  <!-- ── Fretboard ──────────────────────────────────────── -->
  <div class="ca-fretboard-wrap">

    <!-- Row: toggles + grid side-by-side -->
    <div class="ca-fretboard-row">

      <!-- Main grid -->
      <div class="ca-fretboard" data-ca-fretboard role="grid" aria-label="Fretboard">
        <!-- Populated by JS -->
      </div>

    </div>

    <!-- Fret numbers: spacer for toggle column + numbers aligned to grid -->
    <div class="ca-fret-numbers-row">
      <div class="ca-fret-numbers" data-ca-fret-numbers>
        <!-- Populated by JS -->
      </div>
    </div>

  </div>

  <!-- ── Toolbar ────────────────────────────────────────── -->
  <div class="ca-toolbar">
    <button class="ca-tool-btn" data-ca-btn-notes title="Toggle note names">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <span>Notes</span>
    </button>

    <button class="ca-tool-btn" data-ca-btn-root title="Toggle root note">
      <span style="font-size:0.85rem;letter-spacing:.05em"># ♭ ♮</span>
      <span>Root</span>
    </button>

    <button class="ca-tool-btn" data-ca-btn-lower title="Shift down">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
      <span>Lower</span>
    </button>

    <button class="ca-tool-btn" data-ca-btn-higher title="Shift up">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      <span>Higher</span>
    </button>

    <button class="ca-tool-btn ca-tool-btn--play" data-ca-btn-play title="Play chord (requires Web Audio)">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
      <span>Play</span>
    </button>

    <button class="ca-tool-btn" data-ca-btn-create title="Create chord from current fingering">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
      <span>Create</span>
    </button>
  </div>

  <!-- ── Chord names ────────────────────────────────────── -->
  <div class="ca-results">
    <h2 class="ca-results-heading">Possible Chord Names</h2>
    <div class="ca-results-grid" data-ca-results>
      <p class="ca-results-empty">Select notes on the fretboard…</p>
    </div>
  </div>
  </div>
  <!-- End collapsible content -->

</section>

<!-- ════════════════════════════════════════════════════════
     STYLES
════════════════════════════════════════════════════════ -->
<style>
  /* ── Tokens ───────────────────────────────────────────── */
  .ca-wrap {
    --ca-bg:        #1a1508;
    --ca-surface:   #221c0a;
    --ca-border:    #3a300f;
    --ca-gold:      #c8922a;
    --ca-gold-dim:  #7a5714;
    --ca-amber:     #e8a030;
    --ca-text:      #d4bb88;
    --ca-text-dim:  #7a6a44;
    --ca-major:     var(--chord-major, #3b82f6);
    --ca-minor:     var(--chord-minor, #ef4444);
    --ca-dot-open:  #c8922a;   /* open-string indicator */
    --ca-dot-fret:  #c8922a;   /* fretted note */
    --ca-dot-root:  #e8a030;   /* root note ring */
    --ca-string:    #3a300f;
    --ca-fret-line: #2e2508;
    --ca-radius:    6px;
    --ca-font:      "Courier New", "Courier", monospace;
    --ca-fret-w:    42px;
    --ca-string-h:  36px;
    --ca-dot-size:  26px;

    font-family:    var(--ca-font);
    background:     var(--ca-bg);
    border:         1px solid var(--ca-border);
    border-radius:  var(--ca-radius);
    padding:        0;
    color:          var(--ca-text);
    max-width:      1200px;
    overflow:       hidden;
  }

  /* ── Header ───────────────────────────────────────────── */
  .ca-header {
    display:         flex;
    align-items:     center;
    justify-content: space-between;
    padding:         14px 20px 10px;
    border-bottom:   1px solid var(--ca-border);
  }

  .ca-header-buttons {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .ca-chord-name {
    font-size:   1.5rem;
    font-weight: 700;
    letter-spacing: .03em;
    color:       var(--ca-amber);
    min-width:   120px;
  }

  .ca-chord-root sup { font-size: .6em; vertical-align: super; }

  .ca-tuning {
    display:        flex;
    flex-direction: column;
    align-items:    center;
    gap:            2px;
  }
  .ca-tuning-notes {
    font-size:     1rem;
    letter-spacing:.2em;
    color:         var(--ca-text);
  }
  .ca-tuning-label {
    font-size:  .7rem;
    color:      var(--ca-text-dim);
    letter-spacing: .1em;
  }

  .ca-reset-btn {
    background: transparent;
    border:     1px solid var(--ca-border);
    border-radius: 50%;
    color:      var(--ca-text-dim);
    width:      36px;
    height:     36px;
    display:    flex;
    align-items: center;
    justify-content: center;
    cursor:     pointer;
    transition: color .15s, border-color .15s;
  }
  .ca-reset-btn:hover { color: var(--ca-amber); border-color: var(--ca-gold); }

  .ca-toggle-btn {
    background: transparent;
    border:     1px solid var(--ca-border);
    border-radius: 50%;
    color:      var(--ca-text-dim);
    width:      36px;
    height:     36px;
    display:    flex;
    align-items: center;
    justify-content: center;
    cursor:     pointer;
    transition: color .15s, border-color .15s, transform .15s;
  }
  .ca-toggle-btn:hover { color: var(--ca-amber); border-color: var(--ca-gold); }
  .ca-toggle-btn[aria-expanded="false"] {
    transform: rotate(180deg);
  }

  .ca-content {
    transition: max-height 0.3s ease-out, opacity 0.3s ease-out;
    max-height: 2000px;
    opacity: 1;
    overflow: hidden;
  }
  .ca-content--collapsed {
    max-height: 0;
    opacity: 0;
  }

  /* ── Fretboard wrap ───────────────────────────────────── */
  .ca-fretboard-wrap {
    padding:    14px 16px 0;
    display:    flex;
    flex-direction: column;
    align-items: center;
  }

  /* Row that holds the toggle column + grid side-by-side */
  .ca-fretboard-row {
    display:     flex;
    align-items: stretch;
    justify-content: center;
    width: 100%;
  }

  /* Row that holds the spacer + fret number strip */
  .ca-fret-numbers-row {
    display:        flex;
    align-items:    flex-start;
    margin-top:     4px;
    padding-bottom: 12px;
    justify-content: center;
    width: 100%;
  }

  /* ── Fretboard grid ───────────────────────────────────── */
  .ca-fretboard {
    display:               grid;
    /* 6 rows (strings), 17 cols (fret 0..15 + R label) */
    grid-template-columns: repeat(17, var(--ca-fret-w));
    grid-template-rows:    repeat(6, var(--ca-string-h));
    position:              relative;
    /* +4px accounts for 2px border on each side so it won't get clipped */
    width:                 calc(17 * var(--ca-fret-w) + 4px);
    height:                calc(6 * var(--ca-string-h) + 4px);
    border:                2px solid var(--ca-gold);
    box-sizing:            border-box;
    background-color:      var(--ca-bg);
    background-image:
      /* vertical fret lines */
      repeating-linear-gradient(
        to right,
        transparent,
        transparent calc(var(--ca-fret-w) - 2px),
        var(--ca-fret-line) calc(var(--ca-fret-w) - 2px),
        var(--ca-fret-line) var(--ca-fret-w)
      ),
      /* horizontal string lines */
      repeating-linear-gradient(
        to bottom,
        transparent,
        transparent calc((var(--ca-string-h) / 2) - 1px),
        var(--ca-string) calc((var(--ca-string-h) / 2) - 1px),
        var(--ca-string) calc((var(--ca-string-h) / 2) + 1px),
        transparent calc((var(--ca-string-h) / 2) + 1px),
        transparent var(--ca-string-h)
      );
    gap:                   0;
  }

  /* String lines (horizontal pseudo-elements drawn on each row cell) */
  :global(.ca-cell) {
    position:        relative;
    display:         flex;
    align-items:     center;
    justify-content: center;
    cursor:          pointer;
    transition:      background .1s;
    background:      transparent;
    border:         none;
    box-sizing:     border-box;
    width:          var(--ca-fret-w);
    height:         var(--ca-string-h);
  }
  :global(.ca-cell):hover {
    background: rgba(200,146,42,0.1);
  }

  /* Nut (fret 0) gets a thicker line on the right */
  :global(.ca-cell--nut) {
    border-right: 3px solid var(--ca-text-dim);
  }

  /* R-label column — not clickable */
  :global(.ca-cell--r-label) {
    cursor:   default;
    font-size:.65rem;
    color:    var(--ca-text-dim);
    font-weight: 700;
    letter-spacing: .05em;
    background: var(--ca-surface);
  }
  :global(.ca-cell--r-label)::before { display: none; }
  :global(.ca-cell--r-label)::after  { display: none; }

  /* Dot (fingered note) */
  :global(.ca-dot) {
    width:         var(--ca-dot-size);
    height:        var(--ca-dot-size);
    border-radius: 50%;
    background:    var(--ca-dot-fret);
    position:      absolute;
    display:       flex;
    align-items:   center;
    justify-content: center;
    font-size:     1rem;
    font-weight:   900;
    color:         var(--ca-bg);
    pointer-events: none;
    z-index:       2;
    transition:    transform .1s;
  }
  :global(.ca-dot--root) {
    background: var(--ca-bg);
    border:     2.5px solid var(--ca-amber);
    color:      var(--ca-amber);
  }
  :global(.ca-dot--third-major) {
    background: color-mix(in srgb, var(--ca-major) 14%, transparent);
    border:     2px solid color-mix(in srgb, var(--ca-major) 70%, transparent);
    color:      color-mix(in srgb, var(--ca-major) 88%, white);
  }
  :global(.ca-dot--third-minor) {
    background: color-mix(in srgb, var(--ca-minor) 14%, transparent);
    border:     2px solid color-mix(in srgb, var(--ca-minor) 70%, transparent);
    color:      color-mix(in srgb, var(--ca-minor) 88%, white);
  }
  :global(.ca-dot--fifth) {
    background: var(--ca-bg);
    border:     2px solid rgba(255, 255, 255, 0.75);
    color:      rgba(30, 255, 0, 0.95);
  }

  :global(.ca-nut-indicator) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 999px;
    font-weight: 700;
    font-size: .65rem;
    line-height: 1;
    pointer-events: none;
  }
  :global(.ca-nut-indicator--open) {
    border: 2px solid var(--ca-gold);
    background: transparent;
  }
  :global(.ca-nut-indicator--muted) {
    border: 1.5px solid var(--ca-text-dim);
    color: var(--ca-text-dim);
    background: rgba(0,0,0,0.15);
  }
  /* Position label inside dot (note name) */
  :global(.ca-dot__label) {
    font-size:  .75rem;
    font-weight: 900;
    line-height: 1;
    sup { font-size: .5rem; vertical-align: super; }
  }

  /* Fret position dots (visual guides on the board) */
  :global(.ca-position-dot) {
    width:         7px;
    height:        7px;
    border-radius: 50%;
    background:    var(--ca-fret-line);
    position:      absolute;
    bottom:        3px;
    left:          50%;
    transform:     translateX(-50%);
    pointer-events: none;
  }

  /* Fret numbers row */
  :global(.ca-fret-numbers) {
    display: flex;
  }
  :global(.ca-fret-num) {
    width:       var(--ca-fret-w);
    flex-shrink: 0;
    text-align:  center;
    font-size:   .65rem;
    color:       var(--ca-text-dim);
    line-height: 1;
  }
  :global(.ca-fret-num--highlight) { color: var(--ca-text); }

  /* ── Toolbar ──────────────────────────────────────────── */
  .ca-toolbar {
    display:         flex;
    align-items:     stretch;
    border-top:      1px solid var(--ca-border);
    border-bottom:   1px solid var(--ca-border);
    margin-top:      12px;
  }

  .ca-tool-btn {
    flex:            1;
    display:         flex;
    flex-direction:  column;
    align-items:     center;
    justify-content: center;
    gap:             4px;
    padding:         10px 4px;
    background:      transparent;
    border:          none;
    border-right:    1px solid var(--ca-border);
    color:           var(--ca-text-dim);
    cursor:          pointer;
    font-family:     var(--ca-font);
    font-size:       .62rem;
    letter-spacing:  .08em;
    text-transform:  uppercase;
    transition:      color .12s, background .12s;
  }
  .ca-tool-btn:last-child { border-right: none; }
  .ca-tool-btn:hover     { color: var(--ca-amber); background: rgba(200,146,42,.06); }
  .ca-tool-btn--active   { color: var(--ca-amber); }
  .ca-tool-btn--play     { color: var(--ca-gold); }
  .ca-tool-btn--play:hover { color: var(--ca-amber); }

  /* ── Results ──────────────────────────────────────────── */
  .ca-results {
    padding: 16px 20px 20px;
  }
  .ca-results-heading {
    font-size:      .7rem;
    letter-spacing: .15em;
    text-transform: uppercase;
    color:          var(--ca-text-dim);
    margin:         0 0 12px;
    font-weight:    400;
  }
  .ca-results-grid {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   6px;
  }
  :global(.ca-results-empty) {
    grid-column: 1 / -1;
    color:       var(--ca-text-dim);
    font-size:   .8rem;
    margin:      0;
  }
  :global(.ca-chord-pill) {
    background:    var(--ca-surface);
    border:        1px solid var(--ca-border);
    border-radius: var(--ca-radius);
    padding:       10px 14px;
    font-size:     .95rem;
    color:         var(--ca-text);
    cursor:        default;
    transition:    border-color .12s;
  }
  :global(.ca-chord-pill):hover  { border-color: var(--ca-gold); }
  :global(.ca-chord-pill--primary) {
    grid-column: 1 / -1;
    border-color: var(--ca-gold);
    color:        var(--ca-amber);
    font-size:    1.05rem;
  }
</style>

<!-- ════════════════════════════════════════════════════════
     SCRIPT
════════════════════════════════════════════════════════ -->
<script>
/**
 * ─────────────────────────────────────────────────────────
 *  CHORD ANALYSER — vanilla TypeScript (compiled by Astro)
 *
 *  Wrapped in a DOMContentLoaded listener so the script is
 *  safe to bundle. All DOM queries are scoped to the
 *  component root ([data-chord-analyser]) so multiple
 *  instances on one page won't collide.
 * ─────────────────────────────────────────────────────────
 */

document.addEventListener("DOMContentLoaded", () => {

/**
 * Finds the nearest [data-chord-analyser] root and initialises
 * one independent analyser instance inside it.
 * Called once per component mount.
 */
function initChordAnalyser(root: HTMLElement): void {

// ── Types ──────────────────────────────────────────────────────────────────

/** Chromatic pitch class 0–11 (C=0, C#=1, … B=11) */
type PC = number;

/** State of one string head button */
type StringState = "open" | "muted";

/** One entry in the chord-formula dictionary */
interface ChordType {
  name: string;
  /** Interval set relative to root, as pitch-class offsets */
  intervals: number[];
}

// ── Constants ──────────────────────────────────────────────────────────────

const STRINGS        = 6;
const FRETS_VISIBLE  = 16; // frets 0–15
const TOTAL_COLS     = FRETS_VISIBLE + 1; // +1 for the R-label column

/** Standard tuning, index 0 = low E (string 6), index 5 = high e (string 1) */
const OPEN_TUNING_PC: PC[] = [4, 9, 2, 7, 11, 4]; // E A D G B E

/** Note names (prefer sharps; enharmonic shown on request) */
const NOTE_NAMES = ["C","C#","D","D#","E","F","F#","G","G#","A","A#","B"];

/** Fret positions that get a visual marker dot */
const POSITION_DOT_FRETS = new Set([3, 5, 7, 9, 12, 15]);

/** Chord formulas: intervals from root (semitones), name suffix */
const CHORD_TYPES: ChordType[] = [
  { name: "",            intervals: [0,4,7] },
  { name: "m",           intervals: [0,3,7] },
  { name: "5",           intervals: [0,7] },
  { name: "7",           intervals: [0,4,7,10] },
  { name: "maj7",        intervals: [0,4,7,11] },
  { name: "m7",          intervals: [0,3,7,10] },
  { name: "m(maj7)",     intervals: [0,3,7,11] },
  { name: "dim",         intervals: [0,3,6] },
  { name: "dim7",        intervals: [0,3,6,9] },
  { name: "aug",         intervals: [0,4,8] },
  { name: "aug7",        intervals: [0,4,8,10] },
  { name: "sus2",        intervals: [0,2,7] },
  { name: "sus4",        intervals: [0,5,7] },
  { name: "7sus2",       intervals: [0,2,7,10] },
  { name: "7sus4",       intervals: [0,5,7,10] },
  { name: "add9",        intervals: [0,4,7,14] },
  { name: "m(add9)",     intervals: [0,3,7,14] },
  { name: "add11",       intervals: [0,4,7,17] },
  { name: "m(add11)",    intervals: [0,3,7,17] },
  { name: "6",           intervals: [0,4,7,9] },
  { name: "m6",          intervals: [0,3,7,9] },
  { name: "6/9",         intervals: [0,4,7,9,14] },
  { name: "9",           intervals: [0,4,7,10,14] },
  { name: "maj9",        intervals: [0,4,7,11,14] },
  { name: "m9",          intervals: [0,3,7,10,14] },
  { name: "11",          intervals: [0,4,7,10,14,17] },
  { name: "maj11",       intervals: [0,4,7,11,14,17] },
  { name: "m11",         intervals: [0,3,7,10,14,17] },
  { name: "13",          intervals: [0,4,7,10,14,17,21] },
  { name: "maj13",       intervals: [0,4,7,11,14,17,21] },
  { name: "m13",         intervals: [0,3,7,10,14,17,21] },
  { name: "7b9",         intervals: [0,4,7,10,13] },
  { name: "7#9",         intervals: [0,4,7,10,15] },
  { name: "7b5",         intervals: [0,4,6,10] },
  { name: "7#5",         intervals: [0,4,8,10] },
  { name: "susb13",      intervals: [0,5,7,8] },
];

// ── State ──────────────────────────────────────────────────────────────────

/** fretted[stringIdx][fretIdx] = true if that cell is pressed */
let fretted: boolean[][] = Array.from({ length: STRINGS }, () =>
  new Array(FRETS_VISIBLE).fill(false)
);

/** State of the string-head button for each string */
let stringStates: StringState[] = Array(STRINGS).fill("muted");

/** Whether to show note names inside fret dots */
let showNotes = true;

/** Which pitch class is forced as root (null = auto-detect lowest) */
let forcedRoot: PC | null = null;

// ── DOM references (scoped to this component root) ────────────────────────

/**
 * Helper that queries within the component root and throws if not found,
 * making missing-element bugs immediately obvious.
 */
function q<T extends HTMLElement>(sel: string): T {
  const el = root.querySelector<T>(sel);
  if (!el) throw new Error(`ChordAnalyser: element not found: ${sel}`);
  return el;
}

const fretboardEl = q<HTMLDivElement>("[data-ca-fretboard]");
const fretNumsEl  = q<HTMLDivElement>("[data-ca-fret-numbers]");
const resultsEl   = q<HTMLDivElement>("[data-ca-results]");
const chordNameEl = q<HTMLDivElement>("[data-ca-chord-name]");
const btnNotes    = q<HTMLButtonElement>("[data-ca-btn-notes]");
const btnRoot     = q<HTMLButtonElement>("[data-ca-btn-root]");
const btnLower    = q<HTMLButtonElement>("[data-ca-btn-lower]");
const btnHigher   = q<HTMLButtonElement>("[data-ca-btn-higher]");
const btnPlay     = q<HTMLButtonElement>("[data-ca-btn-play]");
const btnCreate   = q<HTMLButtonElement>("[data-ca-btn-create]");
const btnReset    = q<HTMLButtonElement>("[data-ca-btn-reset]");
const btnToggle   = q<HTMLButtonElement>("[data-ca-btn-toggle]");
const contentEl   = q<HTMLDivElement>("[data-ca-content]");

// ── Utility helpers ────────────────────────────────────────────────────────

/**
 * Returns the pitch class of a given string + fret combination,
 * accounting for the current fret window offset.
 *
 * @param stringIdx - 0 = low E, 5 = high e
 * @param fretIdx   - 0 = first visible fret
 */
function pitchClass(stringIdx: number, fretIdx: number): PC {
  return (OPEN_TUNING_PC[stringIdx] + fretIdx) % 12;
}

/**
 * Returns the note name for a pitch class.
 * Uses superscript HTML for accidentals.
 *
 * @param pc - pitch class 0–11
 */
function noteName(pc: PC): string {
  return NOTE_NAMES[pc];
}

/**
 * Collects all currently sounding pitch classes as a Set.
 * Open strings contribute their open pitch; fretted cells contribute
 * their fretted pitch; muted/silent strings are excluded.
 */
function soundingPCs(): Set<PC> {
  const pcs = new Set<PC>();

  for (let s = 0; s < STRINGS; s++) {
    if (stringStates[s] === "muted") continue;

    // Check if any fret is pressed on this string
    let frettedFret: number | null = null;
    for (let f = 0; f < FRETS_VISIBLE; f++) {
      if (fretted[s][f]) { frettedFret = f; break; }
    }

    if (frettedFret !== null) {
      pcs.add(pitchClass(s, frettedFret));
    } else if (stringStates[s] === "open") {
      pcs.add(OPEN_TUNING_PC[s]);
    }
  }

  return pcs;
}

/**
 * Finds the lowest-sounding MIDI note currently active (for bass-note detection).
 * Returns null if nothing is sounding.
 */
function lowestMidiNote(): number | null {
  let lowest: number | null = null;

  for (let s = 0; s < STRINGS; s++) {
    if (stringStates[s] === "muted") continue;

    let frettedFret: number | null = null;
    for (let f = 0; f < FRETS_VISIBLE; f++) {
      if (fretted[s][f]) { frettedFret = f; break; }
    }

    /** Base MIDI note for each open string (low E = 40) */
    const BASE_MIDI = [40, 45, 50, 55, 59, 64];
    let midi: number;

    if (frettedFret !== null) {
      midi = BASE_MIDI[s] + frettedFret;
    } else if (stringStates[s] === "open") {
      midi = BASE_MIDI[s];
    } else {
      continue;
    }

    if (lowest === null || midi < lowest) lowest = midi;
  }

  return lowest;
}

// ── Chord matching ─────────────────────────────────────────────────────────

interface MatchedChord {
  root: PC;
  type: ChordType;
  bassNote: PC | null; /** null = root is the bass */
  score: number;       /** higher = better match */
}

function intervalLabel(semitones: number): string {
  const s = ((semitones % 12) + 12) % 12;
  if (s === 0) return "R";
  if (s === 1) return "b2";
  if (s === 2) return "2";
  if (s === 3) return "b3";
  if (s === 4) return "3";
  if (s === 5) return "4";
  if (s === 6) return "b5";
  if (s === 7) return "5";
  if (s === 8) return "#5";
  if (s === 9) return "6";
  if (s === 10) return "b7";
  return "7";
}

function currentRootPc(): PC | null {
  if (forcedRoot !== null) return forcedRoot;
  const matches = matchChords(soundingPCs());
  return matches.length > 0 ? matches[0].root : null;
}

/**
 * Matches the currently sounding pitch-class set against the chord dictionary.
 * Tries every pitch class as a potential root and returns all exact matches,
 * sorted by score (closeness of match, number of notes, etc.).
 *
 * @param pcs - set of sounding pitch classes
 */
function matchChords(pcs: Set<PC>): MatchedChord[] {
  if (pcs.size < 2) return [];

  const pcArray = Array.from(pcs);
  const results: MatchedChord[] = [];

  const lowestMidi = lowestMidiNote();
  const bassPc = lowestMidi !== null ? lowestMidi % 12 : null;

  for (let root = 0; root < 12; root++) {
    for (const ct of CHORD_TYPES) {
      // Normalise formula intervals to pitch classes relative to root
      const formulaPCs = new Set(ct.intervals.map(i => (root + i) % 12));

      // Exact match: formula PCs === sounding PCs
      let match = true;
      if (formulaPCs.size !== pcs.size) continue;
      for (const pc of formulaPCs) {
        if (!pcs.has(pc)) { match = false; break; }
      }
      if (!match) continue;

      // Determine slash notation if bass isn't the root
      const slashNote = (bassPc !== null && bassPc !== root) ? bassPc : null;

      results.push({
        root,
        type: ct,
        bassNote: slashNote,
        score: ct.intervals.length,
      });
    }
  }

  // Sort: prefer root = bassPc first, then by formula length descending
  results.sort((a, b) => {
    const aRootIsBass = a.root === bassPc ? 0 : 1;
    const bRootIsBass = b.root === bassPc ? 0 : 1;
    if (aRootIsBass !== bRootIsBass) return aRootIsBass - bRootIsBass;
    return b.score - a.score;
  });

  return results;
}

/**
 * Formats a MatchedChord into an HTML string with superscript suffixes.
 *
 * @param chord - matched chord object
 */
function formatChordName(chord: MatchedChord): string {
  const root = NOTE_NAMES[chord.root];
  const type = chord.type.name;
  const slash = chord.bassNote !== null
    ? `/${NOTE_NAMES[chord.bassNote]}`
    : "";

  // Wrap numeric modifiers in <sup>
  const styledType = type
    .replace(/(\d+)/g, "<sup>$1</sup>")
    .replace(/([b#])(\d)/g, "<sup>$1$2</sup>");

  return `${root}${styledType}${slash}`;
}

// ── Render ─────────────────────────────────────────────────────────────────

/**
 * Full re-render of the fretboard grid.
 * Clears the grid and redraws every cell.
 */
function renderFretboard(): void {
  fretboardEl.innerHTML = "";

  const rootPcForLabels = currentRootPc();

  for (let s = STRINGS - 1; s >= 0; s--) {
    // Display strings high→low (high e at top = index 5, low E at bottom = index 0)
    const displayString = STRINGS - 1 - s; // row 0 = high e = stringIdx 5

    for (let col = 0; col < TOTAL_COLS; col++) {
      const cell = document.createElement("div");
      cell.className = "ca-cell";

      // R-label column (last column)
      if (col === FRETS_VISIBLE) {
        cell.classList.add("ca-cell--r-label");

        if (rootPcForLabels !== null) {
          let soundPc: number | null = null;
          for (let f = 1; f < FRETS_VISIBLE; f++) {
            if (fretted[s][f]) { soundPc = pitchClass(s, f); break; }
          }
          if (soundPc === null && stringStates[s] === "open") soundPc = OPEN_TUNING_PC[s];

          if (soundPc !== null) {
            const interval = (soundPc - rootPcForLabels + 12) % 12;
            cell.textContent = intervalLabel(interval);
          }
        }

        fretboardEl.appendChild(cell);
        continue;
      }

      const fretIdx = col;
      const isNut   = fretIdx === 0;
      if (isNut) cell.classList.add("ca-cell--nut");

      // Position guide dots
      const actualFret = fretIdx;
      if (POSITION_DOT_FRETS.has(actualFret) && displayString === 2) {
        const dot = document.createElement("span");
        dot.className = "ca-position-dot";
        cell.appendChild(dot);
      }

      // Nut cell controls open/muted
      if (fretIdx === 0) {
        let hasFrettedNote: boolean = false;
        for (let f = 1; f < FRETS_VISIBLE; f++) {
          if (fretted[s][f]) { hasFrettedNote = true; break; }
        }

        if (stringStates[s] === "open") {
          if (!hasFrettedNote) {
            const openEl = document.createElement("span");
            openEl.className = "ca-nut-indicator ca-nut-indicator--open";
            openEl.innerHTML = noteName(OPEN_TUNING_PC[s]);
            cell.appendChild(openEl);
          }
        } else {
          const mutedEl = document.createElement("span");
          mutedEl.className = "ca-nut-indicator ca-nut-indicator--muted";
          mutedEl.textContent = "×";
          cell.appendChild(mutedEl);
        }

        const capturedS = s;
        cell.addEventListener("click", () => {
          cycleNutState(capturedS);
        });

        fretboardEl.appendChild(cell);
        continue;
      }

      // Note at this cell
      const pc = pitchClass(s, fretIdx);

      if (fretted[s][fretIdx]) {
        const rootPc  = rootPcForLabels;
        const interval = rootPc !== null ? (pc - rootPc + 12) % 12 : null;
        const isRoot  = rootPc !== null && interval === 0;
        const isThirdMajor = interval !== null && interval === 4;
        const isThirdMinor = interval !== null && interval === 3;
        const isFifth = interval !== null && interval === 7;

        const dotEl = document.createElement("span");
        dotEl.className = isRoot
          ? "ca-dot ca-dot--root"
          : isThirdMajor
            ? "ca-dot ca-dot--third-major"
            : isThirdMinor
              ? "ca-dot ca-dot--third-minor"
            : isFifth
              ? "ca-dot ca-dot--fifth"
              : "ca-dot";

        if (showNotes) {
          const labelEl = document.createElement("span");
          labelEl.className = "ca-dot__label";
          labelEl.innerHTML = noteName(pc);
          dotEl.appendChild(labelEl);
        }

        cell.appendChild(dotEl);
      }

      // Click handler: toggle fret
      const capturedS = s;
      const capturedF = fretIdx;
      cell.addEventListener("click", () => {
        toggleFret(capturedS, capturedF);
      });

      fretboardEl.appendChild(cell);
    }
  }

  renderFretNumbers();
  renderResults();
}

/**
 * Re-renders the fret-number row below the fretboard.
 */
function renderFretNumbers(): void {
  fretNumsEl.innerHTML = "";

  for (let col = 0; col < TOTAL_COLS; col++) {
    const numEl = document.createElement("div");
    numEl.className = "ca-fret-num";

    if (col === FRETS_VISIBLE) {
      numEl.textContent = "R";
    } else {
      const actualFret = col;
      numEl.textContent = actualFret === 0 ? "" : String(actualFret);
      if (POSITION_DOT_FRETS.has(actualFret)) {
        numEl.classList.add("ca-fret-num--highlight");
      }
    }

    fretNumsEl.appendChild(numEl);
  }
}

/**
 * Re-renders the chord-name result pills.
 */
function renderResults(): void {
  resultsEl.innerHTML = "";

  const pcs     = soundingPCs();
  const matches = matchChords(pcs);

  if (matches.length === 0) {
    const empty = document.createElement("p");
    empty.className = "ca-results-empty";
    empty.textContent = pcs.size < 2
      ? "Select notes on the fretboard…"
      : "No matching chord found.";
    resultsEl.appendChild(empty);
    chordNameEl.innerHTML = "<span class='ca-chord-root'>—</span>";
    return;
  }

  // Update header chord name
  chordNameEl.innerHTML = formatChordName(matches[0]);

  matches.slice(0, 6).forEach((m, i) => {
    const pill = document.createElement("div");
    pill.className = i === 0 ? "ca-chord-pill ca-chord-pill--primary" : "ca-chord-pill";
    pill.innerHTML = formatChordName(m);
    resultsEl.appendChild(pill);
  });
}

// ── State mutations ────────────────────────────────────────────────────────

/**
 * Toggles a fret cell on/off.
 * Only one fret per string may be active at a time.
 * Activating a fret also sets the string to "open" if it was silent.
 *
 * @param stringIdx - 0 = low E, 5 = high e
 * @param fretIdx   - 0–15 (within the visible window)
 */
function toggleFret(stringIdx: number, fretIdx: number): void {
  if (fretIdx === 0) return;
  const wasOn = fretted[stringIdx][fretIdx];

  // Clear all frets on this string
  fretted[stringIdx].fill(false);

  if (!wasOn) {
    fretted[stringIdx][fretIdx] = true;
    stringStates[stringIdx] = "open";
  } else {
    // If no fret is pressed and string was open, keep it open (open string)
  }

  renderFretboard();
}

/**
 * Cycles a string's state: silent → open → muted → silent.
 *
 * @param stringIdx - 0 = low E, 5 = high e
 */
function cycleNutState(stringIdx: number): void {
  fretted[stringIdx].fill(false);
  stringStates[stringIdx] = stringStates[stringIdx] === "open" ? "muted" : "open";
  renderFretboard();
}

function shiftFingering(delta: number): void {
  for (let s = 0; s < STRINGS; s++) {
    let current: number | null = null;
    for (let f = 1; f < FRETS_VISIBLE; f++) {
      if (fretted[s][f]) { current = f; break; }
    }
    if (current === null) continue;

    const next = current + delta;
    fretted[s].fill(false);
    if (next >= 1 && next < FRETS_VISIBLE) {
      fretted[s][next] = true;
      stringStates[s] = "open";
    }
  }
  renderFretboard();
}

/**
 * Resets the entire fretboard to a blank state.
 */
function resetBoard(): void {
  fretted       = Array.from({ length: STRINGS }, () => new Array(FRETS_VISIBLE).fill(false));
  stringStates  = Array(STRINGS).fill("muted");
  forcedRoot    = null;
  renderFretboard();
}

/**
 * Extracts the current chord state for use with the create form.
 */
function getCurrentChordState(): {
  displayName: string;
  frets: number[];
  notes: string[];
  alternateNames: string[];
} | null {
  const pcs = soundingPCs();
  const matches = matchChords(pcs);
  
  if (matches.length === 0) return null;
  
  const displayName = formatChordName(matches[0]).replace(/<[^>]*>/g, ""); // strip HTML tags
  
  // Build frets array (low E to high E)
  const frets: number[] = [];
  const notes: string[] = [];
  const BASE_MIDI = [40, 45, 50, 55, 59, 64];
  const OPEN_TUNING_PC: PC[] = [4, 9, 2, 7, 11, 4]; // E A D G B E
  
  for (let s = 0; s < STRINGS; s++) {
    let fret: number | null = null;
    let note: string = "x";
    
    // Check if any fret is pressed on this string
    for (let f = 1; f < FRETS_VISIBLE; f++) {
      if (fretted[s][f]) {
        fret = f;
        const pc = pitchClass(s, f);
        note = noteName(pc);
        break;
      }
    }
    
    // If no fret pressed, check if string is open
    if (fret === null && stringStates[s] === "open") {
      fret = 0;
      note = noteName(OPEN_TUNING_PC[s]);
    }
    
    // If still nothing, mark as muted
    if (fret === null) {
      fret = -1;
      note = "x";
    }
    
    frets.push(fret);
    notes.push(note);
  }
  
  // Collect alternate names from all matches (excluding the primary)
  const alternateNames = matches.slice(1)
    .map(m => formatChordName(m).replace(/<[^>]*>/g, "")) // strip HTML tags
    .filter((name, index, arr) => arr.indexOf(name) === index); // remove duplicates
  
  return { displayName, frets, notes, alternateNames };
}

/**
 * Plays the currently selected chord using the Web Audio API.
 * Uses simple sine-wave oscillators with a short attack/decay envelope.
 * Falls back silently if AudioContext is unavailable.
 */
function playChord(): void {
  const AudioCtx = window.AudioContext ?? (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
  if (!AudioCtx) return;

  const ctx = new AudioCtx();
  const now = ctx.currentTime;

  /** Base MIDI note for each open string (low E = 40) */
  const BASE_MIDI = [40, 45, 50, 55, 59, 64];

  for (let s = 0; s < STRINGS; s++) {
    if (stringStates[s] === "muted") continue;

    let midi: number | null = null;

    for (let f = 0; f < FRETS_VISIBLE; f++) {
      if (fretted[s][f]) {
        midi = BASE_MIDI[s] + f;
        break;
      }
    }

    if (midi === null && stringStates[s] === "open") {
      midi = BASE_MIDI[s];
    }

    if (midi === null) continue;

    const freq = 440 * Math.pow(2, (midi - 69) / 12);
    const delay = (STRINGS - 1 - s) * 0.04; // strum effect

    const osc  = ctx.createOscillator();
    const gain = ctx.createGain();

    osc.type = "triangle";
    osc.frequency.setValueAtTime(freq, now + delay);

    gain.gain.setValueAtTime(0, now + delay);
    gain.gain.linearRampToValueAtTime(0.18, now + delay + 0.02);
    gain.gain.exponentialRampToValueAtTime(0.001, now + delay + 1.8);

    osc.connect(gain);
    gain.connect(ctx.destination);

    osc.start(now + delay);
    osc.stop(now + delay + 2);
  }
}

// ── Toolbar bindings ───────────────────────────────────────────────────────

btnNotes.addEventListener("click", () => {
  showNotes = !showNotes;
  btnNotes.classList.toggle("ca-tool-btn--active", showNotes);
  renderFretboard();
});

btnRoot.addEventListener("click", () => {
  // Cycle forced root through sounding PCs, then null
  const pcs = Array.from(soundingPCs()).sort();
  if (pcs.length === 0) return;

  if (forcedRoot === null) {
    forcedRoot = pcs[0];
  } else {
    const idx = pcs.indexOf(forcedRoot);
    forcedRoot = idx >= 0 && idx < pcs.length - 1 ? pcs[idx + 1] : null;
  }

  btnRoot.classList.toggle("ca-tool-btn--active", forcedRoot !== null);
  renderFretboard();
});

btnLower.addEventListener("click", () => {
  shiftFingering(-1);
});

btnHigher.addEventListener("click", () => {
  shiftFingering(1);
});

btnPlay.addEventListener("click", playChord);

btnCreate.addEventListener("click", () => {
  const state = getCurrentChordState();
  if (state) {
    root.dispatchEvent(new CustomEvent("chord:create", { 
      detail: state,
      bubbles: true
    }));
  }
});

btnReset.addEventListener("click", resetBoard);

btnToggle.addEventListener("click", () => {
  const isExpanded = btnToggle.getAttribute("aria-expanded") === "true";
  const newExpanded = !isExpanded;
  
  btnToggle.setAttribute("aria-expanded", String(newExpanded));
  contentEl.classList.toggle("ca-content--collapsed", !newExpanded);
});

// ── Init ───────────────────────────────────────────────────────────────────

// Set initial UI state for buttons
btnNotes.classList.toggle("ca-tool-btn--active", showNotes);
btnRoot.classList.toggle("ca-tool-btn--active", forcedRoot !== null);

renderFretboard();

} // end initChordAnalyser

// Boot every instance on the page
document.querySelectorAll<HTMLElement>("[data-chord-analyser]").forEach(initChordAnalyser);

}); // end DOMContentLoaded
</script>