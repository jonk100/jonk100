---
export type Props = {
  /** Optional prefill values */
  initial?: {
    slug?: string;
    displayName?: string;
    voicingLabel?: string;
    baseFret?: number;
    fingering?: number[];
    frets?: number[];
    notes?: string[];
    barre?: { finger: number; fret: number; strings: [number, number] };
    alternateNames?: string[];
    enharmonic?: string;
  };
};

const { initial } = Astro.props as Props;

const initialSlug = initial?.slug ?? "";
const initialDisplayName = initial?.displayName ?? "";
const initialVoicingLabel = initial?.voicingLabel ?? "";
const initialBaseFret = initial?.baseFret ?? 1;

const initialFingering = JSON.stringify(initial?.fingering ?? [0, 0, 0, 0, 0, 0]);
const initialFrets = JSON.stringify(initial?.frets ?? [-1, -1, -1, -1, -1, -1]);
const initialNotes = JSON.stringify(initial?.notes ?? ["x", "x", "x", "x", "x", "x"]);

const initialBarre = initial?.barre ? JSON.stringify(initial.barre) : "";
const initialAlternateNames = initial?.alternateNames ? JSON.stringify(initial.alternateNames) : "";
const initialEnharmonic = initial?.enharmonic ?? "";
---

<section class="create">
  <details>
    <summary class="create-summary">
      <div class="create-summary-content">
        <button class="create-reset-btn" type="button" title="Reset form">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
            <path d="M3 3v5h5"/>
          </svg>
        </button>
        
        <span class="create-summary-text">Add a new chord voicing</span>
        
        <button class="create-toggle-btn" type="button" aria-expanded="false">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
      </div>
    </summary>

    <form id="chord-create-form" class="form">
      <div class="row">
        <label>
          <span>Slug</span>
          <input name="slug" type="text" required value={initialSlug} placeholder="am7-1" />
        </label>

        <label>
          <span>Display name</span>
          <input name="displayName" type="text" required value={initialDisplayName} placeholder="Am7" />
        </label>
      </div>

      <div class="row">
        <label class="grow">
          <span>Voicing label</span>
          <input
            name="voicingLabel"
            type="text"
            required
            value={initialVoicingLabel}
            placeholder="E-shape barre, 5th fret"
          />
        </label>

        <label>
          <span>Base fret</span>
          <input name="baseFret" type="number" min="1" step="1" required value={String(initialBaseFret)} />
        </label>
      </div>

      <div class="row">
        <label class="grow">
          <span>Fingering (JSON)</span>
          <input name="fingering" type="text" required value={initialFingering} />
        </label>
      </div>

      <div class="row">
        <label class="grow">
          <span>Frets (JSON)</span>
          <input name="frets" type="text" required value={initialFrets} />
        </label>
      </div>

      <div class="row">
        <label class="grow">
          <span>Notes (JSON, optional)</span>
          <input name="notes" type="text" value={initialNotes} />
        </label>
      </div>

      <div class="row">
        <label class="grow">
          <span>Barre (JSON, optional)</span>
          <input name="barre" type="text" value={initialBarre} placeholder='{"finger":1,"fret":5,"strings":[1,6]}' />
        </label>
      </div>

      <div class="row">
        <label class="grow">
          <span>Alternate names (JSON, optional)</span>
          <input name="alternateNames" type="text" value={initialAlternateNames} placeholder='["Amin"]' />
        </label>
      </div>

      <div class="row">
        <label class="grow">
          <span>Enharmonic (optional)</span>
          <input name="enharmonic" type="text" value={initialEnharmonic} placeholder="Bb" />
        </label>
      </div>

      <div class="actions">
        <button type="submit">Generate chord</button>
      </div>

      <p id="chord-create-status" class="status" aria-live="polite"></p>

      <label class="output">
        <span>Generated MDX</span>
        <textarea id="chord-create-output" rows="10" readonly></textarea>
      </label>
    </form>
  </details>
</section>

<script>
  const form = document.getElementById("chord-create-form") as HTMLFormElement;
  const statusEl = document.getElementById("chord-create-status") as HTMLParagraphElement;
  const outputEl = document.getElementById("chord-create-output") as HTMLTextAreaElement;
  const toggleBtn = document.querySelector(".create-toggle-btn") as HTMLButtonElement;
  const resetBtn = document.querySelector(".create-reset-btn") as HTMLButtonElement;
  const details = document.querySelector("details") as HTMLDetailsElement;

  // Handle custom toggle button
  if (toggleBtn && details) {
    toggleBtn.addEventListener("click", (e: Event) => {
      e.preventDefault();
      const isOpen = details.open;
      details.open = !isOpen;
      toggleBtn.setAttribute("aria-expanded", String(!isOpen));
    });

    // Update aria-expanded when details state changes
    details.addEventListener("toggle", () => {
      toggleBtn.setAttribute("aria-expanded", String(details.open));
    });

    // Set initial state
    toggleBtn.setAttribute("aria-expanded", String(details.open));
  }

  // Handle reset button
  if (resetBtn && form) {
    resetBtn.addEventListener("click", (e: Event) => {
      e.preventDefault();
      form.reset();
      setStatus("Form reset. All fields cleared.");
      
      // Clear output and status after a short delay
      setTimeout(() => {
        outputEl.value = "";
        setStatus("");
      }, 1500);
    });
  }

  const setStatus = (msg: string): void => {
    statusEl.textContent = msg;
  };

  form.addEventListener("submit", async (e: Event): Promise<void> => {
    e.preventDefault();

    outputEl.value = "";
    setStatus("Working...");

    const data = new FormData(form);

    try {
      const res = await fetch("/api/chords/create", {
        method: "POST",
        body: data,
      });

      const json = (await res.json()) as {
        ok: boolean;
        error?: string;
        wroteFile?: boolean;
        slug?: string;
        mdx?: string;
        filePath?: string;
      };

      if (!res.ok || !json.ok) {
        setStatus(json.error ?? "Request failed");
        return;
      }

      if (json.mdx) outputEl.value = json.mdx;

      if (json.wroteFile) {
        setStatus(`Wrote ${json.slug}.mdx. Restart dev server to see it in the collection.`);
      } else {
        setStatus(
          "Generated MDX (not written to disk). Set ALLOW_CHORD_WRITE=true to enable saving."
        );
      }
    } catch (err) {
      const msg = err instanceof Error ? err.message : String(err);
      setStatus(msg);
    }
  });

  // Listen for chord:create events from ChordAnalyser
  document.addEventListener("chord:create", (e: Event) => {
    const customEvent = e as CustomEvent<{ displayName: string; frets: number[]; notes: string[]; alternateNames: string[] }>;
    const { displayName, frets, notes, alternateNames } = customEvent.detail;

    // Prefill form fields
    const displayNameField = form.querySelector<HTMLInputElement>('input[name="displayName"]');
    const fretsField = form.querySelector<HTMLInputElement>('input[name="frets"]');
    const notesField = form.querySelector<HTMLInputElement>('input[name="notes"]');
    const alternateNamesField = form.querySelector<HTMLInputElement>('input[name="alternateNames"]');

    if (displayNameField) displayNameField.value = displayName;
    if (fretsField) fretsField.value = JSON.stringify(frets);
    if (notesField) notesField.value = JSON.stringify(notes);
    if (alternateNamesField && alternateNames.length > 0) {
      alternateNamesField.value = JSON.stringify(alternateNames);
    }

    // Generate a suggested slug
    const slugField = form.querySelector<HTMLInputElement>('input[name="slug"]');
    if (slugField && !slugField.value) {
      const base = displayName.toLowerCase().replace(/[^a-z0-9]/g, "");
      slugField.value = `${base}-0`;
    }

    // Auto-expand the details if collapsed
    const details = form.closest("details");
    if (details && !details.open) {
      details.open = true;
    }

    setStatus("Form prefilled from analyser. Adjust fields and submit to create.");
  });
</script>

<style>
  .create {
    margin-bottom: var(--space-8);
    border: 1px solid #3a300f;
    border-radius: 6px;
    background: #1a1508;
    color: #d4bb88;
    font-family: "Courier New", "Courier", monospace;
    overflow: hidden;
  }

  .create-summary {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 16px 6px;
    border-bottom: 1px solid #3a300f;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .create-summary::-webkit-details-marker {
    display: none;
  }

  .create-summary-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .create-summary-text {
    font-family: "Courier New", Courier, monospace;
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: .15em;
    color: #d4bb88;
    text-align: center;
    text-transform: uppercase;
    flex: 1;
  }

  .create-reset-btn {
    background: transparent;
    border: 1px solid #3a300f;
    border-radius: 50%;
    color: #7a6a44;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    flex-shrink: 0;
  }
  
  .create-reset-btn:hover {
    color: #e8a030;
    border-color: #c8922a;
  }

  .create-toggle-btn {
    background: transparent;
    border: 1px solid #3a300f;
    border-radius: 50%;
    color: #7a6a44;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, transform 0.15s;
    flex-shrink: 0;
  }
  
  .create-toggle-btn:hover {
    color: #e8a030;
    border-color: #c8922a;
  }
  
  details[open] .create-toggle-btn {
    transform: rotate(180deg);
  }

  .form {
    margin-top: var(--space-4);
    padding: 14px 20px 20px;
    display: grid;
    gap: var(--space-4);
    background: var(--surface-subtle);
    border-top: 1px solid #3a300f;
  }

  .row {
    display: flex;
    gap: var(--space-4);
    align-items: flex-end;
    flex-wrap: wrap;
  }

  label {
    display: grid;
    gap: var(--space-2);
    min-width: 220px;
  }

  .grow {
    flex: 1;
  }

  input,
  textarea {
    width: 100%;
    padding: 0.6rem 0.8rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  textarea {
    font-family: var(--font-mono);
    resize: vertical;
  }

  .actions {
    display: flex;
    gap: var(--space-3);
    align-items: center;
  }

  button {
    padding: 0.6rem 0.9rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--accent);
    color: white;
    font-weight: 700;
    cursor: pointer;
  }

  .status {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .output span {
    font-weight: 700;
  }
</style>
