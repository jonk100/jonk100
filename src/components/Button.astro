---
/**
 * src/components/Button.astro
 * Base button component with variant + size system.
 * - Delegates class merging to Astro's native class:list system
 * - Supports rendering as <button>, <a>, or <div> based on props
 * @props (local): href, theme, tone, size, as, type
 * @props (global): class, class:list, frame, effects
 * - theme: Visual style theme ('primary', 'secondary', etc.)
 * - tone: Specifies text color
 * - size: Button dimensions ('base', 'sm', 'lg', etc.)
 * - as: HTML tag to render
 */

import type { ComponentTheme, TextTone, Sizes, FrameVariant } from '../types/variants.types';
import Text from './ui/primitives/Text.astro';

type ElementTag = "button" | "a" | "div";

export interface Props {
  href?: string;
  label?: string;
  theme?: ComponentTheme;
  tone?: TextTone;
  size?: Sizes;
  frame?: FrameVariant;
  as?: ElementTag;
  type?: "button" | "submit" | "reset";
  class?: string;
  "class:list"?: Record<string, boolean>;
  [key: string]: any;
}

const {
  href,
  label,
  theme = "primary",
  tone,
  size = "base",
  frame = "none",
  as,
  type = "button",
  class: cls = "",
  "class:list": classList = {},
  ...rest
} = Astro.props;

const Tag = as || (href ? "a" : "button");

const classes = [
  "control", 
  `variant--${theme}`, 
  tone ? `text--${tone}` : '',
  `control--${size}`, 
  frame !== 'none' ? `frame-variant--${frame}` : '',
  cls
]
  .filter(Boolean)
  .join(" ");

const tagProps =
  Tag === "button"
    ? { type, class: classes, "class:list": classList, ...rest }
    : { href, class: classes, "class:list": classList, ...rest };
---

<Tag {...tagProps}>
  {label ? <Text as="span" type="label" tone={tone}>{label}</Text> : <slot />}
</Tag>