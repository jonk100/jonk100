---
/**
 * src/components/portfolio/ProjectCard.astro
 * Displays a single project summary as an interactive card.
 * - Highlights the project image with hover effects
 * - Shows project metadata like category, index, and tags
 * @props (local): title, description, category, index, tags, slug, imageSrc, delay
 * @props (global): class, class:list, frame, effects
 * - frame: Applies a specific frame style variant to the card
 * - effects: Applies single or multiple image effects to the card
 */
import type { FrameVariant, ComponentEffect } from 'src/types/variants.types';
import Paper from '../ui/primitives/Paper.astro';
import Stack from '../ui/layout/Stack.astro';
import Inline from '../ui/layout/Inline.astro';
import Text from '../ui/typography/Text.astro';
import Badge from '../ui/feedback/Badge.astro';
import Icon from '../ui/primitives/Icon.astro';
import Image from '../ui/primitives/Image.astro';
import Box from '../ui/layout/Box.astro';
import Card from '../ui/card/Card.astro';
import CardHeader from '../ui/card/CardHeader.astro';
import CardContent from '../ui/card/CardContent.astro';
import CardFooter from '../ui/card/CardFooter.astro';


export interface Props {
  title: string;
  description: string;
  category: string;
  index: string;
  tags: string[];
  slug: string;
  imageSrc?: string;
  class?: string;
  "class:list"?: Record<string, boolean> | any[];
  frame?: FrameVariant;
  effects?: ComponentEffect | ComponentEffect[];
  delay?: number;
  isFlagship?: boolean;
}

const { title, description, category, index, tags, slug, imageSrc, class: className = '', "class:list": classList = {}, frame, effects, delay = 0, isFlagship = false } = Astro.props;
---

<Card>
  <a href={`/projects/${slug}`} class="card-link" style={`animation-delay: ${delay}s;`}>
    <Paper padding="none" radius="lg" elevation="card" class:list={['project-card', className, classList, frame, effects]}>
      
      <div class="card-accent-bar"></div>
      {imageSrc && (
        <Box class="card-image-wrapper">
          <Image src={imageSrc} alt={title} class="card-image" radius="none" style={`view-transition-name: hero-${slug}`} />
          <div class="card-image-mask"></div>
        </Box>
      )}

      <Stack gap="sm" class="card-content">
        <Inline justify="between" align="center" class="card-head">
          <Text as="span" type="label" tone="subtle" class="card-tag">{category}</Text>
          <Text as="span" type="label" tone="subtle" class="card-index">{index}</Text>
        </Inline>

        <Text as="h3" type="h3" class:list={['card-title', { 'card-title--flagship': isFlagship }]}>{title}</Text>
        
        <Text as="p" type="body" tone="subtle" class="card-desc">
          {description}
        </Text>

        <Inline justify="between" align="end" class="card-footer">
          <Inline gap="xs" wrap class="card-tags">
            {tags.map(tag => (
              <Badge theme="ghost" outlined>{tag}</Badge>
            ))}
          </Inline>
          
          <div class="card-arrow">
            <Icon name="arrow-up-right" size="var(--space-5)" />
          </div>
        </Inline>
      </Stack>
    </Paper>
  </a>
</Card>

<style>

</style>
