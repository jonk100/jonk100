---
/**
 * src/components/portfolio/Hero.astro
 * Hero section component for the portfolio site.
 * - Displays the user's name, tagline, and current status.
 * - Leverages centralized global entrance animations from src/styles/variants/animations.css.
 * @props (local): None
 * @props (global): class, class:list, frame, effects
 */
import Box from '../ui/layout/Box.astro';
import Stack from '../ui/layout/Stack.astro';
import Inline from '../ui/layout/Inline.astro';
import Text from '../ui/typography/Text.astro';
import Badge from '../ui/feedback/Badge.astro';
import BadgeGroup from '../ui/feedback/BadgeGroup.astro';
---

<section class="hero" aria-labelledby="hero-heading">
  <Box class="container">
    <Stack gap="xl">
      <!-- Eyebrow -->
      <Text as="p" type="label" class="hero-eyebrow animate-slide-up delay-1">
        down to build &nbsp;·&nbsp; somewhere, earth
      </Text>

      <!-- Name -->
      <h1 class="hero-name animate-slide-up delay-2" id="hero-heading">
        jon<em>k100</em>
      </h1>
      <BadgeGroup size="md" class="animate-slide-up delay-3">
        <Badge theme="primary">WRITER</Badge>
        <Badge theme="secondary">MUSICIAN</Badge>
        <Badge theme="secondary">TEACHER</Badge>
        <Badge theme="accent">DEVELOPER</Badge>
      </BadgeGroup>   
      <!-- Tagline -->
      <Text as="p" type="body" tone="subtle" class="hero-tagline animate-slide-up delay-4">
        <strong>I like to write stuff</strong> and build things that help me write more efficiently -- usually with Astro and TypeScript. Check out what I'm working on.
      </Text>

      <!-- Status -->
      <Inline align="center" gap="sm" class="hero-status animate-slide-up delay-5" id="hero-status-container" style="transition: opacity 0.3s ease;">
        <Inline align="center" gap="xs">
          <div class="status-dot" aria-hidden="true"></div>
          <Text as="span" type="label" tone="secondary" size="base" class="status-text">Currently writing</Text>
        </Inline>
        <div class="status-divider" aria-hidden="true"></div>
        <Text as="span" type="label" tone="muted" class="status-text">open to collaboration</Text>
      </Inline>

      <!-- Featured Banner -->
      <a href="https://cssmen.jonkrausejams.workers.dev/" class="featured-banner animate-slide-up delay-6" target="_blank" rel="noopener noreferrer">
        <img src="/cssmen-hero.png" alt="CSSMen Interactive Grid Tool" class="featured-banner-image" />
        <div class="featured-banner-overlay">
          <Text as="span" type="label" class="banner-title">EXPLORE CSSMEN</Text>
          <Text as="span" type="caption" class="banner-subtitle">Interactive Grid Layout Tool</Text>
        </div>
      </a>
    </Stack>
  </Box>
</section>

<style>
  .hero {
    padding-top: calc(4rem + var(--space-24));
    padding-bottom: var(--space-20);
  }



  .hero-eyebrow {
    color: var(--accent) !important;
    font-family: var(--mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .hero-name {
    font-family: var(--display);
    font-size: clamp(3rem, 3rem + 10vw, 10rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.04em;
    color: var(--text);
  }

  .hero-name em {
    font-style: normal;
    font-weight: 500;
    color: var(--accent);
  }

  .hero-tagline {
    max-width: 500px;
    line-height: 1.8;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent);
    animation: pulse 2.8s var(--ease-in-out) infinite;
  }

  .status-text {
    font-family: var(--mono);
    letter-spacing: 0.06em;
  }

  .status-divider {
    width: 1px;
    height: 14px;
    background-color: var(--border);
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.3; transform: scale(0.75); }
  }

  .featured-banner {
    display: block;
    position: relative;
    width: 100%;
    max-width: 600px;
    height: 220px;
    border-radius: var(--rad-lg);
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
    border: 1px solid var(--border);
    margin-top: calc(var(--space-6) * -1);
  }

  .featured-banner:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -10px var(--shadow);
  }

  .featured-banner-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 10%;
    transition: object-position 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .featured-banner:hover .featured-banner-image {
    object-position: center 35%;
    transform: scale(1.03);
  }

  .featured-banner-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.1) 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--space-4);
  }

  .banner-title {
    color: white !important;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .banner-subtitle {
    color: rgba(255,255,255,0.8) !important;
  }

  @media (max-width: 600px) {

    .hero {
      padding-top: calc(4rem + var(--space-12)) !important;
      padding-bottom: var(--space-12) !important;
    }

    .hero-name {
      font-size: clamp(3rem, 12vw, 4.5rem) !important;
    }

    .hero-status {
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: var(--space-2) !important;
    }

    .status-divider {
      display: none !important;
    }
  }
</style>
