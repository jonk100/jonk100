---
/**
 * src/layouts/BlogPostLayout.astro
 * A layout component that wraps blog post pages with a standard layout and styles.
 * - Renders a full blog post page including fixed navigation with a back-to-blog button.
 * - Integrates next-post link with a rich dynamic tooltip using the Popover API.
 * - Displays a full-screen hero image overlay with support for view transitions.
 * - Establishes design system aesthetics with justified paragraph alignment for readability.
 * @props (local): post, nextPost
 * @props (global): class, class:list
 * - post: The current blog post collection entry containing content schema and metadata.
 * - nextPost: Optional subsequent blog post collection entry for pagination.
 */

import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import Box from '../components/ui/layout/Box.astro';
import Stack from '../components/ui/layout/Stack.astro';
import Inline from '../components/ui/layout/Inline.astro';
import Text from '../components/ui/typography/Text.astro';
import Tooltip from '../components/ui/overlay/Tooltip.astro';
import Image from '../components/ui/primitives/Image.astro';
import '../styles/markdown.css';

export interface Props {
  title: string;
  description: string;
  pubDate?: Date;
  tags?: string[];
  imageSrc?: string;
  post: CollectionEntry<'blog'>;
  nextPost?: CollectionEntry<'blog'>;
  class?: string;
  "class:list"?: Record<string, boolean> | any[];
}

const { post, nextPost, class: className = '', "class:list": classList = {} } = Astro.props;
const { title, description, pubDate, tags, imageSrc } = post.data;
---

<Layout title={`${title} | Jon Doe`} description={description}>
  <div class="blog-page">
    <nav class="blog-nav">
      <a href="/blog" class="nav-button back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Back to Blog
      </a>

      {nextPost && (
        <div class="next-wrapper">
          <a href={`/blog/${nextPost.id}`} id="next-btn" class="nav-button next-link" style="anchor-name: --next-btn;">
            Next Post
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </a>
          {/* <Tooltip id="next-tooltip" anchor="next-btn" placement="bottom">
            <Stack gap="xs">
              <span style="font-size: 10px; opacity: 0.7; font-family: var(--mono); text-transform: uppercase; letter-spacing: 0.1em;">Next Article</span>
              <span style="font-weight: 500; font-size: 14px; white-space: nowrap;">{nextPost.data.title}</span>
            </Stack>
          </Tooltip> */}
        </div>
      )}
    </nav>

    {imageSrc && (
      <Image 
        src={imageSrc}
        alt={title}
        fit="none"
        effects={["glass", "grayscale", "screen"]}
        height="50vh"
        effects="fade-down-hero"
        class="post-hero" 
        style="view-transition-name: post-hero;"
      />
    )}

    <Box class="content-container" style="view-transition-name: post-content;">
      <Stack gap="lg" class="content">
        <header class="post-header">
          <Text as="time" type="label" tone="subtle" class="post-date">
            {pubDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </Text>
          <Text as="h1" type="h1" class="post-title">{title}</Text>
          <Text as="p" type="lead" tone="subtle">{description}</Text>
          
          {tags.length > 0 && (
            <Inline gap="sm" class="post-tags">
              {tags.map(tag => (
                <span class="tag">#{tag}</span>
              ))}
            </Inline>
          )}
        </header>

        <div class:list={["markdown-content", className, classList]}>
          <slot />
        </div>
      </Stack>
    </Box>
  </div>
</Layout>

<style>
  .content-container {
    max-width: var(--max-width, 1280px);
    margin: 0 auto;
    padding: var(--space-8) var(--space-8);
    position: relative;
    z-index: 10;
    /* top: -100px; */
  }
  .blog-page {
    min-height: 100vh;
    top: 50px;
    position: relative;
  }

  .blog-nav {
    position: fixed;
    left: var(--space-8);
    right: var(--space-8);
    z-index: 100;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
    top: var(--space-24);
  }

  .nav-button {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text);
    background: rgba(20, 20, 20, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--rad-full);
    border: 1px solid var(--border-subtle);
    font-family: var(--mono);
    text-transform: uppercase;
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .nav-button:hover {
    background: var(--bg-surface-0);
    border-color: var(--border);
  }

  .back-link:hover {
    transform: translateX(-4px);
  }

  .next-link:hover {
    transform: translateX(4px);
  }
  
  .next-wrapper {
    position: relative;
    pointer-events: auto;
  }

  .post-hero {
    object-position: center;
    position: absolute;
    margin: -200px;
  }

  .content-container {
    max-width: var(--max-width, 1280px);
    margin: 0 auto;
    padding: var(--space-8) var(--space-8);
    position: absolute;
    top: 100px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
  }

  .content {
    max-width: 800px;
  }

  .post-header {
    margin-bottom: var(--space-8);
    background: linear-gradient(to right, rgba(2,3,7,.9) 30%, var(--background) 100%);
    padding: var(--space-4);
    border-radius: var(--rad-xs);
  }

  .post-date {
    display: block;
    margin-bottom: var(--space-4);
    font-family: var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .post-title {
    font-size: clamp(2.5rem, 4vw, 4rem);
    margin: var(--space-4) 0 var(--space-6);
    line-height: 1.1;
  }

  .post-tags {
    margin-top: var(--space-6);
  }

  .tag {
    font-family: var(--mono);
    color: var(--accent);
    font-size: var(--text-sm);
  }

  ::view-transition-group(post-content) {
    z-index: 20;
  }

  @media (max-width: 768px) {
    .blog-page {
      top: 20px;
    }

    .blog-nav {
      top: var(--space-16);
      left: var(--space-4);
      right: var(--space-4);
    }

    .post-hero {
      position: relative !important;
      margin: 0 !important;
      height: 35vh !important;
      width: 100% !important;
    }

    .content-container {
      position: relative !important;
      width: 100% !important;
      left: 0 !important;
      transform: none !important;
      top: 0 !important;
      padding: var(--space-6) var(--space-4) !important;
    }

    .post-header {
      padding: var(--space-6) var(--space-4) !important;
      margin-bottom: var(--space-4) !important;
    }

    .post-title {
      font-size: clamp(1.75rem, 8vw, 2.25rem) !important;
      margin: var(--space-2) 0 !important;
    }

    .post-header :global(.text--lead) {
      font-size: var(--text-base) !important;
    }
  }
</style>
