---
/**
 * BaseLayout.astro
 *
 * Outermost HTML shell. Used by every page in the app.
 * Imports global styles and typography, renders Header and Navigation.
 *
 * For page-level content, use IndexLayout (index pages) or
 * add a layout that extends this one for detail pages.
 *
 * @prop title       - <title> tag content. Appended with site name.
 * @prop description - Meta description for the page.
 * @prop image       - OG image URL (optional).
 */
import Head from "./Head.astro";
import Header from "../components/Header.astro";
import Navigation from "../components/Navigation.astro";
import "../styles/global.css";
import "../styles/typography.css";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image,
} = Astro.props;

const siteTitle = title === SITE_TITLE
  ? title
  : `${title} — ${SITE_TITLE}`;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={title} description={description} />
    <slot name="head" />
  </head>

  <body>
    <Header />
    <Navigation />
    <slot />
  </body>
</html>