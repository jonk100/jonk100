---
/**
 * src/layouts/ProjectLayout.astro
 * A layout component that wraps project details pages with a standard layout and styles.
 * - Renders a full project page including fixed navigation with a back-to-home button.
 * - Integrates next-project link with a rich dynamic tooltip using the Popover API.
 * - Displays a full-screen hero image overlay with support for view transitions.
 * - Establishes design system aesthetics with justified paragraph alignment for readability.
 * @props (local): project, nextProject
 * @props (global): class, class:list
 * - project: The current project collection entry containing content schema and metadata.
 * - nextProject: Optional subsequent project collection entry for pagination.
 */

import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import Box from '../components/ui/layout/Box.astro';
import Stack from '../components/ui/layout/Stack.astro';
import Inline from '../components/ui/layout/Inline.astro';
import Text from '../components/ui/typography/Text.astro';
import Tooltip from '../components/ui/overlay/Tooltip.astro';
import ProjectTransition from '../components/portfolio/ProjectTransition.astro';
import Button from '../components/ui/controls/Button.astro';
import ProjectPageHero from '../components/project/ProjectPageHero.astro';
import ButtonGroup from '../components/ui/controls/ButtonGroup.astro';
import Link from '../components/ui/primitives/Link.astro';

export interface Props {
  project: CollectionEntry<'projects'>;
  nextProject?: CollectionEntry<'projects'>;
  class?: string;
  "class:list"?: Record<string, boolean> | any[];
}

const components = {
  a: Link,  
  Button,
  ProjectPageHero,
  ButtonGroup,
}

const { project, nextProject, class: className = '', "class:list": classList = {} } = Astro.props;
const { title, category, description, imageSrc, githubUrl, liveUrl } = project.data;
---

<Layout title={`${title} | Jon Doe`}>
  <ProjectTransition />
  <div class="project-page">
    <nav class="project-nav">
      <a href="/" class="nav-button back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Back to Home
      </a>

      {nextProject && (
        <div class="next-wrapper">
          <a href={`/projects/${nextProject.id}`} id="next-btn" class="nav-button next-link" style="anchor-name: --next-btn;">
            Next Project
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </a>
          
        </div>
      )}
    </nav>

    <ProjectPageHero 
      imageSrc={imageSrc} 
      title={title} 
      project={project} 
    /> 

    <Box class="content-container" style="view-transition-name: project-content;">
      <Stack gap="lg" class="content">
        <header class="project-header">
          <Text as="span" type="label" tone="accent">{category}</Text>
          <Text as="h1" type="h1" class="project-title">{title}</Text>
          <Text as="p" type="lead" tone="subtle">{description}</Text>
          
          <Inline gap="md">
            <ButtonGroup class="project-actions">
            {liveUrl && (
              <Button href={liveUrl} target="_blank" rel="noopener noreferrer" theme="secondary" size="xl" class="external-link">
                Visit Project
              </Button>
            )}
            {githubUrl && (
              <Button href={githubUrl} target="_blank" rel="noopener noreferrer" theme="outline" size="xl" class="external-link">
                View Source
              </Button>
            )}
            </ButtonGroup>
          </Inline>
        </header>

        <div class:list={["markdown-content", className, classList]}>
          <slot />
        </div>
      </Stack>
    </Box>
  </div>
</Layout>


<style>
  .project-page {
    min-height: 100vh;
  }

  .project-nav {
    position: fixed;
    top: var(--space-8);
    left: var(--space-8);
    right: var(--space-8);
    z-index: 100;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
  }

  .nav-button {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text);
    background: rgba(20, 20, 20, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--rad-full);
    border: 1px solid var(--border-subtle);
    font-family: var(--mono);
    text-transform: uppercase;
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .nav-button:hover {
    background: var(--bg-surface-0);
    border-color: var(--border);
  }

  .back-link:hover {
    transform: translateX(-4px);
  }

  .next-link:hover {
    transform: translateX(4px);
  }
  
  .next-wrapper {
    position: relative;
    pointer-events: auto;
  }

  .content-container {
    max-width: var(--max-width, 1280px);
    margin: 0 auto;
    padding: 0 var(--space-8);
    position: relative;
    top: -300px; /* Pull content up over the gradient */
    z-index: 10;
  }

  .project-header {
    margin-bottom: var(--space-2);
    background: linear-gradient(to right, rgba(2,3,7,.7) 0%, var(--surface-0) 100%);
    padding: var(--space-16);
    border-radius: var(--rad-xs);
    
    
  }

  .project-header h1 {
    font-size: clamp(3rem, 5vw, 5rem);
    margin: var(--space-8) 0;
    line-height: 1.1;
  }


  .project-title {
    font-size: clamp(3rem, 5vw, 5rem);
    margin: var(--space-4) 0;
    line-height: 1.1;
  }

  /* .project-links {
    margin-top: var(--space-6);
  } */

  .primary-link {
    background: var(--accent);
    color: var(--bg);
    font-weight: 600;
  }

  .primary-link:hover {
    background: var(--text);
    transform: translateY(-2px);
  }

  .secondary-link {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--border);
  }

  .secondary-link:hover {
    border-color: var(--text);
    transform: translateY(-2px);
  }

  .prose a {
    color: var(--secondary);
  }
  
</style>
