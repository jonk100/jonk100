---
/**
 * src/layouts/ProjectLayout.astro
 * A layout component that wraps project details pages with a standard layout and styles.
 * - Renders a full project page including fixed navigation with a back-to-home button.
 * - Integrates next-project link with a rich dynamic tooltip using the Popover API.
 * - Displays a full-screen hero image overlay with support for view transitions.
 * - Establishes design system aesthetics with justified paragraph alignment for readability.
 * @props (local): project, nextProject
 * @props (global): class, class:list
 * - project: The current project collection entry containing content schema and metadata.
 * - nextProject: Optional subsequent project collection entry for pagination.
 */

import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import Box from '../components/ui/layout/Box.astro';
import Stack from '../components/ui/layout/Stack.astro';
import Inline from '../components/ui/layout/Inline.astro';
import Text from '../components/ui/typography/Text.astro';
import Tooltip from '../components/ui/overlay/Tooltip.astro';
import ProjectTransition from '../components/portfolio/ProjectTransition.astro';
import Button from '../components/ui/controls/Button.astro';
import ProjectPageHero from '../components/project/ProjectPageHero.astro';
import ButtonGroup from '../components/ui/controls/ButtonGroup.astro';
import Link from '../components/ui/primitives/Link.astro';
import Icon from 'dezign8/assets/components/icon/Icon.astro';

export interface Props {
  project: CollectionEntry<'projects'>;
  nextProject?: CollectionEntry<'projects'>;
  class?: string;
  "class:list"?: Record<string, boolean> | any[];
}

const components = {
  a: Link,  
  Button,
  ProjectPageHero,
  ButtonGroup,
}

const { project, nextProject, class: className = '', "class:list": classList = {} } = Astro.props;
const { title, category, description, imageSrc, githubUrl, liveUrl } = project.data;
---

<Layout title={`${title} | Jon Doe`}>
  <ProjectTransition />
  <div class="project-page">
    <nav class="project-nav">
      <a href="/" class="nav-button back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        <span class="btn-text">Back to Home</span>
      </a>

      {nextProject && (
        <div class="next-wrapper">
          <a href={`/projects/${nextProject.id}`} id="next-btn" class="nav-button next-link" style="anchor-name: --next-btn;">
            <span class="btn-text">Next Project</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </a>
        </div>
      )}
    </nav>

    <ProjectPageHero 
      imageSrc={imageSrc} 
      title={title} 
      project={project} 
    /> 

    <Box class="content-container" style="view-transition-name: project-content;">
      <Stack gap="lg" class="content">
        <header class="project-header">
          <Text as="span" type="label" tone="accent">{category}</Text>
          <Text as="h1" type="h1" class="project-title">{title}</Text>
          <Text as="p" type="lead" class="project-description" tone="subtle">{description}</Text>
          
          <Inline gap="md">
            <ButtonGroup class="project-actions">
            {liveUrl && (
              <Button href={liveUrl} target="_blank" rel="noopener noreferrer" theme="secondary" size="xl" class="external-link">
                Visit Project
              </Button>
            )}
            {githubUrl && (
              <Button href={githubUrl} target="_blank" rel="noopener noreferrer" theme="outline" size="xl" class="external-link">
                View Source
              </Button>
            )}
            </ButtonGroup>
          </Inline>
        </header>

        <div class:list={["markdown-content", className, classList]}>
          <slot />
        </div>
      </Stack>
    </Box>
  </div>
</Layout>

<script>
  function setupScrollAnimation() {
    const nav = document.querySelector('.project-nav');
    if (!nav) return;
    
    const onScroll = () => {
      // Collapse when scrolled down far enough
      if (window.scrollY > 200) {
        nav.classList.add('scrolled');
      } else {
        nav.classList.remove('scrolled');
      }
    };
    
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll(); // initial state
    
    // Cleanup if view transition happens
    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('scroll', onScroll);
    }, { once: true });
  }

  // Setup on initial load and after view transitions
  document.addEventListener('astro:page-load', setupScrollAnimation);
</script>

<style>
  .project-page {
    min-height: 100vh;
  }

  .project-nav {
    position: fixed;
    top: var(--space-24);
    left: var(--space-8);
    right: var(--space-8);
    z-index: 100;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
  }

  .nav-button {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text);
    background: rgba(20, 20, 20, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--rad-full);
    border: 1px solid var(--border-subtle);
    font-family: var(--mono);
    text-transform: uppercase;
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-decoration: none;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
  }

  .btn-text {
    display: inline-flex;
    align-items: center;
    max-width: 200px;
    white-space: nowrap;
    opacity: 1;
    transform: scale(1);
    transform-origin: center;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Scrolled state */
  .project-nav.scrolled .nav-button {
    gap: 0;
    padding: var(--space-3);
  }

  .project-nav.scrolled .btn-text {
    max-width: 0;
    opacity: 0;
    transform: scale(0.8);
    pointer-events: none;
  }

  .nav-button:hover {
    background: var(--bg-surface-0);
    border-color: var(--border);
  }

  .back-link:hover {
    transform: translateX(-4px);
  }

  .next-link:hover {
    transform: translateX(4px);
  }
  
  .next-wrapper {
    position: relative;
    pointer-events: auto;
  }

  .content-container {
    max-width: var(--max-width, 1280px);
    margin: 0 auto;
    padding: 0 var(--space-8);
    position: relative;
    top: -300px; /* Pull content up over the gradient */
    z-index: 10;
  }

  .project-header {
    margin-bottom: var(--space-2);
    background: linear-gradient(to right, rgba(2,3,7,.7) 0%, var(--surface-0) 100%);
    padding: var(--space-16);
    border-radius: var(--rad-xs);
  }

  .project-title {
    font-size: var(--text-5xl);
    margin: var(--space-8) 0;
    line-height: 1.1;
    
    @media (width <= 768px) {
      font-size: var(--text-4xl);
      margin: var(--space-6) 0;
    }
    @media (width <= 500px) {
      font-size: var(--text-3xl);
      margin: var(--space-4) 0;
    }
    @media (width <= 400px) {
      font-size: var(--text-2xl);
      margin: var(--space-2) 0;
    }
  }

  .project-description {
    line-height: var(--leading-loose);
    max-width: 750px;
    margin: 0 auto;
    margin-bottom: var(--space-12);
    font-size: var(--text-xl);
    color: var(--text-secondary);
    letter-spacing: 0.03em;
    font-style: oblique;
    
    @media (width <= 650px) {
      font-size: var(--text-lg);
      margin-bottom: var(--space-8);
    }
    @media (width <= 500px) {
      font-size: var(--text-base);
      margin-bottom: var(--space-6);
      font-weight: 400;
    }
  }

  /* .project-links {
    margin-top: var(--space-6);
  } */

  .primary-link {
    background: var(--accent);
    color: var(--bg);
    font-weight: 600;
  }

  .primary-link:hover {
    background: var(--text);
    transform: translateY(-2px);
  }

  .secondary-link {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--border);
  }

  .secondary-link:hover {
    border-color: var(--text);
    transform: translateY(-2px);
  }

  .prose a {
    color: var(--secondary);
  }


  
  @media (max-width: 768px) {
    .project-nav {
      top: var(--space-20) !important;
      left: var(--space-4) !important;
      right: var(--space-4) !important;
    }

    .content-container {
      padding: 0 var(--space-4);
      top: -100px; /* Pull content up less on mobile to prevent overlapping fixed top navigation */
    }

    .project-header {
      padding: var(--space-6) var(--space-5); /* Reduce padding on mobile */
    }

    .project-header :global(.text--lead) {
      font-size: var(--text-base) !important;
    }

    .project-header :global(.text--label) {
      font-size: var(--text-xs) !important;
    }

    .project-actions {
      display: flex !important;
      flex-direction: column !important;
      width: 100% !important;
    }

    .project-actions :global(> .control),
    .project-actions :global(> button),
    .project-actions :global(> a) {
      width: 100% !important;
      border-radius: 0 !important;
    }

    .project-actions :global(> *:first-child:not(:only-child)) {
      border-top-left-radius: var(--rad-md) !important;
      border-top-right-radius: var(--rad-md) !important;
      border-bottom-left-radius: 0 !important;
      border-bottom-right-radius: 0 !important;
    }

    .project-actions :global(> *:last-child:not(:only-child)) {
      border-bottom-left-radius: var(--rad-md) !important;
      border-bottom-right-radius: var(--rad-md) !important;
      border-top-left-radius: 0 !important;
      border-top-right-radius: 0 !important;
    }

    .project-actions :global(> *:only-child) {
      border-radius: var(--rad-md) !important;
    }
  }
</style>
