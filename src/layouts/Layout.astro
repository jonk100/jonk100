---
/**
 * src/layouts/Layout.astro
 * The base page layout component providing main structural markup, styles, and SEO headers.
 * - Manages modern OpenGraph, Twitter, and canonical metadata tags.
 * - Preloads visual typography fonts from Google Fonts asynchronously.
 * - Integrates Astro's ClientRouter for smooth page-level transitions.
 * @props (local): title, description, image, type
 * @props (global): class, class:list
 * - title: Page specific document title tag
 * - description: Page specific description meta tag
 * - image: Canonical path for OpenGraph share previews
 * - type: OpenGraph page type (e.g., 'website' or 'article')
 */

import { ClientRouter } from 'astro:transitions';
import ToastProvider from '../components/ui/feedback/ToastProvider.astro';
import '../styles/global.css';
import Navbar from '../components/portfolio/NavBar.astro';
export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  class?: string;
  "class:list"?: Record<string, boolean> | any[];
}

const { 
  title = "Jon — Portfolio & Creative Lab for Writing, Music & Code",
  description = "Writer, musician, developer, and teacher. I build to help me write and teach, usually with Astro and TypeScript.",
  image = "/og-image.jpg",
  type = "website",
  class: className = '',
  "class:list": classList = {}
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://jonk100.netlify.app');
const ogImageURL = new URL(image, canonicalURL);
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Prevent FOUC: Set theme and motion preferences before page renders -->
    <script is:inline>
      (function() {
        try {
          // Theme preference
          const storedTheme = localStorage.getItem('theme');
          if (storedTheme === 'light' || storedTheme === 'dark') {
            document.documentElement.setAttribute('data-theme', storedTheme);
          } else {
            // Default to dark if no preference stored
            document.documentElement.setAttribute('data-theme', 'dark');
          }

          // Reduced motion preference (sync with system)
          const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          document.documentElement.setAttribute('data-reduced-motion', prefersReducedMotion ? 'true' : 'false');
        } catch (e) {
          // Fail silently if localStorage is unavailable
          console.warn('Could not initialize preferences:', e);
        }
      })();
    </script>

    <meta charset="UTF-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />
    
    <!-- Google Fonts: Outfit & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Polyfills for Native Overlay APIs -->
    <script type="module">
      // Polyfill for Invoker Commands API (commandfor, command)
      if (!('commandForElement' in HTMLButtonElement.prototype)) {
        import('https://esm.run/invokers-polyfill');
      }

      // Polyfill for Popover API (popover="auto")
      if (!('popover' in HTMLElement.prototype)) {
        import('https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover-fn.js').then(({ apply }) => {
          apply();
        });
      }
    </script>
  </head>
  <body class:list={[className, classList]}>
    <Navbar />
    <slot />
    <ToastProvider />
  </body>
</html>
