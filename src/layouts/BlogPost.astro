---
import Footer from '../components/Footer.astro';
import BaseLayout from './BaseLayout.astro';

const { title, description } = Astro.props as Record<string, unknown>;
---

<BaseLayout title={title as string} description={description as string}>
	<main>
		<article>
			<slot />
		</article>
	</main>
	<Footer />
</BaseLayout>

<style>
  main {
    width: 100%;
    max-width: 100%;
    margin: 0;
  }
</style>
