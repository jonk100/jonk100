{
  "shared/skeleton": [
    {
      "name": "variant",
      "type": "\"text\" | \"heading\" | \"avatar\" | \"button\" | \"image\" | \"block\"",
      "optional": true,
      "description": "The shape preset.\n\n- `text`    — single text line (~1em tall). Use `lines` for a block.\n- `heading` — taller, narrower width. For title placeholders.\n- `avatar`  — circular. Diameter set by `height` (default 2.5rem).\n- `button`  — pill shape. For CTA placeholders.\n- `image`   — rectangle with `ratio` aspect-ratio. For media.\n- `block`   — no default size. Set `width` + `height` explicitly.",
      "from": "SkeletonProps",
      "wired": true,
      "default": "\"block\""
    },
    {
      "name": "lines",
      "type": "number",
      "optional": true,
      "description": "Number of text lines to render.\nOnly applies to `variant=\"text\"`. Renders stacked lines with the\nlast one at 65% width — a realistic paragraph placeholder.",
      "from": "SkeletonProps",
      "wired": true,
      "default": "1"
    },
    {
      "name": "width",
      "type": "string",
      "optional": true,
      "description": "Explicit CSS width. Overrides the variant's default.\nAny valid CSS length: `\"200px\"` | `\"100%\"` | `\"12rem\"`.",
      "from": "SkeletonProps",
      "wired": true
    },
    {
      "name": "height",
      "type": "string",
      "optional": true,
      "description": "Explicit CSS height. Overrides the variant's default.\nAny valid CSS length. For `avatar`, this also sets the width\n(avatar is always square before border-radius rounds it).",
      "from": "SkeletonProps",
      "wired": true
    },
    {
      "name": "ratio",
      "type": "string",
      "optional": true,
      "description": "CSS aspect-ratio for `variant=\"image\"`.",
      "from": "SkeletonProps",
      "wired": true,
      "default": "\"16/9\""
    },
    {
      "name": "radius",
      "type": "\"none\" | \"3xs\" | \"2xs\" | \"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\" | \"2xl\" | \"3xl\" | \"4xl\" | \"5xl\" | \"6xl\" | \"full\"",
      "optional": true,
      "description": "Border radius. Overrides the per-variant default.\nUseful when the skeleton must match the shape it replaces.\n`avatar` ignores this — it is always a circle.",
      "from": "SkeletonProps",
      "wired": true
    },
    {
      "name": "animated",
      "type": "boolean",
      "optional": true,
      "description": "Whether the shimmer animation runs.\nSet to `false` to show a static placeholder (e.g. in tests,\nor when reduced-motion is handled at a higher level).",
      "from": "SkeletonProps",
      "wired": true,
      "default": "true"
    },
    {
      "name": "class",
      "type": "string",
      "optional": true,
      "description": "",
      "from": "SkeletonProps",
      "wired": true
    },
    {
      "name": "style",
      "type": "string",
      "optional": true,
      "description": "",
      "from": "BaseComponentProps",
      "wired": true
    },
    {
      "name": "id",
      "type": "string",
      "optional": true,
      "description": "",
      "from": "BaseComponentProps",
      "wired": true
    },
    {
      "name": "bg",
      "type": "\"primary\" | \"secondary\" | \"tertiary\" | \"accent\" | \"danger\" | \"warning\" | \"success\" | \"info\" | \"neutral\"",
      "optional": true,
      "description": "",
      "from": "BaseComponentProps",
      "wired": true
    },
    {
      "name": "disabled",
      "type": "boolean",
      "optional": true,
      "description": "",
      "from": "BaseComponentProps",
      "wired": true
    },
    {
      "name": "motion",
      "type": "string",
      "optional": true,
      "description": "`motion` drives enter, exit, and idle animations on any component.\n\nSyntax: `{phase}:{name}[/{duration}[/{delay}]][,…][ …]`",
      "from": "BaseComponentProps",
      "wired": true
    },
    {
      "name": "mDistance",
      "type": "string",
      "optional": true,
      "description": "`mDistance` sets the travel distance for motion animations like slide, bounce.\n\n- accepts a value (e.g. `100px`, `50vw`) or a multiplier (`x2`, `x3`)\nof the default prop.",
      "from": "BaseComponentProps",
      "wired": true
    },
    {
      "name": "action",
      "type": "string",
      "optional": true,
      "description": "`action` triggers a declarative action (defined in ./actions)\n   based on something like a click (e.g., 'replay-motion', 'toggle-theme').",
      "from": "BaseComponentProps",
      "wired": true
    },
    {
      "name": "target",
      "type": "string",
      "optional": true,
      "description": "`target` targets the action to a specific element \n   (e.g., '#my-id', 'closest .container').",
      "from": "BaseComponentProps",
      "wired": true
    },
    {
      "name": "loading",
      "type": "boolean",
      "optional": true,
      "description": "`loading` if the component is in a loading state.\n- emits `data-loading=\"true\"` on the root element via useBaseCompose.\n- each component implements its own loading UI — typically <Skeleton />.\n- Badge, Button, Avatar etc. can render a skeleton shape of themselves.",
      "from": "BaseComponentProps",
      "wired": true
    },
    {
      "name": "testId",
      "type": "string",
      "optional": true,
      "description": "",
      "from": "BaseComponentProps",
