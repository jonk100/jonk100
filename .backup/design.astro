---
/**
 * src/pages/design.astro
 * The definitive showcase and architectural sandbox for our custom design system.
 * - Composes the 7 modular design sub-components under src/components/design/
 * - Features sticky navigation sidebar back-routing to home and active state tracking.
 * - Features an interactive range slider adjusting accent color hues and border radii at runtime.
 * @props (local): None
 * @props (global): class, class:list
 */

import Layout from '../layouts/Layout.astro';

// Typography Primitives
import Text from '../components/ui/typography/Text.astro';

// Layout Primitives
import Stack from '../components/ui/layout/Stack.astro';
import Inline from '../components/ui/layout/Inline.astro';
import Grid from '../components/ui/layout/Grid.astro';

// Primitives
import Paper from '../components/ui/primitives/Paper.astro';

// Feedback & Icons
import Badge from '../components/ui/feedback/Badge.astro';
import Icon from '../components/ui/primitives/Icon.astro';

// Overlay & Modals
import Tooltip from '../components/ui/overlay/Tooltip.astro';

// Modular Design Sections
import Foundations from '../components/design/Foundations.astro';
import LayoutPrimitives from '../components/design/LayoutPrimitives.astro';
import ControlsActions from '../components/design/ControlsActions.astro';
import FormControls from '../components/design/FormControls.astro';
import OverlaysDialogs from '../components/design/OverlaysDialogs.astro';
import FeedbackFeeds from '../components/design/FeedbackFeeds.astro';
import DataLedgers from '../components/design/DataLedgers.astro';

import '../styles/global.css';
---

<Layout title="Jon.Design | Architectural Design System Showcase">
  <div class="glow glow-sidebar"></div>
  <div class="glow glow-content"></div>

  <div class="design-workspace">
    <!-- Sticky Navigation Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-brand">
        <a href="/" class="home-link">
          <div class="brand-arrow">
            <Icon name="arrow-left" size="var(--space-4)" />
          </div>
          <span class="brand-text">Jon.Design</span>
        </a>
      </div>

      <nav class="sidebar-nav">
        <a href="#foundations" class="nav-item">
          <Icon name="zap" size="var(--space-4)" />
          <span>Foundations</span>
        </a>
        <a href="#layouts" class="nav-item">
          <Icon name="info" size="var(--space-4)" />
          <span>Layout Primitives</span>
        </a>
        <a href="#buttons" class="nav-item">
          <Icon name="check-circle" size="var(--space-4)" />
          <span>Buttons & Actions</span>
        </a>
        <a href="#forms" class="nav-item">
          <Icon name="search" size="var(--space-4)" />
          <span>Form Controls</span>
        </a>
        <a href="#overlays" class="nav-item">
          <Icon name="alert-circle" size="var(--space-4)" />
          <span>Overlays & Dialogs</span>
        </a>
        <a href="#feedback" class="nav-item">
          <Icon name="alert-triangle" size="var(--space-4)" />
          <span>Feedback Feeds</span>
        </a>
        <a href="#tables" class="nav-item">
          <Icon name="check" size="var(--space-4)" />
          <span>Data Ledgers</span>
        </a>
      </nav>
      
      <div class="sidebar-footer">
        <Text type="caption" tone="muted">v1.4.0 • Built with Astro</Text>
      </div>
    </aside>

    <!-- Main Content Sandbox Area -->
    <main class="main-content">
      
      <!-- Premium Glass Header / Architecture Sandbox Controls -->
      <header class="sandbox-header">
        <div class="header-intro">
          <Text as="h1" type="h1" tone="accent" class="main-title">System Blueprints</Text>
          <Text as="p" type="lead" tone="subtle">A highly performant, accessible, and compositionally dry design system engineered via native web specs.</Text>
        </div>
        
        <!-- Interactive Client-side Sandbox Controller -->
        <Paper layer="2" bordered class="sandbox-panel" id="sandbox-card" style="anchor-name: --sandbox-card;">
          <Stack gap="xs">
            <Inline justify="between" align="center">
              <Text as="strong" type="label" tone="accent">CSS Design Token Sandbox</Text>
              <Badge theme="ghost" outlined>Client Runtime</Badge>
            </Inline>
            
            <Grid cols={2} gap="md" class="sandbox-sliders">
              <Stack gap="2xs">
                <label for="accent-hue" class="slider-label">
                  <Text type="caption" tone="subtle">Theme Accent Hue: <span id="hue-val">200</span>°</Text>
                </label>
                <input type="range" id="accent-hue" min="0" max="360" value="200" class="slider-range" />
              </Stack>
              <Stack gap="2xs">
                <label for="border-radius" class="slider-label">
                  <Text type="caption" tone="subtle">Global Border Radius: <span id="radius-val">8</span>px</Text>
                </label>
                <input type="range" id="border-radius" min="0" max="24" value="8" class="slider-range" />
              </Stack>
            </Grid>
          </Stack>
        </Paper>
        <Tooltip id="sandbox-tooltip" anchor="sandbox-card" placement="bottom">
          Adjust range sliders to re-mix CSS Custom Property tokens dynamically!
        </Tooltip>
      </header>

      <!-- Render the 7 modular extracted showcase components -->
      <Stack gap="2xl" class="sections-stack">
        <Foundations />
        <LayoutPrimitives />
        <ControlsActions />
        <FormControls />
        <OverlaysDialogs />
        <FeedbackFeeds />
        <DataLedgers />
      </Stack>
    </main>
  </div>
</Layout>

<!-- Client Runtime Sandbox Script -->
<script is:inline>
  const runSandbox = () => {
    const hueSlider = document.getElementById('accent-hue');
    const radiusSlider = document.getElementById('border-radius');
    const hueVal = document.getElementById('hue-val');
    const radiusVal = document.getElementById('radius-val');
    
    if (!hueSlider || !radiusSlider) return;
    
    const updateAccent = () => {
      const hue = hueSlider.value;
      if (hueVal) hueVal.textContent = hue;
      
      // Dynamically calculate theme variables in HSL
      document.documentElement.style.setProperty('--accent', `hsl(${hue}, 53%, 66%)`);
      document.documentElement.style.setProperty('--accent-dim', `hsl(${hue}, 53%, 23%)`);
      document.documentElement.style.setProperty('--accent-border', `hsl(${hue}, 53%, 35%)`);
      document.documentElement.style.setProperty('--accent-border-strong', `hsl(${hue}, 53%, 68%)`);
      document.documentElement.style.setProperty('--accent-hover', `hsl(${hue}, 53%, 50%)`);
    };
    
    const updateRadius = () => {
      const rad = radiusSlider.value;
      if (radiusVal) radiusVal.textContent = rad;
      
      // Calculate related radii
      document.documentElement.style.setProperty('--rad-sm', `${Math.max(0, rad - 4)}px`);
      document.documentElement.style.setProperty('--rad-md', `${rad}px`);
      document.documentElement.style.setProperty('--rad-lg', `${Number(rad) + 4}px`);
      document.documentElement.style.setProperty('--rad-xl', `${Number(rad) + 8}px`);
    };
    
    hueSlider.addEventListener('input', updateAccent);
    radiusSlider.addEventListener('input', updateRadius);
    
    // Initial triggers
    updateAccent();
    updateRadius();
  };
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', runSandbox);
  } else {
    runSandbox();
  }
  document.addEventListener('astro:page-load', runSandbox);
</script>

<style>
  /* Base Layout Sandbox Styles */
  .design-workspace {
    display: flex;
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
    position: relative;
  }

  /* Ambient Glows */
  .glow {
    position: fixed;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    filter: blur(140px);
    z-index: 0;
    pointer-events: none;
    opacity: 0.1;
  }
  .glow-sidebar {
    top: -200px;
    left: -200px;
    background: var(--primary);
  }
  .glow-content {
    bottom: -200px;
    right: -200px;
    background: var(--accent);
  }

  /* Sidebar styling */
  .sidebar {
    width: 280px;
    background: var(--bg-surface);
    border-right: 1px solid var(--border-subtle);
    position: sticky;
    top: 0;
    height: 100vh;
    padding: var(--space-8) var(--space-6);
    display: flex;
    flex-direction: column;
    z-index: 100;
  }

  .sidebar-brand {
    margin-bottom: var(--space-10);
  }

  .home-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text);
    font-family: var(--display);
    font-weight: 500;
    font-size: var(--text-lg);
  }

  .brand-arrow {
    color: var(--text-subtle);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                color 0.3s ease;
  }
  .home-link:hover .brand-arrow {
    transform: translateX(-4px);
    color: var(--accent);
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex-grow: 1;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--rad-md);
    color: var(--text-subtle);
    font-size: var(--text-sm);
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .nav-item:hover {
    color: var(--text);
    background: var(--bg-elevated);
  }

  .sidebar-footer {
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }

  /* Main content layout */
  .main-content {
    flex-grow: 1;
    max-width: calc(100% - 280px);
    padding: var(--space-12) var(--space-16);
    position: relative;
    z-index: 10;
  }

  .sandbox-header {
    margin-bottom: var(--space-16);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .main-title {
    font-size: var(--text-4xl);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-2);
  }

  .sandbox-panel {
    padding: var(--space-6);
  }

  .sandbox-sliders {
    margin-top: var(--space-2);
  }

  .slider-label {
    display: block;
    margin-bottom: var(--space-1);
  }

  .slider-range {
    width: 100%;
    accent-color: var(--accent);
    cursor: pointer;
    background: var(--bg-elevated);
    height: 6px;
    border-radius: var(--rad-full);
    border: none;
  }

  .sections-stack {
    max-width: 900px;
  }

  @media (max-width: 1024px) {
    .sidebar {
      display: none;
    }
    .main-content {
      max-width: 100%;
      padding: var(--space-6) var(--space-8);
    }
  }
</style>
